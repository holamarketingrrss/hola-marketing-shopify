    "custom_liquid_4JkkpA": {
      "type": "custom-liquid",
      "name": "mentoria",
      "settings": {
        "custom_liquid": "<section class=\"hm-mentoria\">\n  <style>\n    .hm-mentoria{\n      background:#fdf6ec;\n      padding:clamp(40px,6vw,90px) clamp(20px,5vw,70px);\n      overflow:hidden;\n    }\n\n    .hm-mentoria *{\n      box-sizing:border-box;\n    }\n\n    .hm-mentoria-wrap{\n      max-width:1500px;\n      margin:auto;\n      position:relative;\n    }\n\n    .hm-mentoria-picture,\n    .hm-mentoria-picture img{\n      display:block;\n      width:100%;\n    }\n\n    .hm-mentoria-picture img{\n      height:auto;\n    }\n\n    .hm-mentoria-btn{\n      position:absolute;\n      left:58.5%;\n      bottom:16.5%;\n      transform:translateX(-50%);\n      min-height:58px;\n      padding:0 clamp(24px,3vw,40px);\n\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      gap:20px;\n\n      border:2px solid #000;\n      border-radius:16px;\n\n      background:#ff5000;\n      color:#fff;\n      text-decoration:none;\n\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(14px,1vw,20px);\n      font-weight:900;\n      text-transform:uppercase;\n      letter-spacing:-.04em;\n\n      box-shadow:0 4px 0 #000;\n      transition:.18s ease;\n\n      z-index:3;\n      white-space:nowrap;\n    }\n\n    .hm-mentoria-btn:hover{\n      background:#2462c7;\n      color:#fff;\n      transform:translateX(-50%) translateY(-3px);\n      box-shadow:0 7px 0 #000;\n    }\n\n    .hm-mentoria-btn span{\n      font-size:1.4em;\n      line-height:1;\n    }\n\n    @media(max-width:749px){\n\n      .hm-mentoria{\n        padding:40px 0;\n      }\n\n      .hm-mentoria-btn{\n        width:75%;\n        min-height:50px;\n\n        bottom:10%;\n\n        font-size:14px;\n        gap:12px;\n      }\n\n    }\n\n  </style>\n\n  <div class=\"hm-mentoria-wrap\">\n\n    <picture class=\"hm-mentoria-picture\">\n\n      <source\n        media=\"(max-width: 749px)\"\n        srcset=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/690de878c52a8d376f7801d8_TEL2-min.avif?v=1778181103\"\n      >\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/mentoria.avif?v=1778181102\"\n        alt=\"Mentoría Hola Marketing\"\n        loading=\"lazy\"\n      >\n\n    </picture>\n\n\n    <a\n      class=\"hm-mentoria-btn\"\n      href=\"https://wa.me/17866897873\"\n      target=\"_blank\"\n    >\n      Aplicar a mentoría <span>→</span>\n    </a>\n\n  </div>\n\n</section>",
