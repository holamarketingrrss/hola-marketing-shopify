    "custom_liquid_HC3gEx": {
      "type": "custom-liquid",
      "name": "packs",
      "settings": {
        "custom_liquid": "<section class=\"hm-quiz hm-section\" id=\"packs\" style=\"scroll-margin-top:90px;\">\n  <style>\n    .hm-quiz{\n      background:var(--hm-cream);\n      overflow:hidden;\n    }\n\n    .hm-quiz *{ box-sizing:border-box; }\n\n    .hm-quiz-wrap{\n      width:100%;\n      margin:auto;\n    }\n\n    .hm-quiz-body{\n      width:100%;\n    }\n\n    .hm-quiz-title{\n      margin:0;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:var(--hm-heading-size);\n      line-height:var(--hm-heading-line-height);\n      text-transform:uppercase;\n      letter-spacing:-.07em;\n      color:var(--hm-black);\n      text-align:center;\n    }\n\n    .hm-quiz-sub{\n      margin:22px auto 0;\n      max-width:640px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:var(--hm-body-size);\n      line-height:var(--hm-body-line-height);\n      color:var(--hm-black);\n      text-align:center;\n    }\n\n    .hm-quiz-card{\n      margin-top:1.3rem;\n      background:var(--hm-white);\n      border:2px solid var(--hm-black);\n      border-radius:28px;\n      padding:clamp(28px,4vw,48px);\n      min-height:420px;\n      display:flex;\n      flex-direction:column;\n    }\n\n    .hm-quiz-screen.is-hidden{ display:none; }\n\n    /* Step 0 — lead form */\n    .hm-quiz-step-label{\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:13px;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:.04em;\n      color:var(--hm-orange);\n      margin-bottom:10px;\n    }\n\n    .hm-quiz-lead-title{\n      margin:0 0 12px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(21px,2.2vw,30px);\n      line-height:1.2;\n      letter-spacing:-.03em;\n      color:var(--hm-black);\n    }\n\n    .hm-quiz-lead-text{\n      margin:0 0 26px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(15px,1.1vw,17px);\n      line-height:1.5;\n      color:var(--hm-black);\n    }\n\n    .hm-quiz-fields{\n      display:grid;\n      grid-template-columns:1fr 1fr;\n      gap:14px;\n    }\n\n    .hm-quiz-field{ display:flex; flex-direction:column; gap:6px; }\n    .hm-quiz-field.is-full{ grid-column:1 / -1; }\n\n    .hm-quiz-field label{\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:12px;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:.04em;\n      color:var(--hm-black);\n    }\n\n    .hm-quiz-field input,\n    .hm-quiz-field select{\n      width:100%;\n      padding:14px 16px;\n      border:2px solid var(--hm-black);\n      border-radius:14px;\n      background:var(--hm-white);\n      color:var(--hm-black);\n      font-family:\"DM Sans\", sans-serif;\n      font-size:16px;\n    }\n\n    .hm-quiz-field input:focus,\n    .hm-quiz-field select:focus{\n      outline:none;\n      border-color:var(--hm-orange);\n    }\n\n    /* WhatsApp: country selector + local number */\n    .hm-quiz-phone-row{\n      display:grid;\n      grid-template-columns:minmax(0,.9fr) minmax(0,1.4fr);\n      gap:10px;\n    }\n\n    .hm-quiz-field select{\n      appearance:none;\n      -webkit-appearance:none;\n      padding-right:38px;\n      text-overflow:ellipsis;\n      cursor:pointer;\n      background-image:url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='9' viewBox='0 0 14 9' fill='none'><path d='M1 1.5l6 6 6-6' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg>\");\n      background-repeat:no-repeat;\n      background-position:right 14px center;\n    }\n\n    .hm-quiz-error{\n      margin:14px 0 0;\n      min-height:20px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:14px;\n      font-weight:700;\n      color:#c0392b;\n    }\n\n    .hm-quiz-start{\n      margin-top:10px;\n      min-height:58px;\n      width:100%;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      gap:18px;\n      font-size:18px;\n      cursor:pointer;\n    }\n\n    /* Questions */\n    .hm-quiz-progress-track{\n      width:100%;\n      height:8px;\n      border-radius:999px;\n      background:rgba(0,0,0,.08);\n      overflow:hidden;\n      margin-bottom:10px;\n    }\n\n    .hm-quiz-progress-fill{\n      height:100%;\n      background:var(--hm-orange);\n      border-radius:999px;\n      width:0%;\n      transition:width .3s ease;\n    }\n\n    .hm-quiz-progress-label{\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:13px;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:.04em;\n      color:var(--hm-black);\n      opacity:.6;\n      margin-bottom:28px;\n    }\n\n    .hm-quiz-question{\n      margin:0 0 8px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(21px,2.2vw,30px);\n      line-height:1.2;\n      letter-spacing:-.03em;\n      color:var(--hm-black);\n    }\n\n    .hm-quiz-hint{\n      margin:0 0 22px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:15px;\n      color:var(--hm-black);\n      opacity:.65;\n      min-height:22px;\n    }\n\n    .hm-quiz-options{\n      display:flex;\n      flex-direction:column;\n      gap:12px;\n    }\n\n    .hm-quiz-option{\n      text-align:left;\n      width:100%;\n      padding:16px 20px;\n      border:2px solid var(--hm-black);\n      border-radius:16px;\n      background:var(--hm-white);\n      color:var(--hm-black);\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(15px,1.1vw,17px);\n      font-weight:600;\n      cursor:pointer;\n      transition:background .15s ease, color .15s ease, transform .15s ease;\n    }\n\n    .hm-quiz-option:hover,\n    .hm-quiz-option.is-selected{\n      background:var(--hm-orange);\n      color:var(--hm-white);\n      transform:translateX(4px);\n    }\n\n    .hm-quiz-continue{\n      margin-top:18px;\n      min-height:56px;\n      width:100%;\n      display:none;\n      align-items:center;\n      justify-content:center;\n      gap:16px;\n      font-size:17px;\n      cursor:pointer;\n    }\n\n    .hm-quiz-continue.is-visible{ display:flex; }\n\n    .hm-quiz-nav{\n      margin-top:auto;\n      padding-top:24px;\n      display:flex;\n      justify-content:space-between;\n      align-items:center;\n    }\n\n    .hm-quiz-back{\n      background:none;\n      border:none;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:14px;\n      font-weight:700;\n      text-transform:uppercase;\n      color:var(--hm-black);\n      opacity:.6;\n      cursor:pointer;\n      visibility:hidden;\n    }\n\n    .hm-quiz-back.is-visible{ visibility:visible; }\n    .hm-quiz-back:hover{ opacity:1; }\n\n    /* Result screen */\n    .hm-quiz-result-eyebrow{\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:13px;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:.04em;\n      color:var(--hm-orange);\n    }\n\n    .hm-quiz-result-name{\n      margin:8px 0 4px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(26px,3vw,40px);\n      text-transform:uppercase;\n      letter-spacing:-.05em;\n      color:var(--hm-black);\n    }\n\n    .hm-quiz-result-price{\n      margin:0 0 6px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(20px,2vw,26px);\n      font-weight:900;\n      color:var(--hm-orange);\n    }\n\n    .hm-quiz-result-price:empty{ display:none; }\n\n    .hm-quiz-result-note{\n      margin:0 0 18px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:14px;\n      color:var(--hm-black);\n      opacity:.65;\n    }\n\n    .hm-quiz-result-note:empty{ display:none; }\n\n    .hm-quiz-result-desc{\n      margin:0 0 28px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(16px,1.15vw,19px);\n      line-height:1.5;\n      color:var(--hm-black);\n    }\n\n    .hm-quiz-result-cta{\n      width:100%;\n      min-height:60px;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      gap:18px;\n      font-size:18px;\n    }\n\n    .hm-quiz-pdf{\n      display:block;\n      margin:16px 0 0;\n      text-align:center;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:15px;\n      font-weight:700;\n      color:var(--hm-black);\n    }\n\n    .hm-quiz-pdf[hidden]{ display:none; }\n\n    .hm-quiz-fallback{\n      margin-top:30px;\n      padding-top:26px;\n      border-top:2px dashed var(--hm-black);\n      text-align:center;\n    }\n\n    .hm-quiz-fallback[hidden]{ display:none; }\n\n    .hm-quiz-fallback-title{\n      margin:0 0 18px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:15px;\n      font-weight:700;\n      color:var(--hm-black);\n      opacity:.75;\n    }\n\n    .hm-quiz-fallback-actions{\n      display:flex;\n      gap:14px;\n      flex-wrap:wrap;\n      justify-content:center;\n    }\n\n    .hm-quiz-fallback-btn{\n      min-height:52px;\n      padding:0 22px;\n      font-size:15px;\n      background:transparent;\n      color:var(--hm-black);\n      border-color:var(--hm-black);\n    }\n\n    .hm-quiz-fallback-btn:hover{\n      background:var(--hm-black);\n      color:var(--hm-white);\n    }\n\n    @media(max-width:600px){\n      .hm-quiz-card{ padding:24px; min-height:auto; }\n      .hm-quiz-fields{ grid-template-columns:1fr; }\n      .hm-quiz-phone-row{ grid-template-columns:1fr; }\n      .hm-quiz-fallback-actions{ flex-direction:column; }\n      .hm-quiz-fallback-btn{ width:100%; }\n    }\n  </style>\n\n  <div class=\"hm-quiz-wrap\">\n    <h2 class=\"hm-quiz-title\">Elegí tu forma de hacernos parte</h2>\n    <p class=\"hm-quiz-sub\">\n      Respondé 5 preguntas rápidas y te decimos qué pack te conviene — o si lo tuyo es armar algo 100% a tu medida.\n    </p>\n\n    <div class=\"hm-quiz-body\">\n      <div class=\"hm-quiz-card\">\n\n        <!-- PASO 0: datos de contacto -->\n        <div class=\"hm-quiz-screen\" id=\"hm-quiz-lead\">\n          <div class=\"hm-quiz-step-label\">Paso 0 — Antes de comenzar</div>\n          <h3 class=\"hm-quiz-lead-title\">Te cotizamos en vivo qué estructura de marketing necesita tu marca.</h3>\n          <p class=\"hm-quiz-lead-text\">Completá tus datos para comenzar:</p>\n\n          <form id=\"hm-quiz-lead-form\" novalidate>\n            <div class=\"hm-quiz-fields\">\n              <div class=\"hm-quiz-field\">\n                <label for=\"hm-quiz-name\">Nombre y apellido</label>\n                <input type=\"text\" id=\"hm-quiz-name\" autocomplete=\"name\" required>\n              </div>\n              <div class=\"hm-quiz-field\">\n                <label for=\"hm-quiz-brand\">Marca</label>\n                <input type=\"text\" id=\"hm-quiz-brand\" autocomplete=\"organization\" required>\n              </div>\n              <div class=\"hm-quiz-field is-full\">\n                <label for=\"hm-quiz-email\">Email</label>\n                <input type=\"email\" id=\"hm-quiz-email\" autocomplete=\"email\" required>\n              </div>\n              <div class=\"hm-quiz-field is-full\">\n                <label for=\"hm-quiz-phone\">WhatsApp</label>\n                <div class=\"hm-quiz-phone-row\">\n                  <select id=\"hm-quiz-cc\" autocomplete=\"tel-country-code\" aria-label=\"País del número de WhatsApp\"></select>\n                  <input type=\"tel\" id=\"hm-quiz-phone\" autocomplete=\"tel-national\" inputmode=\"tel\" placeholder=\"Tu número de WhatsApp\" required>\n                </div>\n              </div>\n            </div>\n            <p class=\"hm-quiz-error\" id=\"hm-quiz-lead-error\" role=\"alert\"></p>\n            <button type=\"submit\" class=\"hm-btn hm-quiz-start\">Comenzar <span>→</span></button>\n          </form>\n        </div>\n\n        <!-- Preguntas -->\n        <div class=\"hm-quiz-screen is-hidden\" id=\"hm-quiz-question-screen\">\n          <div class=\"hm-quiz-progress-track\">\n            <div class=\"hm-quiz-progress-fill\" id=\"hm-quiz-progress-fill\"></div>\n          </div>\n          <div class=\"hm-quiz-progress-label\" id=\"hm-quiz-progress-label\">Pregunta 1 de 5</div>\n\n          <h3 class=\"hm-quiz-question\" id=\"hm-quiz-question-text\"></h3>\n          <p class=\"hm-quiz-hint\" id=\"hm-quiz-hint\"></p>\n          <div class=\"hm-quiz-options\" id=\"hm-quiz-options\"></div>\n          <button type=\"button\" class=\"hm-btn hm-quiz-continue\" id=\"hm-quiz-continue\">Continuar <span>→</span></button>\n\n          <div class=\"hm-quiz-nav\">\n            <button type=\"button\" class=\"hm-quiz-back\" id=\"hm-quiz-back\">← Anterior</button>\n          </div>\n        </div>\n\n        <!-- Resultado -->\n        <div class=\"hm-quiz-screen is-hidden\" id=\"hm-quiz-result\">\n          <span class=\"hm-quiz-result-eyebrow\" id=\"hm-quiz-result-eyebrow\">Te recomendamos</span>\n          <h3 class=\"hm-quiz-result-name\" id=\"hm-quiz-result-name\"></h3>\n          <div class=\"hm-quiz-result-price\" id=\"hm-quiz-result-price\"></div>\n          <p class=\"hm-quiz-result-note\" id=\"hm-quiz-result-note\"></p>\n          <p class=\"hm-quiz-result-desc\" id=\"hm-quiz-result-desc\"></p>\n\n          <a href=\"#\" target=\"_blank\" rel=\"noopener\" class=\"hm-btn hm-quiz-result-cta\" id=\"hm-quiz-result-cta\"></a>\n          <a href=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/Hola_Marketing_-_RES2026.pdf?v=1791208423\" target=\"_blank\" rel=\"noopener\" class=\"hm-quiz-pdf\" id=\"hm-quiz-pdf\">Ver la guía de servicios completa (PDF) →</a>\n\n          <div class=\"hm-quiz-fallback\" id=\"hm-quiz-fallback\">\n            <p class=\"hm-quiz-fallback-title\">¿Este pack no te termina de cerrar del todo?</p>\n            <div class=\"hm-quiz-fallback-actions\">\n              <a href=\"https://calendar.app.google/GaRqhS7U38U57FoL6\" target=\"_blank\" rel=\"noopener\" class=\"hm-btn hm-quiz-fallback-btn\">\n                Agendar una call con Yvette\n              </a>\n              <a href=\"/pages/cotiza-tu-pack\" class=\"hm-btn hm-quiz-fallback-btn\">\n                Armar mi cotización personalizada\n              </a>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </div>\n</section>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    var CRM_URL = 'https://crm.holamarketing.com.ar/api/public/form-intake/aecac2de-0659-4c86-85ea-f4aea5449b10';\n    var WHATSAPP_URL = 'https://wa.link/lh1gwp';\n    var CALENDAR_URL = 'https://calendar.app.google/GaRqhS7U38U57FoL6';\n    var EMAIL_ACCESS_KEY = ''; // Web3Forms access key (sends every quiz result to the agency inbox with a custom subject)\n\n    var ALL_MARKETING = 'Todo nuestro marketing';\n    var INCLUDED_IN_BASE = ['Estrategia', 'Redes sociales y contenido', 'Meta Ads'];\n\n    var QUESTIONS = [\n      {\n        key: 'objetivo',\n        q: '¿Cuál es el principal objetivo de tu marca hoy?',\n        type: 'single',\n        options: [\n          'Fortalecer nuestra presencia digital',\n          'Generar más oportunidades de venta',\n          'Posicionar y expandir la marca',\n          'Delegar completamente nuestro marketing',\n          'Necesitamos definirlo con un especialista',\n        ],\n      },\n      {\n        key: 'areas',\n        q: '¿Qué áreas necesitás delegar?',\n        hint: 'Puedes seleccionar varias.',\n        type: 'multi',\n        options: [\n          'Estrategia',\n          'Redes sociales y contenido',\n          'Meta Ads',\n          'Google Ads',\n          'Website + SEO',\n          'TikTok',\n          'Automatizaciones e IA',\n          ALL_MARKETING,\n        ],\n      },\n      {\n        key: 'presencia',\n        q: '¿Qué nivel de presencia necesita tu marca?',\n        type: 'single',\n        options: [\n          'Una presencia sólida y estratégica',\n          'Contenido frecuente en diferentes plataformas',\n          'Una estrategia integral de adquisición y posicionamiento',\n          'Necesitamos que ustedes lo definan',\n        ],\n      },\n      {\n        key: 'gestion',\n        q: '¿Cómo gestionás actualmente tu marketing?',\n        type: 'single',\n        options: [\n          'Lo gestionamos internamente',\n          'Trabajamos con diferentes proveedores',\n          'Tenemos una agencia, pero buscamos una nueva estructura',\n          'Queremos delegarlo completamente',\n          'Estamos comenzando',\n        ],\n      },\n      {\n        key: 'inversion',\n        q: '¿Qué inversión mensual contemplás para marketing?',\n        type: 'single',\n        options: [\n          'Hasta USD 1.000',\n          'USD 1.000 – 1.500',\n          'USD 1.500 – 2.500',\n          'USD 2.500+',\n          'Prefiero recibir una propuesta personalizada',\n        ],\n      },\n    ];\n\n    var RESULTS = {\n      essential: {\n        label: 'ESSENTIAL',\n        eyebrow: 'Te recomendamos',\n        name: 'Essential',\n        price: 'USD 1.000 / mes',\n        note: 'O su equivalente en pesos argentinos. El valor puede ser congelado por 6 meses.',\n        desc: 'Estrategia de marketing completa (documento + reunión mensual), 8 posts al mes, 20 historias diseñadas, textos creativos, diseño gráfico durante todo el mes, mejoras en tu sitio web, 2 horas de contenido presencial al mes, pauta en Meta con campañas ilimitadas y análisis de datos.',\n        ctaLabel: 'Quiero el plan Essential',\n        ctaHref: WHATSAPP_URL,\n        showPdf: true,\n        showFallback: true,\n      },\n      pro: {\n        label: 'PRO',\n        eyebrow: 'Te recomendamos',\n        name: 'Pro',\n        price: 'USD 2.500 / mes',\n        note: 'O su equivalente en pesos argentinos. El valor puede ser congelado por 6 meses.',\n        desc: 'Un equipo de marketing completo trabajando para tu marca: estrategia, 16 posts al mes, historias ilimitadas, diseño, sitio web con SEO, 4 horas de contenido presencial al mes, pauta en Meta y Google, manejo de TikTok y Fan Page, sistemas de venta con IA, análisis de datos y reuniones semanales de publicidad.',\n        ctaLabel: 'Quiero el plan Pro',\n        ctaHref: WHATSAPP_URL,\n        showPdf: true,\n        showFallback: true,\n      },\n      personalizado: {\n        label: 'COTIZACIÓN PERSONALIZADA',\n        eyebrow: 'Tu resultado',\n        name: 'Tu marca necesita una propuesta personalizada',\n        price: '',\n        note: '',\n        desc: 'Por las necesidades que seleccionaste, preferimos diseñar una estructura específica para tu marca en lugar de recomendarte un plan estándar. Nos pondremos en contacto contigo inmediatamente para preparar tu propuesta.',\n        ctaLabel: 'Agendá tu asesoría 1:1',\n        ctaHref: CALENDAR_URL,\n        showPdf: false,\n        showFallback: false,\n      },\n    };\n\n    // ---------- Elements ----------\n    var leadScreen = document.getElementById('hm-quiz-lead');\n    var leadForm = document.getElementById('hm-quiz-lead-form');\n    var leadError = document.getElementById('hm-quiz-lead-error');\n    var questionScreen = document.getElementById('hm-quiz-question-screen');\n    var resultScreen = document.getElementById('hm-quiz-result');\n    var progressFill = document.getElementById('hm-quiz-progress-fill');\n    var progressLabel = document.getElementById('hm-quiz-progress-label');\n    var questionText = document.getElementById('hm-quiz-question-text');\n    var hintText = document.getElementById('hm-quiz-hint');\n    var optionsWrap = document.getElementById('hm-quiz-options');\n    var continueBtn = document.getElementById('hm-quiz-continue');\n    var backBtn = document.getElementById('hm-quiz-back');\n\n    var lead = null;\n    var answers = {};\n    var current = 0;\n    var submitted = false;\n\n    function animateIn(el, opts) {\n      if (window.anime && anime.animate && !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {\n        anime.animate(el, opts);\n      }\n    }\n\n    function show(screen) {\n      [leadScreen, questionScreen, resultScreen].forEach(function (s) {\n        s.classList.toggle('is-hidden', s !== screen);\n      });\n      animateIn(screen, { opacity: [0, 1], translateY: [12, 0], duration: 350 });\n    }\n\n    // ---------- Country codes for the WhatsApp field ----------\n    // ISO code : international dialling code. Country names come from the browser (Spanish).\n    var DIAL_CODES = 'AF:93,AX:358,AL:355,DE:49,AD:376,AO:244,AI:1264,AG:1268,SA:966,DZ:213,AR:54,AM:374,AW:297,AU:61,AT:43,AZ:994,BS:1242,BD:880,BB:1246,BH:973,BE:32,BZ:501,BJ:229,BM:1441,BY:375,MM:95,BO:591,BA:387,BW:267,BR:55,BN:673,BG:359,BF:226,BI:257,BT:975,CV:238,KH:855,CM:237,CA:1,QA:974,TD:235,CL:56,CN:86,CY:357,CO:57,KM:269,CG:242,CD:243,KP:850,KR:82,CI:225,CR:506,HR:385,CU:53,CW:599,DK:45,DJ:253,DM:1767,EC:593,EG:20,SV:503,AE:971,ER:291,SK:421,SI:386,ES:34,US:1,EE:372,SZ:268,ET:251,PH:63,FI:358,FJ:679,FR:33,GA:241,GM:220,GE:995,GH:233,GI:350,GD:1473,GR:30,GL:299,GP:590,GU:1671,GT:502,GF:594,GG:44,GN:224,GQ:240,GW:245,GY:592,HT:509,HN:504,HK:852,HU:36,IN:91,ID:62,IQ:964,IR:98,IE:353,IM:44,IS:354,KY:1345,CK:682,FO:298,FK:500,MP:1670,MH:692,SB:677,TC:1649,VG:1284,VI:1340,IL:972,IT:39,JM:1876,JP:81,JE:44,JO:962,KZ:7,KE:254,KG:996,KI:686,XK:383,KW:965,LA:856,LS:266,LV:371,LB:961,LR:231,LY:218,LI:423,LT:370,LU:352,MO:853,MK:389,MG:261,MY:60,MW:265,MV:960,ML:223,MT:356,MA:212,MQ:596,MU:230,MR:222,YT:262,MX:52,FM:691,MD:373,MC:377,MN:976,ME:382,MS:1664,MZ:258,NA:264,NR:674,NP:977,NI:505,NE:227,NG:234,NU:683,NO:47,NC:687,NZ:64,OM:968,NL:31,PK:92,PW:680,PS:970,PA:507,PG:675,PY:595,PE:51,PF:689,PL:48,PT:351,PR:1787,GB:44,CF:236,CZ:420,DO:1809,RE:262,RW:250,RO:40,RU:7,EH:212,WS:685,AS:1684,BL:590,KN:1869,SM:378,MF:590,PM:508,VC:1784,SH:290,LC:1758,VA:39,ST:239,SN:221,RS:381,SC:248,SL:232,SG:65,SX:1721,SY:963,SO:252,LK:94,ZA:27,SD:249,SS:211,SE:46,CH:41,SR:597,TH:66,TW:886,TZ:255,TJ:992,IO:246,TL:670,TG:228,TK:690,TO:676,TT:1868,TN:216,TM:993,TR:90,TV:688,UA:380,UG:256,UY:598,UZ:998,VU:678,VE:58,VN:84,WF:681,YE:967,ZM:260,ZW:263';\n    var PRIORITY_COUNTRIES = ['AR', 'US', 'MX', 'CL', 'UY', 'CO', 'ES', 'BR', 'PE', 'PY', 'BO', 'EC', 'VE'];\n    var ccSelect = document.getElementById('hm-quiz-cc');\n\n    (function buildCountrySelect() {\n      var names = null;\n      try { names = new Intl.DisplayNames(['es'], { type: 'region' }); } catch (err) {}\n\n      var list = DIAL_CODES.split(',').map(function (pair) {\n        var p = pair.split(':');\n        var label = p[0];\n        try { if (names) label = names.of(p[0]) || p[0]; } catch (err) {}\n        return { iso: p[0], dial: p[1], name: label };\n      });\n      list.sort(function (a, b) { return a.name.localeCompare(b.name, 'es'); });\n\n      function option(c) {\n        var o = document.createElement('option');\n        o.value = c.dial;\n        o.setAttribute('data-iso', c.iso);\n        o.textContent = c.name + ' (+' + c.dial + ')';\n        return o;\n      }\n\n      var top = document.createElement('optgroup');\n      top.label = 'Más usados';\n      PRIORITY_COUNTRIES.forEach(function (iso) {\n        list.forEach(function (c) { if (c.iso === iso) top.appendChild(option(c)); });\n      });\n\n      var all = document.createElement('optgroup');\n      all.label = 'Todos los países';\n      list.forEach(function (c) { all.appendChild(option(c)); });\n\n      ccSelect.appendChild(top);\n      ccSelect.appendChild(all);\n\n      // Preselect the visitor's country (from the browser language), Argentina otherwise.\n      var match = (navigator.language || '').match(/[-_]([A-Za-z]{2})$/);\n      var wanted = match ? match[1].toUpperCase() : 'AR';\n      if (!list.some(function (c) { return c.iso === wanted; })) wanted = 'AR';\n      for (var i = 0; i < ccSelect.options.length; i++) {\n        if (ccSelect.options[i].getAttribute('data-iso') === wanted) { ccSelect.selectedIndex = i; break; }\n      }\n    })();\n\n    // ---------- Step 0 ----------\n    leadForm.addEventListener('submit', function (e) {\n      e.preventDefault();\n\n      var name = document.getElementById('hm-quiz-name').value.trim();\n      var brand = document.getElementById('hm-quiz-brand').value.trim();\n      var email = document.getElementById('hm-quiz-email').value.trim();\n      var rawPhone = document.getElementById('hm-quiz-phone').value.trim();\n\n      // Full international number (starts with \"+\") is taken as typed; otherwise the selected\n      // country code is prepended and any leading zeros are dropped.\n      var phoneDigits = rawPhone.replace(/\\D/g, '');\n      var phone;\n      var phoneOk;\n      if (rawPhone.charAt(0) === '+') {\n        phone = '+' + phoneDigits;\n        phoneOk = phoneDigits.length >= 8 && phoneDigits.length <= 15;\n      } else {\n        phone = '+' + ccSelect.value + ' ' + rawPhone.replace(/^[\\s0]+/, '');\n        phoneOk = phoneDigits.replace(/^0+/, '').length >= 6 && phoneDigits.replace(/^0+/, '').length <= 13;\n      }\n\n      if (name.split(/\\s+/).length < 2) { leadError.textContent = 'Ingresá tu nombre y apellido.'; return; }\n      if (!brand) { leadError.textContent = 'Contanos el nombre de tu marca.'; return; }\n      if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) { leadError.textContent = 'Ingresá un email válido.'; return; }\n      if (!phoneOk) { leadError.textContent = 'Ingresá un número de WhatsApp válido.'; return; }\n\n      leadError.textContent = '';\n      lead = { name: name, brand: brand, email: email, phone: phone };\n      current = 0;\n      renderQuestion();\n      show(questionScreen);\n    });\n\n    // ---------- Questions ----------\n    function renderQuestion() {\n      var total = QUESTIONS.length;\n      var item = QUESTIONS[current];\n\n      progressFill.style.width = (current / total * 100) + '%';\n      progressLabel.textContent = 'Pregunta ' + (current + 1) + ' de ' + total;\n      questionText.textContent = item.q;\n      hintText.textContent = item.hint || '';\n      backBtn.classList.toggle('is-visible', current > 0);\n\n      var isMulti = item.type === 'multi';\n      continueBtn.classList.toggle('is-visible', isMulti);\n\n      optionsWrap.innerHTML = '';\n      item.options.forEach(function (label) {\n        var btn = document.createElement('button');\n        btn.type = 'button';\n        btn.className = 'hm-quiz-option';\n        btn.textContent = label;\n\n        var chosen = answers[item.key];\n        if (isMulti ? (chosen && chosen.indexOf(label) > -1) : chosen === label) {\n          btn.classList.add('is-selected');\n        }\n\n        btn.addEventListener('click', function () {\n          if (isMulti) {\n            toggleMulti(item, label);\n          } else {\n            answers[item.key] = label;\n            next();\n          }\n        });\n        optionsWrap.appendChild(btn);\n      });\n\n      animateIn(optionsWrap.children, { opacity: [0, 1], translateX: [-14, 0], duration: 350, delay: window.anime ? anime.stagger(50) : 0 });\n    }\n\n    function toggleMulti(item, label) {\n      var list = answers[item.key] || [];\n      var idx = list.indexOf(label);\n\n      if (idx > -1) {\n        list.splice(idx, 1);\n      } else if (label === ALL_MARKETING) {\n        list = [ALL_MARKETING];\n      } else {\n        list = list.filter(function (l) { return l !== ALL_MARKETING; });\n        list.push(label);\n      }\n\n      answers[item.key] = list;\n      Array.prototype.forEach.call(optionsWrap.children, function (btn) {\n        btn.classList.toggle('is-selected', list.indexOf(btn.textContent) > -1);\n      });\n    }\n\n    continueBtn.addEventListener('click', function () {\n      var list = answers[QUESTIONS[current].key] || [];\n      if (!list.length) {\n        hintText.textContent = 'Elegí al menos una opción para continuar.';\n        return;\n      }\n      next();\n    });\n\n    function next() {\n      if (current < QUESTIONS.length - 1) {\n        current += 1;\n        renderQuestion();\n      } else {\n        showResult();\n      }\n    }\n\n    backBtn.addEventListener('click', function () {\n      if (current === 0) return;\n      current -= 1;\n      renderQuestion();\n    });\n\n    // ---------- Recommendation ----------\n    function recommend(a) {\n      var budgetIdx = QUESTIONS[4].options.indexOf(a.inversion); // 0 ≤1.000 · 1 1.000-1.500 · 2 1.500-2.500 · 3 2.500+ · 4 personalizada\n      var areas = a.areas || [];\n      var wantsEverything = areas.indexOf(ALL_MARKETING) > -1;\n      var beyondBase = areas.filter(function (x) {\n        return x !== ALL_MARKETING && INCLUDED_IN_BASE.indexOf(x) < 0;\n      });\n\n      var undecided =\n        budgetIdx === 4 ||\n        a.objetivo === QUESTIONS[0].options[4] ||\n        a.presencia === QUESTIONS[2].options[3];\n      if (undecided) return 'personalizado';\n\n      if (budgetIdx <= 1) {\n        // Up to USD 1.500: Essential only if everything they asked for is inside it.\n        return (wantsEverything || beyondBase.length) ? 'personalizado' : 'essential';\n      }\n\n      // USD 1.500 or more\n      if (wantsEverything || areas.length >= 3) return 'pro';\n      if (beyondBase.length) return 'personalizado';\n      return a.objetivo === QUESTIONS[0].options[3] ? 'pro' : 'essential';\n    }\n\n    // ---------- Result + lead delivery ----------\n    function showResult() {\n      var key = recommend(answers);\n      var data = RESULTS[key];\n\n      document.getElementById('hm-quiz-result-eyebrow').textContent = data.eyebrow;\n      document.getElementById('hm-quiz-result-name').textContent = data.name;\n      document.getElementById('hm-quiz-result-price').textContent = data.price;\n      document.getElementById('hm-quiz-result-note').textContent = data.note;\n      document.getElementById('hm-quiz-result-desc').textContent = data.desc;\n\n      var cta = document.getElementById('hm-quiz-result-cta');\n      cta.textContent = data.ctaLabel;\n      cta.href = data.ctaHref;\n\n      document.getElementById('hm-quiz-pdf').hidden = !data.showPdf;\n      document.getElementById('hm-quiz-fallback').hidden = !data.showFallback;\n\n      progressFill.style.width = '100%';\n      show(resultScreen);\n\n      if (!submitted) {\n        submitted = true;\n        deliverLead(data.label);\n      }\n    }\n\n    function buildSummary(resultLabel) {\n      var areas = (answers.areas || []).join(', ');\n      return [\n        'Nombre: ' + lead.name,\n        'Marca: ' + lead.brand,\n        'Email: ' + lead.email,\n        'WhatsApp: ' + lead.phone,\n        'Budget: ' + answers.inversion,\n        'Objetivo: ' + answers.objetivo,\n        'Servicios seleccionados: ' + areas,\n        'Nivel de presencia: ' + answers.presencia,\n        'Gestión actual: ' + answers.gestion,\n        'Resultado automático: ' + resultLabel,\n      ].join('\\n');\n    }\n\n    function deliverLead(resultLabel) {\n      var summary = buildSummary(resultLabel);\n      var parts = lead.name.split(/\\s+/);\n\n      // 1) CRM (Hola Marketing) — the quiz answers travel in \"notes\".\n      try {\n        fetch(CRM_URL, {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({\n            first_name: parts[0],\n            last_name: parts.slice(1).join(' '),\n            email: lead.email,\n            phone: lead.phone,\n            notes: 'Origen: test de packs de la web\\n' + summary,\n            source: 'web_form',\n          }),\n        }).catch(function () {});\n      } catch (err) {}\n\n      // 2) Email to the Hola Marketing inbox, whatever the result was.\n      //    Shopify's own contact form can't be used from the background (it requires a captcha\n      //    token), so this goes through a form-to-email service. Inactive until EMAIL_ACCESS_KEY is set.\n      if (!EMAIL_ACCESS_KEY) return;\n      var subject = resultLabel === 'COTIZACIÓN PERSONALIZADA'\n        ? 'Nueva cotización personalizada — ' + lead.name + ' / ' + lead.brand\n        : 'Nuevo test de packs (' + resultLabel + ') — ' + lead.name + ' / ' + lead.brand;\n      try {\n        fetch('https://api.web3forms.com/submit', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },\n          body: JSON.stringify({\n            access_key: EMAIL_ACCESS_KEY,\n            subject: subject,\n            from_name: 'Web Hola Marketing',\n            replyto: lead.email,\n            message: summary,\n          }),\n        }).catch(function () {});\n      } catch (err) {}\n    }\n  });\n</script>\n",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "custom_liquid_DtEJE3": {
      "type": "custom-liquid",
      "name": "Sobre nosotros",
      "settings": {
        "custom_liquid": "<section class=\"hm-video-band hm-video-band--portfolio\" data-hm-nav-dark>\n  <style>\n    /* Video bands: the video always spans the full width at its own 16:9 height, so it is never\n       cropped and there are no side margins whose colour would have to match the video (browsers\n       colour-manage CSS colours and video frames differently, so that can't be matched reliably).\n       On very wide screens the band is simply taller than the viewport. */\n    .hm-video-band{\n      position:relative;\n      border-bottom:var(--hm-section-border);\n      background:var(--hm-black);\n      overflow:hidden;\n    }\n\n    .hm-video-band *{ box-sizing:border-box; }\n\n    /* The link owns the 16:9 box and the video fills it. Sizing the box, not the <video>,\n       keeps the height correct on iOS before the video has loaded. */\n    .hm-video-band a{\n      display:block;\n      position:relative;\n      width:100%;\n      aspect-ratio:16/9;\n    }\n\n    .hm-video-band video{\n      position:absolute;\n      inset:0;\n      width:100%;\n      height:100%;\n      object-fit:cover;\n      display:block;\n    }\n\n    /* Minimalist cue so visitors realise the video is clickable. */\n    .hm-video-band-cue{\n      position:absolute;\n      left:50%;\n      top:50%;\n      transform:translate(-50%,-50%);\n      padding:12px 26px;\n      border-radius:999px;\n      background:var(--hm-black);\n      color:var(--hm-white);\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(12px,1.1vw,15px);\n      font-weight:700;\n      letter-spacing:.04em;\n      text-transform:uppercase;\n      line-height:1;\n      white-space:nowrap;\n      animation:hmVideoCue 2.4s ease-in-out infinite;\n    }\n\n    .hm-video-band a:hover .hm-video-band-cue{\n      background:var(--hm-orange);\n    }\n\n    @keyframes hmVideoCue{\n      0%, 100%{ box-shadow:0 0 0 0 rgba(0,0,0,.45); }\n      50%{ box-shadow:0 0 0 10px rgba(0,0,0,0); }\n    }\n\n    @media (prefers-reduced-motion: reduce){\n      .hm-video-band-cue{ animation:none; }\n    }\n  </style>\n\n  <a href=\"/blogs/proyectos\" aria-label=\"Ver nuestro portfolio\">\n    <video\n      data-hm-video\n      data-src=\"https://cdn.shopify.com/videos/c/vp/f21089d853b94eb5997912c5319bda77/f21089d853b94eb5997912c5319bda77.HD-1080p-2.5Mbps-96458049.mp4\"\n      data-src-hq=\"https://cdn.shopify.com/videos/c/o/v/f21089d853b94eb5997912c5319bda77.mp4\"\n      poster=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/preview_images/f21089d853b94eb5997912c5319bda77.thumbnail.0000000000.jpg?v=1791209553\"\n      muted\n      loop\n      playsinline\n      preload=\"none\"\n      aria-hidden=\"true\"\n    ></video>\n    <span class=\"hm-video-band-cue\">Click acá →</span>\n  </a>\n</section>\n",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
