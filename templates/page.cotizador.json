de perfil + diseño de feed', price:150, desc:'Diseño de feed mensual.', type:'check'},\n        {id:'contentHour', name:'Creación de contenido por hora', price:100, desc:'Producción presencial. Ajustable por contrato.', type:'qty', unit:'h', min:0, step:1, def:0},\n        {id:'stories20', name:'20 historias', price:190, desc:'1 mes, L–V, entregadas listas.', type:'check'},\n        {id:'story1', name:'1 historia', price:9.5, desc:'Diseño/animación individual.', type:'qty', unit:'u', min:0, step:1, def:0},\n        {id:'post1', name:'1 posteo', price:35, desc:'Carrusel / post / reel individual.', type:'qty', unit:'u', min:0, step:1, def:0},\n        {id:'posts8', name:'8 posteos', price:280, desc:'Mensual (2 por semana).', type:'check'},\n        {id:'posts16', name:'16 posteos', price:560, desc:'Mensual (4 por semana).', type:'check'},\n        {id:'manychatFree', name:'Copys con Manychat Free', price:100, desc:'IA + automatización básica.', type:'check'},\n        {id:'manychatPro', name:'Copys con Manychat Premium', price:150, desc:'IA + automatización avanzada.', type:'check'},\n        {id:'metaAds', name:'Campañas Meta (Facebook/Instagram Ads)', price:600, desc:'Gestión completa.', type:'check'},\n        {id:'ytAds', name:'Campañas YouTube', price:300, desc:'YouTube Ads.', type:'check'},\n        {id:'followersOnly', name:'Campañas solo seguidores', price:150, desc:'Crecimiento de comunidad.', type:'check'},\n        {id:'logistica', name:'Gestión de logística para sitio web', price:100, desc:'Revisión, actualización y soporte diario.', type:'check'},\n        {id:'ig', name:'Gestión de Instagram', price:100, desc:'Gestión mensual.', type:'check'},\n        {id:'tiktok', name:'Gestión de TikTok', price:100, desc:'Gestión mensual.', type:'check'},\n        {id:'fb', name:'Gestión de Facebook', price:100, desc:'Gestión mensual.', type:'check'},\n        {id:'yt', name:'Gestión de YouTube', price:100, desc:'Gestión mensual.', type:'check'},\n      ],\n\n      illustrations: {\n        radios: [\n          {id:'illus-simple', name:'Ilustración simple (1 pieza)', price:40},\n          {id:'illus-custom', name:'Ilustración personalizada (personaje o producto)', price:150},\n          {id:'illus-series', name:'Serie de ilustraciones (5 piezas básicas)', price:180},\n        ]\n      },\n\n      email: [\n        {id:'email-one', name:'Campaña única de email', price:80, desc:'Diseño + envío.', type:'check'},\n        {id:'email-month', name:'Campaña mensual (4 correos)', price:300, desc:'Maquetación + diseño + programación.', type:'check'},\n      ],\n\n      packs: {\n        esencial:{price:1200, suggestMin:1100, suggestMax:2000},\n        premium:{price:3000, suggestMin:2900, suggestMax:6000}\n      }\n    };\n\n    const fmtUSD = n => `US$ ${n.toLocaleString(undefined,{maximumFractionDigits:2})}`;\n    const fmtARS = n => `ARS $${n.toLocaleString(undefined,{maximumFractionDigits:0})}`;\n    const state = { selected:new Map(), auto:new Map(), illus:new Map() };\n\n    function renderItem(container, item, catKey){\n      if(!container) return;\n\n      const card = document.createElement('div');\n      card.className = 'hmq-item hoverable';\n      card.dataset.id = item.id;\n      item.cat = catKey;\n\n      const left = document.createElement('div');\n      const h4 = document.createElement('h4');\n      h4.textContent = item.name;\n\n      const p = document.createElement('p');\n      p.textContent = item.desc || '';\n\n      left.append(h4, p);\n\n      const right = document.createElement('div');\n      right.className = 'hmq-right';\n\n      const price = document.createElement('div');\n      price.className = 'hmq-price';\n      price.textContent = fmtUSD(item.price);\n\n      if(item.type === 'qty'){\n        const box = document.createElement('div');\n        box.className = 'hmq-qty';\n\n        const minus = Object.assign(document.createElement('button'), { textContent:'−' });\n        const inp = Object.assign(document.createElement('input'), {\n          type:'number',\n          value:item.def ?? 0,\n          min:item.min ?? 0,\n          step:item.step ?? 1\n        });\n        const plus = Object.assign(document.createElement('button'), { textContent:'+' });\n\n        const change = (d) => {\n          const v = Math.max((+inp.value || 0) + d, item.min ?? 0);\n          inp.value = v;\n          setQty(item, v);\n          card.classList.toggle('active', v > 0);\n        };\n\n        minus.addEventListener('click', () => change(-(item.step || 1)));\n        plus.addEventListener('click', () => change((item.step || 1)));\n        inp.addEventListener('input', () => change(0));\n\n        box.append(minus, inp, plus);\n        right.prepend(box);\n\n      }else if(item.type === 'auto'){\n        card.classList.add('hmq-auto-label');\n\n      }else{\n        card.classList.add('selectable');\n\n        card.addEventListener('click', () => {\n          if(item.id === 'followersOnly' && state.selected.has('metaAds')) return;\n\n          const on = !state.selected.has(item.id);\n          toggleCheck(item, on);\n          card.classList.toggle('active', on);\n\n          if(item.id === 'metaAds' && on){\n            const fCard = document.querySelector('.hmq-item[data-id=\"followersOnly\"]');\n            if(fCard) fCard.classList.remove('active');\n          }\n        });\n      }\n\n      right.append(price);\n      card.append(left, right);\n      container.append(card);\n    }\n\n    function renderIllustrations(container){\n      if(!container) return;\n\n      const grp = document.createElement('div');\n      grp.className = 'hmq-items';\n\n      DATA.illustrations.radios.forEach(r => {\n        const card = document.createElement('div');\n        card.className = 'hmq-item hoverable';\n        card.dataset.id = r.id;\n\n        const left = document.createElement('div');\n        const h = document.createElement('h4');\n        h.textContent = r.name;\n        left.append(h);\n\n        const right = document.createElement('div');\n        right.className = 'hmq-right';\n\n        const box = document.createElement('div');\n        box.className = 'hmq-qty';\n\n        const minus = Object.assign(document.createElement('button'), { textContent:'−' });\n        const inp = Object.assign(document.createElement('input'), {\n          type:'number',\n          value:0,\n          min:0,\n          step:1\n        });\n        const plus = Object.assign(document.createElement('button'), { textContent:'+' });\n\n        const sync = (q) => {\n          const v = Math.max(+q || 0, 0);\n          inp.value = v;\n\n          if(v > 0){\n            state.illus.set(r.id, { name:r.name, price:r.price, qty:v });\n          }else{\n            state.illus.delete(r.id);\n          }\n\n          card.classList.toggle('active', v > 0);\n          calc();\n          renderSummary();\n        };\n\n        minus.addEventListener('click', (e) => {\n          e.stopPropagation();\n          sync((+inp.value || 0) - 1);\n        });\n\n        plus.addEventListener('click', (e) => {\n          e.stopPropagation();\n          sync((+inp.value || 0) + 1);\n        });\n\n        inp.addEventListener('input', (e) => {\n          e.stopPropagation();\n          sync(inp.value);\n        });\n\n        card.addEventListener('click', () => {\n          const current = +inp.value || 0;\n          sync(current > 0 ? 0 : 1);\n        });\n\n        box.append(minus, inp, plus);\n\n        const price = document.createElement('div');\n        price.className = 'hmq-price';\n        price.textContent = fmtUSD(r.price);\n\n        right.append(box, price);\n        card.append(left, right);\n        grp.append(card);\n      });\n\n      container.innerHTML = '';\n      container.append(grp);\n    }\n\n    function toggleCheck(item, on){\n      if(on){\n        state.selected.set(item.id, { name:item.name, price:item.price, qty:1, cat:item.cat });\n      }else{\n        state.selected.delete(item.id);\n      }\n\n      const el = document.querySelector(`.hmq-item[data-id=\"${item.id}\"]`);\n      if(el) el.classList.toggle('active', !!on);\n\n      applyRules();\n      calc();\n      renderSummary();\n    }\n\n    function setQty(item, qty){\n      if(qty > 0){\n        state.selected.set(item.id, { name:item.name, price:item.price, qty, cat:item.cat });\n      }else{\n        state.selected.delete(item.id);\n      }\n\n      const el = document.querySelector(`.hmq-item[data-id=\"${item.id}\"]`);\n      if(el) el.classList.toggle('active', qty > 0);\n\n      applyRules();\n      calc();\n      renderSummary();\n    }\n\n    function applyRules(){\n      const needsHosting = ['landing','site5','ecom'].some(id => state.selected.has(id));\n\n      if(needsHosting){\n        state.auto.set('hosting', { name:DATA.web.find(x => x.id === 'hosting').name, price:150, qty:1 });\n      }else{\n        state.auto.delete('hosting');\n      }\n\n      const metaAdsOn = state.selected.has('metaAds');\n\n      if(metaAdsOn && state.selected.has('followersOnly')){\n        state.selected.delete('followersOnly');\n        const fCard = document.querySelector('.hmq-item[data-id=\"followersOnly\"]');\n        if(fCard) fCard.classList.remove('active');\n      }\n\n      const sel = [...state.selected.values()];\n      const moreThan2 = sel.length > 2;\n      const hasBranding = sel.some(x => x.cat === 'branding' || /logo|brand|diseño/i.test(x.name));\n      const hasGestion = ['ig','tiktok','fb','yt'].some(id => state.selected.has(id));\n      const rule = document.getElementById('hmq-rule');\n\n      if(rule) rule.style.display = (moreThan2 && !hasBranding && !hasGestion) ? 'block' : 'none';\n    }\n\n    function ensureToast(){\n      let box = document.getElementById('hmq-toast');\n\n      if(!box){\n        box = document.createElement('div');\n        box.id = 'hmq-toast';\n        box.className = 'hmq-toast';\n        box.setAttribute('role', 'dialog');\n        box.setAttribute('aria-live', 'polite');\n        box.setAttribute('aria-atomic', 'true');\n        document.body.appendChild(box);\n      }\n\n      return box;\n    }\n\n    let currentToastKind = null;\n\n    function getPackSuggestion(total){\n      const E = DATA.packs.esencial;\n      const P = DATA.packs.premium;\n\n      if(total >= E.suggestMin && total <= E.suggestMax) return { kind:'esencial', price:E.price };\n      if(total >= P.suggestMin && total <= P.suggestMax) return { kind:'premium', price:P.price };\n\n      return null;\n    }\n\n    function showToast(kind, total){\n      const box = ensureToast();\n\n      if(currentToastKind === kind && box.style.display === 'block') return;\n\n      currentToastKind = kind;\n\n      const isE = kind === 'esencial';\n      const pack = DATA.packs[kind];\n      const ahorro = Math.max(0, total - pack.price);\n\n      box.className = 'hmq-toast ' + (isE ? 'green' : 'violet');\n\n      box.innerHTML = `\n        <div class=\"line\">\n          <span class=\"pill\">Sugerencia</span>\n          <button class=\"close\" aria-label=\"Cerrar\">×</button>\n        </div>\n        <div style=\"margin-top:8px;\">\n          💡 Tu selección coincide con el <strong>Pack ${isE ? 'Esencial' : 'Premium'}</strong>\n          por <strong>${fmtUSD(pack.price)}</strong>. Ahorrás <strong>${fmtUSD(ahorro)}</strong>.\n        </div>\n        <div class=\"act\">\n          <button class=\"btn\" id=\"hmq-apply-pack\">Aplicar Pack ${isE ? 'Esencial' : 'Premium'}</button>\n        </div>\n      `;\n\n      box.style.display = 'block';\n\n      box.querySelector('.close').onclick = () => {\n        box.style.display = 'none';\n        currentToastKind = null;\n      };\n\n      box.querySelector('#hmq-apply-pack').onclick = () => {\n        applyPack(kind);\n        box.style.display = 'none';\n        currentToastKind = null;\n      };\n    }\n\n    function hideToast(){\n      const box = document.getElementById('hmq-toast');\n\n      if(box){\n        box.style.display = 'none';\n        currentToastKind = null;\n      }\n    }\n\n    function calc(){\n      let total = 0;\n\n      state.selected.forEach(v => total += v.price * (v.qty || 1));\n      state.auto.forEach(v => total += v.price * (v.qty || 1));\n      state.illus.forEach(v => total += v.price * v.qty);\n\n      const usdEl = document.getElementById('hmq-total-usd');\n      const arsEl = document.getElementById('hmq-total-ars');\n\n      if(usdEl) usdEl.textContent = fmtUSD(total);\n\n      if(arsEl){\n        const ex = +document.getElementById('hmq-exrate-input').value || 0;\n        arsEl.textContent = fmtARS(Math.round(total * ex));\n      }\n\n      const s = getPackSuggestion(total);\n\n      if(s){\n        showToast(s.kind, total);\n      }else{\n        hideToast();\n      }\n\n      return total;\n    }\n\n    function applyPack(kind){\n      state.selected.clear();\n      state.auto.clear();\n      state.illus.clear();\n\n      state.selected.set(`PACK_${kind.toUpperCase()}`, {\n        name:`Pack ${kind === 'esencial' ? 'Esencial' : 'Premium'}`,\n        price:DATA.packs[kind].price,\n        qty:1,\n        cat:'pack'\n      });\n\n      document.querySelectorAll('.hmq-item.selectable').forEach(c => c.classList.remove('active'));\n\n      renderSummary();\n      calc();\n    }\n\n    function renderSummary(){\n      const sum = document.getElementById('hmq-summary');\n      if(sum) sum.innerHTML = '';\n\n      const autoBox = document.getElementById('hmq-auto');\n      if(autoBox) autoBox.innerHTML = '';\n\n      const makeRow = (id, name, amount, qty = 1, isAuto = false) => {\n        const r = document.createElement('div');\n        r.className = 'hmq-item';\n\n        const title = qty > 1 ? `${name} × ${qty}` : name;\n\n        r.innerHTML = `\n          <div><h4>${title}</h4></div>\n          <div class=\"hmq-right\">\n            <div class=\"hmq-price\">${fmtUSD(amount)}</div>\n            ${isAuto ? '' : `<button class=\"hmq-btn\" data-remove=\"${id}\" style=\"padding:6px 10px;font-size:12px;\">✕</button>`}\n          </div>\n        `;\n\n        const btn = r.querySelector('[data-remove]');\n\n        if(btn){\n          btn.addEventListener('click', () => {\n            state.selected.delete(id);\n            state.illus.delete(id);\n\n            const el = document.querySelector('.hmq-item[data-id=\"' + id + '\"]');\n\n            if(el){\n              el.classList.remove('active');\n\n              const input = el.querySelector('.hmq-qty input');\n              if(input) input.value = 0;\n            }\n\n            renderSummary();\n            calc();\n          });\n        }\n\n        return r;\n      };\n\n      if(sum){\n        if(state.selected.size === 0 && state.illus.size === 0){\n          sum.innerHTML = '<div class=\"hmq-small\">Todavía no seleccionaste servicios.</div>';\n        }\n\n        state.selected.forEach((v, k) => sum.append(makeRow(k, v.name, v.price * (v.qty || 1), v.qty || 1)));\n        state.illus.forEach((v, k) => sum.append(makeRow(k, v.name, v.price * v.qty, v.qty || 1)));\n      }\n\n      if(autoBox){\n        state.auto.forEach((v, k) => autoBox.append(makeRow(k, v.name, v.price, 1, true)));\n      }\n    }\n\n    function buildSummaryLines(){\n      const lines = [];\n\n      state.selected.forEach(v => lines.push(`• ${v.name}${v.qty > 1 ? ` × ${v.qty}` : ''} — ${fmtUSD(v.price * (v.qty || 1))}`));\n      state.illus.forEach(v => lines.push(`• ${v.name} × ${v.qty} — ${fmtUSD(v.price * v.qty)}`));\n      state.auto.forEach(v => lines.push(`• ${v.name} — ${fmtUSD(v.price)} (extra automático)`));\n\n      return lines;\n    }\n\n    function sendWhatsApp(){\n      const total = calc();\n      const lines = buildSummaryLines();\n\n      const msg = `Hola 👋 Armé mi cotización desde la web de Hola Marketing.%0AEstos son los servicios que seleccioné:%0A${encodeURIComponent(lines.join('%0A'))}%0A%0ATotal estimado: ${encodeURIComponent(fmtUSD(total))}.`;\n\n      window.open(`https://wa.me/17866897873?text=${msg}`, '_blank');\n    }\n\n    function sendEmail(){\n      const ex = +document.getElementById('hmq-exrate-input').value || 0;\n      const total = calc();\n      const lines = buildSummaryLines();\n\n      const subject = encodeURIComponent('Mi cotización — Hola Marketing');\n      const body = encodeURIComponent(`Hola,\\nArmé mi cotización desde la web de Hola Marketing.\\n\\nServicios:\\n${lines.join('\\n')}\\n\\nTotal estimado: ${fmtUSD(total)} (≈ ${fmtARS(total * ex)}).\\n`);\n\n      window.location.href = `mailto:info@holamarketing.com.ar?subject=${subject}&body=${body}`;\n    }\n\n    function downloadPDF(){\n      const ex = +document.getElementById('hmq-exrate-input').value || 0;\n      const total = calc();\n      const lines = buildSummaryLines();\n\n      const w = window.open('', '_blank');\n\n      w.document.write(`<!doctype html><html><head><meta charset='utf-8'><title>Cotización — Hola Marketing</title></head><body style=\"font-family:system-ui; padding:24px;\">`);\n      w.document.write(`<h2 style=\"margin:0 0 8px;\">Cotización — Hola Marketing</h2><p>${new Date().toLocaleString()}</p>`);\n      w.document.write(`<ul>${lines.map(l => `<li>${l.replace('• ', '')}</li>`).join('')}</ul>`);\n      w.document.write(`<h3>Total estimado: ${fmtUSD(total)} (≈ ${fmtARS(total * ex)})</h3><p style=\"color:#333\">*Valores en USD. Sujeto a ajustes al firmar contrato.</p>`);\n      w.document.write(`</body></html>`);\n\n      w.document.close();\n      w.focus();\n      w.print();\n    }\n\n    async function payNow(){\n      const total = calc();\n      const lines = buildSummaryLines();\n      const ex = +document.getElementById('hmq-exrate-input').value || 0;\n\n      if(total <= 0){\n        alert('Primero seleccioná al menos un servicio.');\n        return;\n      }\n\n      if(!lines.length){\n        alert('Primero seleccioná al menos un servicio.');\n        return;\n      }\n\n      const btn = document.getElementById('hmq-pay');\n\n      if(btn){\n        btn.disabled = true;\n        btn.textContent = 'Generando pago...';\n      }\n\n      try{\n        const res = await fetch(HM_SUPABASE_DRAFT_ORDER_URL, {\n          method:'POST',\n          headers:{\n            'Content-Type':'application/json'\n          },\n          body:JSON.stringify({\n            total_usd: total,\n            total_ars: Math.round(total * ex),\n            exchange_rate: ex,\n            services: lines,\n            source: 'cotizador-hm',\n            page_url: window.location.href,\n            created_at: new Date().toISOString()\n          })\n        });\n\n        const data = await res.json();\n\n        if(data.checkout_url){\n          window.location.href = data.checkout_url;\n          return;\n        }\n\n        console.error('[HM Quote Pay] Error:', data);\nalert(\n  'Error generando pago:\\n\\n' +\n  (data?.error || 'Sin error principal') +\n  '\\n\\n' +\n  JSON.stringify(data?.details || data, null, 2)\n);\n      }catch(error){\n        console.error('[HM Quote Pay] Error:', error);\n        alert('Hubo un error generando el pago. Probá cotizar por WhatsApp.');\n\n      }finally{\n        if(btn){\n          btn.disabled = false;\n          btn.textContent = '💳 Pagar ahora';\n        }\n      }\n    }\n\n    function renderAllCategories(){\n      const pairs = [\n        ['cat-branding','branding'],\n        ['cat-web','web'],\n        ['cat-content','content'],\n        ['cat-sueltos','sueltos'],\n        ['cat-email','email']\n      ];\n\n      pairs.forEach(([id, key]) => {\n        const box = document.getElementById(id);\n        const arr = DATA[key] || [];\n\n        if(!box) return;\n\n        box.innerHTML = '';\n        arr.forEach(it => renderItem(box, it, key));\n      });\n\n      renderIllustrations(document.getElementById('cat-illus'));\n    }\n\n    function mount(){\n      try{\n        renderAllCategories();\n\n        document.querySelectorAll('details.hmq-acc').forEach(d => {\n          const arrow = d.querySelector('.arrow');\n\n          const sync = () => {\n            if(arrow) arrow.textContent = d.open ? '▾' : '▸';\n          };\n\n          d.addEventListener('toggle', sync);\n          sync();\n        });\n\n        const wa = document.getElementById('hmq-whatsapp');\n        const em = document.getElementById('hmq-email');\n        const pdf = document.getElementById('hmq-pdf');\n        const pay = document.getElementById('hmq-pay');\n        const ex = document.getElementById('hmq-exrate-input');\n\n        if(wa) wa.addEventListener('click', sendWhatsApp);\n        if(em) em.addEventListener('click', sendEmail);\n        if(pdf) pdf.addEventListener('click', downloadPDF);\n        if(pay) pay.addEventListener('click', payNow);\n        if(ex) ex.addEventListener('input', calc);\n\n        ensureToast();\n        renderSummary();\n        calc();\n        applyRules();\n\n      }catch(e){\n        console.error('[HM Quote] Error en mount:', e);\n      }\n    }\n\n    if(document.readyState === 'complete' || document.readyState === 'interactive'){\n      requestAnimationFrame(mount);\n    }else{\n      document.addEventListener('DOMContentLoaded', mount);\n    }\n  </script>\n</section>",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
