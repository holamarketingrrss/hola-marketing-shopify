    "custom_liquid_HC3gEx": {
      "type": "custom-liquid",
      "name": "packs",
      "settings": {
        "custom_liquid": "<section class=\"hm-packs\">\n  <style>\n    .hm-packs{\n      --hm-white:#ffffff;\n      --hm-black:#000000;\n      --hm-orange:#ff5000;\n      --hm-green:#2d9f54;\n      --hm-cream:#fdf6ec;\n\n      background:var(--hm-cream);\n      padding:clamp(60px,8vw,120px) clamp(20px,5vw,90px);\n      overflow:hidden;\n    }\n\n    .hm-packs *{\n      box-sizing:border-box;\n    }\n\n    .hm-packs-wrap{\n      max-width:1500px;\n      margin:auto;\n    }\n\n    .hm-packs-title{\n      margin:0;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(32px,4vw,68px);\n      line-height:.95;\n      text-transform:uppercase;\n      letter-spacing:-.07em;\n      color:#000;\n    }\n\n    .hm-packs-sub{\n      margin:22px 0 50px;\n      max-width:1100px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(17px,1.3vw,28px);\n      line-height:1.4;\n      color:#000;\n    }\n\n    .hm-packs-grid{\n      display:grid;\n      grid-template-columns:repeat(3,1fr);\n      gap:28px;\n    }\n\n    .hm-pack{\n      background:transparent;\n      border:2px solid #000;\n      border-radius:28px;\n      padding:22px;\n      display:flex;\n      flex-direction:column;\n      transition:.25s ease;\n    }\n\n    .hm-pack:hover{\n      transform:translateY(-8px);\n    }\n\n    .hm-pack-media{\n      width:100%;\n      aspect-ratio:16/10;\n      border-radius:18px;\n      overflow:hidden;\n      border:2px solid #000;\n    }\n\n    .hm-pack-media img{\n      width:100%;\n      height:100%;\n      object-fit:cover;\n      display:block;\n    }\n\n    .hm-pack-name{\n      margin:28px 0 14px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(22px,1.8vw,38px);\n      text-transform:uppercase;\n      letter-spacing:-.05em;\n      color:#000;\n    }\n\n    .hm-pack-price{\n      margin-bottom:18px;\n      padding-bottom:16px;\n      border-bottom:2px dashed #000;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(24px,2vw,40px);\n      font-weight:900;\n      color:#000;\n    }\n\n    .hm-pack-text{\n      font-family:\"DM Sans\", sans-serif;\n      font-size:18px;\n      line-height:1.45;\n      color:#000;\n      margin-bottom:38px;\n      flex:1;\n    }\n\n    .hm-pack-btn{\n      width:100%;\n      min-height:62px;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      gap:20px;\n      border:2px solid #000;\n      border-radius:18px;\n      background:var(--hm-orange);\n      color:#fff;\n      text-decoration:none;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:18px;\n      font-weight:900;\n      text-transform:uppercase;\n      box-shadow:0 4px 0 #000;\n      transition:.18s ease;\n    }\n\n    .hm-pack-btn:hover{\n      background:var(--hm-green);\n      color:#fff;\n      transform:translateY(-3px);\n      box-shadow:0 7px 0 #000;\n    }\n\n    .hm-pack-btn span{\n      font-size:1.5em;\n    }\n\n    @media(max-width:1100px){\n      .hm-packs-grid{\n        grid-template-columns:1fr;\n        gap:24px;\n      }\n\n      .hm-pack{\n        border-radius:22px;\n      }\n\n      .hm-pack-btn{\n        min-height:56px;\n        font-size:16px;\n      }\n    }\n\n  </style>\n\n  <div class=\"hm-packs-wrap\">\n\n    <h2 class=\"hm-packs-title\">\n      Elegí tu forma de hacernos parte 👇🏻\n    </h2>\n\n    <p class=\"hm-packs-sub\">\n      Ofrecemos dos packs principales para trabajar con marcas. \n      Explorá cada opción para descubrir cuál se adapta mejor a ti. \n      También puedes crear un pack personalizado o escribirnos para consultar el clima 😎\n    </p>\n\n    <div class=\"hm-packs-grid\">\n\n      <!-- PACK 1 -->\n      <article class=\"hm-pack\">\n\n        <div class=\"hm-pack-media\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/pack1.avif?v=1778177559\"\n            alt=\"Pack Esencial\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <h3 class=\"hm-pack-name\">\n          Pack Esencial 💻\n        </h3>\n\n        <div class=\"hm-pack-price\">\n          $1,200\n        </div>\n\n        <div class=\"hm-pack-text\">\n          Recomendado para marcas que empiezan de cero y quieren adentrarse en el marketing de verdad.\n          Obtén todo lo que necesitas para lanzar tu marca en tan solo 10 días.\n        </div>\n\n        <a href=\"/pages/pack-esencial\" class=\"hm-pack-btn\">\n          Empecemos juntos <span>→</span>\n        </a>\n\n      </article>\n\n\n      <!-- PACK 2 -->\n      <article class=\"hm-pack\">\n\n        <div class=\"hm-pack-media\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/pack2.avif?v=1778177559\"\n            alt=\"Pack Premium\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <h3 class=\"hm-pack-name\">\n          Pack Premium 💻\n        </h3>\n\n        <div class=\"hm-pack-price\">\n          $3,000\n        </div>\n\n        <div class=\"hm-pack-text\">\n          Presencia completa en redes sociales, sitio web personalizado, estrategia integral, producción audiovisual y más.\n          Un equipo trabajando todos los días para que tu marca brille.\n        </div>\n\n        <a href=\"/pages/pack-premium\" class=\"hm-pack-btn\">\n          Empecemos juntos <span>→</span>\n        </a>\n\n      </article>\n\n\n      <!-- PACK 3 -->\n      <article class=\"hm-pack\">\n\n        <div class=\"hm-pack-media\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/pack2.avif?v=1778177559\"\n            alt=\"Pack personalizado\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <h3 class=\"hm-pack-name\">\n          Pack Personalizado 🎧\n        </h3>\n\n        <div class=\"hm-pack-price\">\n          Tú decides\n        </div>\n\n        <div class=\"hm-pack-text\">\n          Armá tu propuesta ideal mezclando branding, contenido, automatizaciones, campañas, sitios web y todo lo que tu marca necesite.\n        </div>\n\n        <a href=\"/pages/cotiza-tu-pack\" class=\"hm-pack-btn\">\n          Empecemos juntos <span>→</span>\n        </a>\n\n      </article>\n\n    </div>\n\n  </div>\n\n</section>",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
