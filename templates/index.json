      "settings": {
        "custom_liquid": "<section class=\"hm-club\">\n  <style>\n    .hm-club{\n      background:#fdf6ec;\n      padding:clamp(60px,8vw,110px) clamp(20px,5vw,80px);\n      overflow:hidden;\n    }\n\n    .hm-club *{ box-sizing:border-box; }\n\n    .hm-club-wrap{\n      max-width:1500px;\n      margin:0 auto;\n    }\n\n    .hm-club-title{\n      margin:0 0 50px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(34px,4vw,74px);\n      line-height:1;\n      letter-spacing:-.07em;\n      text-transform:uppercase;\n      font-style:italic;\n      color:#000;\n    }\n\n    .hm-club-grid{\n      display:grid;\n      grid-template-columns:1fr 1fr;\n      gap:36px;\n      align-items:stretch;\n    }\n\n    .hm-club-left{\n      display:grid;\n      grid-template-columns:1fr 1fr;\n      gap:26px;\n    }\n\n    .hm-club-product{\n      color:#000;\n      text-decoration:none;\n      display:flex;\n      flex-direction:column;\n    }\n\n    .hm-club-img{\n      width:100%;\n      aspect-ratio:1/1.1;\n      border:2px solid #000;\n      border-radius:18px;\n      overflow:hidden;\n      background:#fff;\n    }\n\n    .hm-club-img img{\n      width:100%;\n      height:100%;\n      object-fit:cover;\n      display:block;\n      transition:.25s ease;\n    }\n\n    .hm-club-product:hover img,\n    .hm-club-membership:hover img{\n      transform:scale(1.04);\n    }\n\n    .hm-club-name{\n      margin:24px 0 14px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(18px,1.35vw,28px);\n      line-height:1.1;\n      letter-spacing:-.05em;\n      text-transform:uppercase;\n      color:#000;\n    }\n\n    .hm-club-text{\n      margin:0 0 24px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(16px,1.2vw,22px);\n      line-height:1.35;\n      color:#000;\n    }\n\n    .hm-club-price{\n      margin-top:auto;\n      width:fit-content;\n      min-height:42px;\n      padding:0 18px;\n      display:flex;\n      align-items:center;\n      gap:12px;\n      border:2px solid #000;\n      border-radius:8px;\n      background:#ff5000;\n      color:#fff;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:18px;\n      font-weight:900;\n      text-transform:uppercase;\n      box-shadow:0 3px 0 #000;\n      transition:.18s ease;\n    }\n\n    .hm-club-product:hover .hm-club-price,\n    .hm-club-membership:hover .hm-club-price{\n      background:#2d9f54;\n      transform:translateY(-2px);\n      box-shadow:0 5px 0 #000;\n    }\n\n    .hm-club-membership{\n      display:grid;\n      grid-template-columns:.95fr 1fr;\n      gap:34px;\n      align-items:center;\n      padding:clamp(24px,3vw,42px);\n      border:2px solid #000;\n      border-radius:28px;\n      color:#000;\n      text-decoration:none;\n    }\n\n    .hm-club-membership .hm-club-img{\n      aspect-ratio:1/1;\n    }\n\n    .hm-club-membership-content{\n      display:flex;\n      flex-direction:column;\n      height:100%;\n      justify-content:center;\n    }\n\n    .hm-club-membership-title{\n      margin:0 0 22px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(24px,2vw,40px);\n      line-height:1.1;\n      letter-spacing:-.05em;\n      text-transform:uppercase;\n      color:#000;\n    }\n\n    .hm-club-membership-text{\n      margin:0 0 auto;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(18px,1.35vw,26px);\n      line-height:1.35;\n      color:#000;\n    }\n\n    .hm-club-membership .hm-club-price{\n      width:100%;\n      justify-content:center;\n      margin-top:40px;\n    }\n\n    @media(max-width:1100px){\n      .hm-club-grid{\n        grid-template-columns:1fr;\n      }\n    }\n\n    @media(max-width:700px){\n      .hm-club-left{\n        grid-template-columns:1fr;\n      }\n\n      .hm-club-membership{\n        grid-template-columns:1fr;\n      }\n\n      .hm-club-title{\n        margin-bottom:32px;\n      }\n\n      .hm-club-price{\n        width:100%;\n        justify-content:center;\n      }\n    }\n  </style>\n\n  <div class=\"hm-club-wrap\">\n\n    <h2 class=\"hm-club-title\">\n      Para creativos 👇🏻\n    </h2>\n\n    <div class=\"hm-club-grid\">\n\n      <div class=\"hm-club-left\">\n\n        <a class=\"hm-club-product\" href=\"https://clubhm.com.ar/products/kit-cm-a-freelancer\">\n          <div class=\"hm-club-img\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/cm.avif?v=1778179416\"\n              alt=\"Ebook de CM básico a CM con IA\"\n              loading=\"lazy\"\n            >\n          </div>\n\n          <h3 class=\"hm-club-name\">\n            Ebook \"De CM básico a CM con IA\"\n          </h3>\n\n          <p class=\"hm-club-text\">\n            Procesos y plantillas para vender, crear y entregar como freelancer profesional.\n          </p>\n\n          <div class=\"hm-club-price\">\n            $20.00 <span>→</span>\n          </div>\n        </a>\n\n\n        <a class=\"hm-club-product\" href=\"https://clubhm.com.ar/products/kit-freelancer-a-equipo\">\n          <div class=\"hm-club-img\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/agencia.avif?v=1778179416\"\n              alt=\"Ebook tu agencia millonaria en 2026 con IA\"\n              loading=\"lazy\"\n            >\n          </div>\n\n          <h3 class=\"hm-club-name\">\n            Ebook \"Tu agencia millonaria en 2026 con IA\"\n          </h3>\n\n          <p class=\"hm-club-text\">\n            Flujos, roles y recursos para escalar y dirigir tu equipo con claridad.\n          </p>\n\n          <div class=\"hm-club-price\">\n            $35.00 <span>→</span>\n          </div>\n        </a>\n\n      </div>\n\n\n      <a class=\"hm-club-membership\" href=\"https://clubhm.com.ar/products/membresia-club-hm\">\n\n        <div class=\"hm-club-img\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/6995b6b3078be8f504c41462_producto_3.avif?v=1778179599\"\n            alt=\"Membresía Club HM\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <div class=\"hm-club-membership-content\">\n          <h3 class=\"hm-club-membership-title\">\n            Membresía Club HM\n          </h3>\n\n          <p class=\"hm-club-membership-text\">\n            Todo el contenido y recursos que tu marca necesita mes a mes.\n          </p>\n\n          <div class=\"hm-club-price\">\n            $7 mensuales <span>→</span>\n          </div>\n        </div>\n\n      </a>\n\n    </div>\n\n  </div>\n</section>",
