    "custom_liquid_zKFdty": {
      "type": "custom-liquid",
      "name": "Hero",
      "settings": {
        "custom_liquid": "<section class=\"hm-home-hero\">\n  <style>\n    .hm-home-hero{\n      --hm-white:#ffffff;\n      --hm-black:#000000;\n      --hm-orange:#ff5000;\n      --hm-green:#2d9f54;\n      --hm-cream:#fdf6ec;\n      --hm-blue:#2462c7;\n      --hm-pink:#f5abd6;\n      --hm-violet:#d6a5ff;\n\n      min-height:100vh;\n      display:grid;\n      grid-template-columns:1fr 1fr;\n      font-family:\"DM Sans\", system-ui, sans-serif;\n      overflow:hidden;\n    }\n\n    .hm-home-hero *{ box-sizing:border-box; }\n\n    .hm-hero-left,\n    .hm-hero-right{\n      position:relative;\n      min-height:100vh;\n      padding:32px clamp(22px,4vw,64px);\n    }\n\n    .hm-hero-left{\n      background:var(--hm-pink);\n      color:var(--hm-white);\n      display:flex;\n      flex-direction:column;\n      justify-content:center;\n      align-items:center;\n      text-align:center;\n    }\n\n    .hm-hero-right{\n      background:var(--hm-green);\n      display:flex;\n      align-items:center;\n      justify-content:center;\n    }\n\n    .hm-hero-title{\n      margin:0;\n      max-width:780px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(44px,6.3vw,104px);\n      line-height:.92;\n      letter-spacing:-.07em;\n      text-transform:uppercase;\n      font-weight:700;\n    }\n\n    .hm-hero-title em{\n      display:block;\n      font-style:italic;\n      letter-spacing:-.08em;\n    }\n\n    .hm-hero-sub{\n      margin:28px auto 0;\n      max-width:660px;\n      font-size:clamp(18px,2vw,30px);\n      line-height:1.1;\n      font-weight:600;\n       letter-spacing:-1px;\n      color:var(--hm-white);\n    }\n\n    .hm-hero-btn{\n      margin-top:42px;\n      width:min(640px,88%);\n      min-height:58px;\n      display:inline-flex;\n      align-items:center;\n      justify-content:center;\n      gap:28px;\n      border:2px solid var(--hm-black);\n      border-radius:18px;\n      background:var(--hm-orange);\n      color:var(--hm-white);\n      text-decoration:none;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(16px,1.6vw,24px);\n      font-weight:600;\n      text-transform:uppercase;\n      letter-spacing:-1px;\n      transition:transform .18s ease, box-shadow .18s ease, background .18s ease;\n    }\n\n    .hm-hero-media{\n      position:relative;\n      width:min(900px,100%);\n      aspect-ratio:1/1;\n      z-index:2;\n \n    }\n\n    .hm-hero-gif{\n      width:100%\n    }\n\n   \n    .hm-menu-heart:hover{\n      transform:scale(1.05) rotate(-3deg);\n      color:var(--hm-white);\n    }\n\n    .hm-sticker{\n      position:absolute;\n      z-index:3;\n      user-select:none;\n      pointer-events:none;\n      font-size:clamp(28px,4vw,58px);\n      filter:drop-shadow(0 5px 0 rgba(0,0,0,.14));\n      animation:hmFloat 4s ease-in-out infinite;\n    }\n\n    .hm-sticker.camera{ top:10%; left:8%; }\n    .hm-sticker.spark{ bottom:10%; right:14%; animation-delay:.8s; }\n\n    @keyframes hmFloat{\n      0%,100%{ transform:translateY(0) rotate(-6deg); }\n      50%{ transform:translateY(-14px) rotate(6deg); }\n    }\n\n    @media(max-width:900px){\n      .hm-home-hero{\n        grid-template-columns:1fr;\n      }\n\n      .hm-hero-left,\n      .hm-hero-right{\n        min-height:auto;\n        padding:28px 20px;\n      }\n\n      .hm-hero-left{\n        min-height:62vh;\n        padding-top:120px;\n      }\n\n      .hm-hero-right{\n        min-height:48vh;\n      }\n\n      .hm-hero-logo{\n        width:230px;\n        top:24px;\n        left:20px;\n      }\n\n      .hm-hero-title{\n        font-size:clamp(42px,14vw,76px);\n      }\n\n      .hm-hero-sub{\n        font-size:20px;\n      }\n\n      .hm-hero-btn{\n        width:100%;\n        max-width:430px;\n        min-height:54px;\n      }\n\n      .hm-hero-media{\n        width:min(390px,88vw);\n      }\n\n      .hm-menu-heart{\n        top:18px;\n        right:18px;\n        width:118px;\n        height:98px;\n        font-size:18px;\n      }\n\n      .hm-sticker.camera{ top:12%; left:8%; }\n      .hm-sticker.spark{ bottom:8%; right:8%; }\n    }\n  </style>\n\n  <div class=\"hm-hero-left\">\n   \n\n    <div>\n      <h1 class=\"hm-hero-title\">\n        Creadas para\n        <em>crear tu marca</em>\n      </h1>\n\n      <p class=\"hm-hero-sub\">\n        Una agencia de marketing con hambre de hacer<br>\n        tu marca más creativa y vendible\n      </p>\n\n      <a class=\"hm-hero-btn\" href=\"/pages/cotiza-tu-pack\">\n        Empecemos juntos <span>→</span>\n      </a>\n    </div>\n  </div>\n\n  <div class=\"hm-hero-right\">\n\n\n    <span class=\"hm-sticker camera\">📸</span>\n\n    <div class=\"hm-hero-media\">\n      <img\n        class=\"hm-hero-gif\"\n        src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/690df56ca7e245488c803732_gif_nuevo_1.gif?v=1778171834\"\n        alt=\"Hola Marketing\"\n        loading=\"eager\"\n      >\n    </div>\n\n    <span class=\"hm-sticker spark\">✨</span>\n  </div>\n</section>",
        "color_scheme": "",
