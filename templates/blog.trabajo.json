      "settings": {
        "custom_liquid": "<section class=\"hm-jobs-list hm-section\" style=\"scroll-margin-top:90px;\">\n  <style>\n    .hm-jobs-list{\n      background:var(--hm-cream);\n      padding-top:clamp(140px,16vw,190px);\n      overflow:hidden;\n    }\n\n    .hm-jobs-list *{ box-sizing:border-box; }\n\n    .hm-jobs-list-wrap{\n      max-width:900px;\n      margin:0 auto;\n    }\n\n    .hm-jobs-list-title{\n      margin:0 auto clamp(50px,7vw,80px);\n      max-width:800px;\n      text-align:center;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:var(--hm-heading-size);\n      line-height:var(--hm-heading-line-height);\n      letter-spacing:-.05em;\n      text-transform:uppercase;\n      color:var(--hm-black);\n    }\n\n    .hm-jobs-list-items{\n      display:flex;\n      flex-direction:column;\n      gap:20px;\n    }\n\n    .hm-job-card{\n      border:2px solid var(--hm-black);\n      border-radius:24px;\n      background:var(--hm-white);\n      overflow:hidden;\n    }\n\n    .hm-job-summary{\n      list-style:none;\n      cursor:pointer;\n      display:flex;\n      align-items:center;\n      justify-content:space-between;\n      gap:20px;\n      padding:clamp(20px,3vw,32px);\n    }\n\n    .hm-job-summary::-webkit-details-marker{ display:none; }\n\n    .hm-job-title{\n      margin:0 0 10px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(19px,1.8vw,26px);\n      text-transform:uppercase;\n      letter-spacing:-.03em;\n      color:var(--hm-black);\n    }\n\n    .hm-job-meta{\n      font-family:\"DM Sans\", sans-serif;\n      font-size:15px;\n      line-height:1.6;\n      color:var(--hm-black);\n      opacity:.75;\n    }\n\n    .hm-job-meta p{ margin:0; }\n\n    .hm-job-summary-actions{\n      display:flex;\n      align-items:center;\n      gap:16px;\n      flex-shrink:0;\n    }\n\n    .hm-job-apply-btn{\n      min-height:46px;\n      padding:0 24px;\n      font-size:14px;\n    }\n\n    .hm-job-toggle-icon{\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      width:34px;\n      height:34px;\n      border:2px solid var(--hm-black);\n      border-radius:50%;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:18px;\n      flex-shrink:0;\n      transition:transform .2s ease;\n    }\n\n    .hm-job-card[open] .hm-job-toggle-icon{\n      transform:rotate(45deg);\n    }\n\n    .hm-job-card[open] .hm-job-summary{\n      border-bottom:2px dashed var(--hm-black);\n    }\n\n    .hm-job-details{\n      padding:clamp(20px,3vw,32px);\n      font-family:\"DM Sans\", sans-serif;\n      font-size:var(--hm-body-size);\n      line-height:var(--hm-body-line-height);\n      color:var(--hm-black);\n    }\n\n    .hm-job-details p{ margin:0 0 18px; }\n    .hm-job-details p:last-child{ margin-bottom:0; }\n    .hm-job-details strong{ font-family:\"JetBrains Mono\", monospace; text-transform:uppercase; letter-spacing:-.02em; }\n    .hm-job-details ul{ margin:0 0 18px; padding-left:22px; }\n    .hm-job-details ul:last-child{ margin-bottom:0; }\n    .hm-job-details li{ margin:6px 0; }\n\n    .hm-jobs-empty{\n      text-align:center;\n      padding:60px 20px;\n      border:2px dashed var(--hm-black);\n      border-radius:24px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:var(--hm-body-size);\n      color:var(--hm-black);\n    }\n\n    @media(max-width:600px){\n      .hm-job-summary{\n        flex-direction:column;\n        align-items:flex-start;\n      }\n\n      .hm-job-summary-actions{\n        width:100%;\n        justify-content:space-between;\n      }\n    }\n\n    /* Application modal */\n    .hm-job-modal-overlay{\n      position:fixed;\n      inset:0;\n      z-index:2000;\n      background:rgba(0,0,0,.55);\n      opacity:0;\n      pointer-events:none;\n      transition:opacity .25s ease;\n    }\n\n    .hm-job-modal-overlay.is-open{\n      opacity:1;\n      pointer-events:auto;\n    }\n\n    .hm-job-modal{\n      position:fixed;\n      top:50%; left:50%;\n      transform:translate(-50%,-50%) scale(.96);\n      z-index:2001;\n      width:min(560px,92vw);\n      max-height:88vh;\n      overflow-y:auto;\n      background:var(--hm-cream);\n      border:2px solid var(--hm-black);\n      border-radius:28px;\n      padding:clamp(28px,4vw,44px);\n      opacity:0;\n      pointer-events:none;\n      transition:opacity .25s ease, transform .25s ease;\n    }\n\n    .hm-job-modal.is-open{\n      opacity:1;\n      pointer-events:auto;\n      transform:translate(-50%,-50%) scale(1);\n    }\n\n    .hm-job-modal-close{\n      position:absolute;\n      top:18px;\n      right:18px;\n      width:40px;\n      height:40px;\n      border-radius:50%;\n      background:var(--hm-white);\n      border:2px solid var(--hm-black);\n      font-size:18px;\n      line-height:1;\n      cursor:pointer;\n    }\n\n    .hm-job-modal-title{\n      margin:0 0 24px;\n      padding-right:40px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(22px,2.4vw,30px);\n      text-transform:uppercase;\n      letter-spacing:-.04em;\n      color:var(--hm-black);\n    }\n\n    .hm-job-form-row{\n      display:grid;\n      grid-template-columns:1fr 1fr;\n      gap:14px;\n    }\n\n    .hm-job-modal input,\n    .hm-job-modal textarea{\n      width:100%;\n      margin-bottom:14px;\n      padding:14px 16px;\n      border:2px solid var(--hm-black);\n      border-radius:14px;\n      background:var(--hm-white);\n      color:var(--hm-black);\n      font-family:\"DM Sans\", sans-serif;\n      font-size:15px;\n      outline:none;\n    }\n\n    .hm-job-modal textarea{ resize:none; }\n\n    .hm-job-form-submit{\n      width:100%;\n      min-height:56px;\n      font-size:16px;\n      margin-top:6px;\n    }\n\n    .hm-job-form-success{\n      font-family:\"DM Sans\", sans-serif;\n      font-size:var(--hm-body-size);\n      color:var(--hm-black);\n      text-align:center;\n    }\n\n    @media(max-width:500px){\n      .hm-job-form-row{ grid-template-columns:1fr; }\n    }\n  </style>\n\n  <div class=\"hm-jobs-list-wrap\">\n    <h1 class=\"hm-jobs-list-title\">Descubrí las oportunidades que tenemos para vos 💻</h1>\n\n    <div class=\"hm-jobs-list-items\">\n      {%- for article in blog.articles -%}\n        <details class=\"hm-job-card\">\n          <summary class=\"hm-job-summary\">\n            <div>\n              <h2 class=\"hm-job-title\">{{ article.title }}</h2>\n              <div class=\"hm-job-meta\">{{ article.summary }}</div>\n            </div>\n\n            <div class=\"hm-job-summary-actions\">\n              <button type=\"button\" class=\"hm-btn hm-job-apply-btn\" data-hm-job-apply data-job-title=\"{{ article.title | escape }}\">Aplicar</button>\n              <span class=\"hm-job-toggle-icon\">+</span>\n            </div>\n          </summary>\n\n          <div class=\"hm-job-details\">\n            {{ article.content }}\n          </div>\n        </details>\n      {%- else -%}\n        <div class=\"hm-jobs-empty\">\n          No hay vacantes abiertas por el momento — seguinos en Instagram para enterarte apenas abramos una nueva búsqueda.\n        </div>\n      {%- endfor -%}\n    </div>\n  </div>\n</section>\n\n<div class=\"hm-job-modal-overlay\" data-hm-job-overlay></div>\n\n<div class=\"hm-job-modal\" id=\"hm-job-modal\">\n  <button type=\"button\" class=\"hm-job-modal-close\" data-hm-job-close aria-label=\"Cerrar\">✕</button>\n  <h2 class=\"hm-job-modal-title\">Aplicar a <span id=\"hm-job-modal-position\">este puesto</span></h2>\n\n  {%- form 'contact', id: 'hm-job-form' -%}\n    {%- if form.posted_successfully? -%}\n      <p class=\"hm-job-form-success\" id=\"hm-job-form-success\">¡Gracias! Recibimos tu postulación, te vamos a contactar pronto 💌</p>\n    {%- else -%}\n      <input type=\"hidden\" name=\"contact[Puesto]\" id=\"hm-job-form-puesto\" value=\"\">\n\n      <div class=\"hm-job-form-row\">\n        <input type=\"text\" name=\"contact[Nombre]\" placeholder=\"Nombre\" required>\n        <input type=\"text\" name=\"contact[Apellido]\" placeholder=\"Apellido\" required>\n      </div>\n\n      <input type=\"email\" name=\"contact[email]\" placeholder=\"Email\" required>\n      <input type=\"url\" name=\"contact[Link de portfolio]\" placeholder=\"Link de portfolio\">\n      <textarea name=\"contact[Motivo]\" placeholder=\"¿Por qué querés sumarte a Hola Marketing?\" rows=\"4\"></textarea>\n\n      <div class=\"hm-job-form-row\">\n        <input type=\"text\" name=\"contact[¿Trabajás en otra agencia?]\" placeholder=\"¿Trabajás en otra agencia?\">\n        <input type=\"text\" name=\"contact[País de residencia]\" placeholder=\"País de residencia\">\n      </div>\n\n      <div class=\"hm-job-form-row\">\n        <input type=\"text\" name=\"contact[Instagram]\" placeholder=\"Usuario de Instagram\">\n        <input type=\"text\" name=\"contact[WhatsApp]\" placeholder=\"WhatsApp\">\n      </div>\n\n      <button type=\"submit\" class=\"hm-btn hm-job-form-submit\">Enviar postulación</button>\n    {%- endif -%}\n  {%- endform -%}\n</div>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    var overlay = document.querySelector('[data-hm-job-overlay]');\n    var modal = document.getElementById('hm-job-modal');\n    var closeBtn = document.querySelector('[data-hm-job-close]');\n    var positionEl = document.getElementById('hm-job-modal-position');\n    var puestoInput = document.getElementById('hm-job-form-puesto');\n    if (!overlay || !modal) return;\n\n    function openModal(title) {\n      if (positionEl) positionEl.textContent = title || 'este puesto';\n      if (puestoInput) puestoInput.value = title || '';\n      overlay.classList.add('is-open');\n      modal.classList.add('is-open');\n      document.body.style.overflow = 'hidden';\n    }\n\n    function closeModal() {\n      overlay.classList.remove('is-open');\n      modal.classList.remove('is-open');\n      document.body.style.overflow = '';\n    }\n\n    document.querySelectorAll('[data-hm-job-apply]').forEach(function (btn) {\n      btn.addEventListener('click', function (e) {\n        e.preventDefault();\n        e.stopPropagation();\n        openModal(btn.dataset.jobTitle);\n      });\n    });\n\n    if (closeBtn) closeBtn.addEventListener('click', closeModal);\n    overlay.addEventListener('click', closeModal);\n    document.addEventListener('keydown', function (e) {\n      if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();\n    });\n\n    // If the contact form just posted successfully, the page reloaded — reopen\n    // the modal automatically so the confirmation message is actually visible.\n    if (document.getElementById('hm-job-form-success')) {\n      openModal();\n    }\n  });\n</script>\n",
