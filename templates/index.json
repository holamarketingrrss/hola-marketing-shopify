    "custom_liquid_zKFdty": {
      "type": "custom-liquid",
      "name": "Hero",
      "settings": {
        "custom_liquid": "<section class=\"hm-hero-v2\" id=\"hm-hero-v2\" data-hm-nav-dark>\n  <style>\n    .hm-hero-v2{\n      position:relative;\n      min-height:100svh;\n      display:flex;\n      align-items:flex-end;\n      justify-content:center;\n      overflow:hidden;\n      background:var(--hm-black);\n      border-bottom:var(--hm-section-border);\n    }\n\n    .hm-hero-v2 *{ box-sizing:border-box; }\n\n    /* Full-width, full-height video with no side margins (it fills the screen and is trimmed\n       to fit). */\n    .hm-hero-v2-video{\n      position:absolute;\n      inset:0;\n      width:100%;\n      height:100%;\n      object-fit:cover;\n      z-index:0;\n    }\n\n    .hm-hero-v2-content{\n      position:relative;\n      z-index:3;\n      text-align:center;\n      padding:0 clamp(20px,5vw,40px) clamp(36px,7vh,80px);\n    }\n\n    .hm-hero-v2-btn{\n      min-height:58px;\n      padding:0 clamp(26px,3vw,44px);\n      display:inline-flex;\n      align-items:center;\n      justify-content:center;\n      gap:20px;\n      font-size:clamp(16px,1.5vw,20px);\n      opacity:0;\n    }\n\n    .hm-hero-v2-btn.is-visible{\n      animation:hmFadeUp .6s ease forwards;\n    }\n\n    @keyframes hmFadeUp{\n      from{ opacity:0; transform:translateY(16px); }\n      to{ opacity:1; transform:translateY(0); }\n    }\n\n    @media (prefers-reduced-motion: reduce){\n      .hm-hero-v2-btn{ opacity:1; animation:none; }\n    }\n  </style>\n\n  <video\n    class=\"hm-hero-v2-video\"\n    id=\"hm-hero-v2-video\"\n    data-hm-video\n    data-src=\"https://cdn.shopify.com/videos/c/vp/ffa3a0683ea14f03aecff5145e071d3e/ffa3a0683ea14f03aecff5145e071d3e.HD-1080p-7.2Mbps-96455907.mp4\"\n    data-src-mobile=\"https://cdn.shopify.com/videos/c/vp/ffa3a0683ea14f03aecff5145e071d3e/ffa3a0683ea14f03aecff5145e071d3e.HD-720p-4.5Mbps-96455907.mp4\"\n    poster=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/preview_images/ffa3a0683ea14f03aecff5145e071d3e.thumbnail.0000000000.jpg?v=1791208116\"\n    muted\n    loop\n    playsinline\n    preload=\"none\"\n    aria-hidden=\"true\"\n  ></video>\n\n  <div class=\"hm-hero-v2-content\">\n    <a href=\"#packs\" class=\"hm-btn hm-hero-v2-btn\" id=\"hm-hero-v2-btn\">\n      Empecemos juntos <span>→</span>\n    </a>\n  </div>\n</section>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    var video = document.getElementById('hm-hero-v2-video');\n    var btn = document.getElementById('hm-hero-v2-btn');\n    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n    if (reduceMotion && video) video.pause();\n\n    setTimeout(function () { if (btn) btn.classList.add('is-visible'); }, reduceMotion ? 0 : 600);\n  });\n</script>\n",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "custom_liquid_B3btF4": {
      "type": "custom-liquid",
      "name": "purpose",
      "settings": {
        "custom_liquid": "<section class=\"hm-purpose hm-section\" id=\"proposito\">\n  <style>\n    /* Same look and section height as the Bolsa de Trabajo block. */\n    .hm-purpose{\n      background:var(--hm-cream);\n      overflow:hidden;\n      text-align:center;\n      min-height:clamp(520px, 52vw, 800px);\n      display:flex;\n      flex-direction:column;\n      align-items:center;\n      justify-content:center;\n    }\n\n    .hm-purpose *{ box-sizing:border-box; }\n\n    .hm-purpose-eyebrow{\n      margin:0 auto 22px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(14px,1.3vw,20px);\n      font-weight:700;\n      letter-spacing:.02em;\n      text-transform:uppercase;\n      color:var(--hm-orange);\n    }\n\n    .hm-purpose-title{\n      margin:0 auto;\n      max-width:1100px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:var(--hm-heading-size);\n      line-height:var(--hm-heading-line-height);\n      letter-spacing:-.05em;\n      text-transform:uppercase;\n      color:var(--hm-black);\n    }\n\n    .hm-purpose-title mark{\n      background:var(--hm-pink);\n      color:var(--hm-black);\n      padding:0 6px;\n      border-radius:4px;\n      -webkit-box-decoration-break:clone;\n      box-decoration-break:clone;\n    }\n  </style>\n\n  <p class=\"hm-purpose-eyebrow\" data-hm-reveal>Marketing con propósito. Resultados con estrategia.</p>\n\n  <h2 class=\"hm-purpose-title\" data-hm-reveal>\n    Más de 100 marcas <mark>confiaron en nuestra visión</mark> para transformar estrategia, creatividad y <mark>tecnología en crecimiento.</mark>\n  </h2>\n</section>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    var targets = document.querySelectorAll('.hm-purpose [data-hm-reveal]');\n    if (!targets.length) return;\n\n    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    if (reduceMotion || !window.anime || !anime.animate || !('IntersectionObserver' in window)) return;\n\n    targets.forEach(function (el) { el.style.opacity = 0; });\n\n    var io = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        if (!entry.isIntersecting) return;\n        io.unobserve(entry.target);\n        anime.animate(entry.target, {\n          opacity: [0, 1],\n          translateY: [24, 0],\n          duration: 700,\n          delay: entry.target.classList.contains('hm-purpose-title') ? 150 : 0,\n          ease: 'outCubic',\n        });\n      });\n    }, { threshold: 0.3 });\n\n    targets.forEach(function (el) { io.observe(el); });\n  });\n</script>\n",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
