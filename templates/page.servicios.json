        "custom_liquid": "<section class=\"hm-services\" style=\"scroll-margin-top:90px;\">\n  <style>\n    .hm-services{\n      background:var(--hm-cream);\n      padding:clamp(140px,16vw,190px) clamp(20px,5vw,90px) clamp(80px,8vw,120px);\n      overflow:hidden;\n    }\n\n    .hm-services *{ box-sizing:border-box; }\n\n    .hm-services-wrap{\n      max-width:1100px;\n      margin:0 auto;\n    }\n\n    .hm-services-intro{\n      text-align:center;\n      margin-bottom:clamp(60px,8vw,100px);\n    }\n\n    .hm-services-title{\n      margin:0 auto 30px;\n      max-width:900px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(32px,4.2vw,64px);\n      line-height:1.05;\n      letter-spacing:-.05em;\n      text-transform:uppercase;\n      color:var(--hm-black);\n    }\n\n    .hm-services-intro .hm-btn{\n      display:inline-flex;\n      align-items:center;\n      justify-content:center;\n      gap:16px;\n      min-height:58px;\n      padding:0 clamp(28px,3vw,46px);\n      font-size:18px;\n      box-shadow:0 4px 0 var(--hm-black);\n    }\n\n    .hm-services-intro .hm-btn:hover{\n      transform:translateY(-3px);\n      box-shadow:0 7px 0 var(--hm-black);\n    }\n\n    .hm-nudge{\n      display:grid;\n      grid-template-columns:auto 1fr;\n      gap:20px;\n      align-items:start;\n      max-width:820px;\n      margin:0 auto clamp(70px,9vw,110px);\n      padding:clamp(24px,3vw,36px);\n      border:2px dashed var(--hm-black);\n      border-radius:24px;\n    }\n\n    .hm-nudge-icon{\n      font-size:clamp(26px,3vw,36px);\n      line-height:1;\n    }\n\n    .hm-nudge-title{\n      margin:0 0 10px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(18px,1.6vw,24px);\n      text-transform:uppercase;\n      letter-spacing:-.03em;\n      color:var(--hm-black);\n    }\n\n    .hm-nudge-text{\n      margin:0;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(16px,1.15vw,19px);\n      line-height:1.5;\n      color:var(--hm-black);\n    }\n\n    .hm-faq-head{\n      text-align:center;\n      margin-bottom:36px;\n    }\n\n    .hm-faq-title{\n      margin:0;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(26px,3vw,42px);\n      text-transform:uppercase;\n      letter-spacing:-.05em;\n      color:var(--hm-black);\n    }\n\n    .hm-faq-list{\n      display:flex;\n      flex-direction:column;\n      gap:14px;\n    }\n\n    .hm-faq-item{\n      border:2px solid var(--hm-black);\n      border-radius:20px;\n      background:var(--hm-white);\n      overflow:hidden;\n    }\n\n    .hm-faq-item summary{\n      list-style:none;\n      cursor:pointer;\n      display:flex;\n      align-items:center;\n      justify-content:space-between;\n      gap:16px;\n      padding:20px 24px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(15px,1.2vw,19px);\n      font-weight:700;\n      color:var(--hm-black);\n    }\n\n    .hm-faq-item summary::-webkit-details-marker{ display:none; }\n\n    .hm-faq-plus{\n      flex-shrink:0;\n      width:30px;\n      height:30px;\n      border:2px solid var(--hm-black);\n      border-radius:50%;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:18px;\n      transition:transform .2s ease;\n    }\n\n    .hm-faq-item[open] .hm-faq-plus{\n      transform:rotate(45deg);\n    }\n\n    .hm-faq-item[open] summary{\n      border-bottom:2px dashed var(--hm-black);\n    }\n\n    .hm-faq-body{\n      padding:4px 24px 22px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(15px,1.1vw,18px);\n      line-height:1.55;\n      color:var(--hm-black);\n    }\n\n    .hm-faq-body a{\n      color:var(--hm-blue);\n      text-decoration:underline;\n    }\n\n    @media(max-width:640px){\n      .hm-nudge{\n        grid-template-columns:1fr;\n      }\n    }\n  </style>\n\n  <div class=\"hm-services-wrap\">\n\n    <div class=\"hm-services-intro\">\n      <h1 class=\"hm-services-title\">\n        Este es el universo donde todo cobra vida 🎨 — date una vuelta, inspirate y elegí por dónde empezamos a mejorar la tuya.\n      </h1>\n\n      <a href=\"/pages/cotiza-tu-pack\" class=\"hm-btn\">\n        Contratar servicio <span>→</span>\n      </a>\n    </div>\n\n    <div class=\"hm-nudge\">\n      <span class=\"hm-nudge-icon\">⚡</span>\n      <div>\n        <h2 class=\"hm-nudge-title\">Aún no hiciste click…</h2>\n        <p class=\"hm-nudge-text\">\n          Debes estar preguntándote cuánto tiempo tardamos en empezar. No hace falta elegir entre velocidad y calidad: podés tener ambas ✨. Después de ver todo lo que hacemos, seguro ya imaginás lo que podemos lograr.\n        </p>\n      </div>\n    </div>\n\n    <div class=\"hm-faq-head\">\n      <h2 class=\"hm-faq-title\">Preguntas frecuentes ☁️</h2>\n    </div>\n\n    <div class=\"hm-faq-list\">\n\n      <details class=\"hm-faq-item\" open>\n        <summary>¿Cuánto tardan en entregar cada proyecto?<span class=\"hm-faq-plus\">+</span></summary>\n        <div class=\"hm-faq-body\">\n          Hemos trabajado logos en 5 días, websites en 15 días y redes sociales lanzando en 10 días. Los tiempos pueden variar según la urgencia o prioridad, pero si tu marca lo necesita ya, nos movemos rápido.\n        </div>\n      </details>\n\n      <details class=\"hm-faq-item\">\n        <summary>¿Puedo cotizar online o tengo que esperar?<span class=\"hm-faq-plus\">+</span></summary>\n        <div class=\"hm-faq-body\">\n          Podés hacerlo al instante con nuestra <a href=\"/pages/cotiza-tu-pack\">calculadora online 💻</a>. Cotizá tus proyectos y cuando tengas el resultado, escribinos. Nos adaptamos a tu presupuesto.\n        </div>\n      </details>\n\n      <details class=\"hm-faq-item\">\n        <summary>¿Trabajan de forma presencial o solo online?<span class=\"hm-faq-plus\">+</span></summary>\n        <div class=\"hm-faq-body\">\n          Todo lo que sea estrategia, diseño, web y redes lo hacemos 100% online 📸. Las únicas excepciones son producciones y coberturas presenciales en Argentina y Estados Unidos.\n        </div>\n      </details>\n\n      <details class=\"hm-faq-item\">\n        <summary>¿Por dónde puedo escribirles?<span class=\"hm-faq-plus\">+</span></summary>\n        <div class=\"hm-faq-body\">\n          Por donde te quede más cómodo: WhatsApp, Instagram o nuestra web ✉️. Sí, podés <a href=\"/pages/contact\">escribirnos ahora, haciendo click acá</a>.\n        </div>\n      </details>\n\n      <details class=\"hm-faq-item\">\n        <summary>¿En qué moneda trabajan y cómo se paga?<span class=\"hm-faq-plus\">+</span></summary>\n        <div class=\"hm-faq-body\">\n          Trabajamos en dólares 💵 con pagos por adelantado. Pero si sos de Argentina, podés pagar en partes o coordinar otro método que te resulte más fácil.\n        </div>\n      </details>\n\n      <details class=\"hm-faq-item\">\n        <summary>¿Puedo pagar con tarjeta de crédito?<span class=\"hm-faq-plus\">+</span></summary>\n        <div class=\"hm-faq-body\">\n          ¡Claro que sí! 💳 Aceptamos pagos con tarjeta para que puedas avanzar sin complicaciones.\n        </div>\n      </details>\n\n    </div>\n\n  </div>\n</section>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    if (!window.anime || !anime.animate) return;\n\n    var items = document.querySelectorAll('.hm-faq-item');\n    var list = document.querySelector('.hm-faq-list');\n    if (!items.length || !list) return;\n\n    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    if (reduceMotion || !('IntersectionObserver' in window)) return;\n\n    items.forEach(function (el) {\n      el.style.opacity = '0';\n      el.style.transform = 'translateY(24px)';\n    });\n\n    var played = false;\n    var io = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        if (entry.isIntersecting && !played) {\n          played = true;\n          anime.animate(items, {\n            opacity: [0, 1],\n            translateY: [24, 0],\n            duration: 600,\n            delay: anime.stagger(90),\n          });\n          io.disconnect();\n        }\n      });\n    }, { threshold: 0.1 });\n\n    io.observe(list);\n  });\n</script>\n",
