      "name": "portfolio-article",
      "settings": {
        "custom_liquid": "<section class=\"hm-case hm-section\" style=\"scroll-margin-top:90px;\">\n  <style>\n    .hm-case{\n      background:var(--hm-cream);\n      padding-top:clamp(140px,16vw,190px);\n      overflow:hidden;\n    }\n\n    .hm-case *{ box-sizing:border-box; }\n\n    .hm-case-wrap{\n      max-width:1200px;\n      margin:0 auto;\n    }\n\n    .hm-case-back{\n      display:inline-flex;\n      align-items:center;\n      gap:8px;\n      margin-bottom:34px;\n      color:var(--hm-black);\n      text-decoration:none;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:14px;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:.03em;\n      opacity:.7;\n    }\n\n    .hm-case-back:hover{ opacity:1; }\n\n    .hm-case-tags{\n      display:flex;\n      flex-wrap:wrap;\n      gap:8px;\n      margin-bottom:20px;\n    }\n\n    .hm-case-tag{\n      display:inline-block;\n      padding:8px 18px;\n      border:2px solid var(--hm-black);\n      border-radius:999px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:14px;\n      font-weight:700;\n    }\n\n    .hm-case-title{\n      margin:0 0 18px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:var(--hm-heading-size);\n      line-height:var(--hm-heading-line-height);\n      letter-spacing:-.05em;\n      text-transform:uppercase;\n      color:var(--hm-black);\n    }\n\n    .hm-case-meta{\n      margin:0 0 36px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:14px;\n      color:var(--hm-black);\n      opacity:.65;\n    }\n\n    .hm-case-media{\n      aspect-ratio:16/10;\n      border:2px solid var(--hm-black);\n      border-radius:28px;\n      overflow:hidden;\n      margin-bottom:44px;\n      background:var(--hm-white);\n    }\n\n    .hm-case-media img{\n      width:100%;\n      height:100%;\n      object-fit:cover;\n      display:block;\n    }\n\n    .hm-case-body{\n      font-family:\"DM Sans\", sans-serif;\n      font-size:var(--hm-body-size);\n      line-height:var(--hm-body-line-height);\n      color:var(--hm-black);\n    }\n\n    /* No-JS fallback: if the section-split script doesn't run, everything\n       still renders full-width in reading order — the rules below are a\n       progressive enhancement layered on top once JS restructures the body. */\n    .hm-case-body p{ margin:0 0 22px; }\n    .hm-case-body h2, .hm-case-body h3{\n      font-family:\"JetBrains Mono\", monospace;\n      text-transform:uppercase;\n      letter-spacing:-.03em;\n      margin:36px 0 16px;\n    }\n    .hm-case-body > img, .hm-case-body > video{ width:100%; border-radius:20px; margin:24px 0; display:block; }\n    .hm-case-body a{ color:var(--hm-blue); text-decoration:underline; }\n\n    .hm-case-text{\n      max-width:760px;\n      margin:0 auto;\n    }\n\n    .hm-case-section{\n      margin-top:48px;\n    }\n\n    .hm-case-section h2{\n      display:inline-block;\n      margin:0 0 18px;\n      padding-bottom:10px;\n      border-bottom:3px solid var(--hm-orange);\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(21px,2vw,28px);\n      text-transform:uppercase;\n      letter-spacing:-.03em;\n      color:var(--hm-black);\n    }\n\n    .hm-case-team{\n      display:grid;\n      grid-template-columns:repeat(auto-fit, minmax(210px,1fr));\n      gap:14px;\n    }\n\n    .hm-case-team-item{\n      padding:16px 20px;\n      border:2px solid var(--hm-black);\n      border-radius:16px;\n      background:var(--hm-white);\n    }\n\n    .hm-case-team-role{\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:11px;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:.05em;\n      opacity:.6;\n      margin-bottom:4px;\n    }\n\n    .hm-case-team-name{\n      font-family:\"DM Sans\", sans-serif;\n      font-weight:700;\n      font-size:16px;\n    }\n\n    .hm-case-gallery-block{\n      margin-top:56px;\n    }\n\n    .hm-case-gallery-heading{\n      max-width:760px;\n      margin:0 auto 22px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(21px,2vw,28px);\n      text-transform:uppercase;\n      letter-spacing:-.03em;\n      color:var(--hm-black);\n    }\n\n    .hm-case-gallery{\n      column-count:1;\n      column-gap:20px;\n    }\n\n    @media(min-width:640px){\n      .hm-case-gallery{ column-count:2; }\n    }\n\n    @media(min-width:1000px){\n      .hm-case-gallery{ column-count:3; }\n    }\n\n    .hm-case-metrics .hm-case-gallery{\n      column-count:1;\n    }\n\n    @media(min-width:700px){\n      .hm-case-metrics .hm-case-gallery{ column-count:2; }\n    }\n\n    .hm-case-gallery img,\n    .hm-case-gallery video{\n      width:100%;\n      display:block;\n      border-radius:16px;\n      margin:0 0 20px;\n      break-inside:avoid;\n      background:var(--hm-black);\n    }\n\n    .hm-case-gallery img{\n      cursor:zoom-in;\n      transition:opacity .15s ease;\n    }\n\n    .hm-case-gallery img:hover{ opacity:.85; }\n\n    .hm-lightbox{\n      position:fixed;\n      inset:0;\n      z-index:2000;\n      background:rgba(0,0,0,.92);\n      display:none;\n      align-items:center;\n      justify-content:center;\n      padding:clamp(20px,5vw,60px);\n      opacity:0;\n    }\n\n    .hm-lightbox.is-open{ display:flex; }\n\n    .hm-lightbox-img{\n      max-width:100%;\n      max-height:100%;\n      width:auto;\n      height:auto;\n      object-fit:contain;\n      border-radius:12px;\n      display:block;\n    }\n\n    .hm-lightbox-close{\n      position:absolute;\n      top:20px;\n      right:20px;\n      width:44px;\n      height:44px;\n      border-radius:50%;\n      background:var(--hm-white);\n      border:2px solid var(--hm-black);\n      font-size:18px;\n      line-height:1;\n      cursor:pointer;\n    }\n\n    .hm-case-cta{\n      margin-top:56px;\n      padding-top:36px;\n      border-top:2px dashed var(--hm-black);\n      text-align:center;\n    }\n\n    .hm-case-cta-title{\n      margin:0 0 20px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(22px,2.4vw,34px);\n      text-transform:uppercase;\n      letter-spacing:-.04em;\n    }\n\n    .hm-case-cta-btn{\n      display:inline-flex;\n      align-items:center;\n      gap:16px;\n      min-height:58px;\n      padding:0 clamp(26px,3vw,40px);\n      font-size:17px;\n    }\n\n    .hm-case-next{\n      margin-top:28px;\n      text-align:center;\n    }\n\n    .hm-case-next-link{\n      display:inline-flex;\n      flex-direction:column;\n      gap:4px;\n      text-decoration:none;\n      color:var(--hm-black);\n    }\n\n    .hm-case-next-label{\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:12px;\n      text-transform:uppercase;\n      letter-spacing:.06em;\n      opacity:.55;\n    }\n\n    .hm-case-next-title{\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(20px,2.2vw,28px);\n      text-transform:uppercase;\n      letter-spacing:-.03em;\n      transition:color .15s ease;\n    }\n\n    .hm-case-next-link:hover .hm-case-next-title{ color:var(--hm-orange); }\n  </style>\n\n  <div class=\"hm-case-wrap\">\n    <a href=\"/blogs/{{ blog.handle }}\" class=\"hm-case-back\">← Volver a proyectos</a>\n\n    {%- if article.tags.size > 0 -%}\n      <div class=\"hm-case-tags\">\n        {%- for tag in article.tags -%}\n          <span class=\"hm-case-tag\">{{ tag }}</span>\n        {%- endfor -%}\n      </div>\n    {%- endif -%}\n\n    <h1 class=\"hm-case-title\">{{ article.title }}</h1>\n    {%- liquid\n      assign hm_month_num = article.published_at | date: '%-m'\n      case hm_month_num\n        when '1'\n          assign hm_month = 'enero'\n        when '2'\n          assign hm_month = 'febrero'\n        when '3'\n          assign hm_month = 'marzo'\n        when '4'\n          assign hm_month = 'abril'\n        when '5'\n          assign hm_month = 'mayo'\n        when '6'\n          assign hm_month = 'junio'\n        when '7'\n          assign hm_month = 'julio'\n        when '8'\n          assign hm_month = 'agosto'\n        when '9'\n          assign hm_month = 'septiembre'\n        when '10'\n          assign hm_month = 'octubre'\n        when '11'\n          assign hm_month = 'noviembre'\n        when '12'\n          assign hm_month = 'diciembre'\n      endcase\n    -%}\n    <p class=\"hm-case-meta\">{{ article.published_at | date: '%-d' }} de {{ hm_month }}, {{ article.published_at | date: '%Y' }}</p>\n\n    {%- if article.image -%}\n      <div class=\"hm-case-media\">\n        <img src=\"{{ article.image | image_url: width: 1600 }}\" alt=\"{{ article.title }}\" loading=\"eager\">\n      </div>\n    {%- endif -%}\n\n    <div class=\"hm-case-body\" id=\"hm-case-body\">\n      {{ article.content }}\n    </div>\n\n    <div class=\"hm-case-cta\">\n      <h2 class=\"hm-case-cta-title\">¿Querés un resultado así para tu marca?</h2>\n      <a href=\"/#packs\" class=\"hm-btn hm-case-cta-btn\">Hablemos <span>→</span></a>\n    </div>\n\n    {%- if blog.next_article -%}\n      <div class=\"hm-case-next\">\n        <a href=\"{{ blog.next_article.url }}\" class=\"hm-case-next-link\">\n          <span class=\"hm-case-next-label\">Próximo proyecto</span>\n          <span class=\"hm-case-next-title\">{{ blog.next_article.title }} →</span>\n        </a>\n      </div>\n    {%- endif -%}\n  </div>\n</section>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    var body = document.getElementById('hm-case-body');\n    if (!body) return;\n\n    var children = Array.prototype.slice.call(body.children);\n\n    var leadEls = [];      // intro paragraphs, before any heading/credits/media\n    var sections = [];     // { heading, els: [] } — one per <h2>/<h3> the editor adds\n    var teamPairs = [];    // { role, name } parsed out of the \"Role: Name<br>...\" paragraph\n    var mediaEls = [];     // regular photo/video gallery\n    var metricEls = [];    // screenshots of stats/analytics — kept in their own section\n    var currentSection = null;\n\n    function tryParseCredits(p) {\n      var strongs = p.querySelectorAll('strong');\n      if (!strongs.length) return false;\n\n      var allLookLikeRoles = Array.prototype.every.call(strongs, function (s) {\n        return /:\\s*$/.test(s.textContent.trim());\n      });\n      if (!allLookLikeRoles) return false;\n\n      var lines = p.innerHTML.split(/<br\\s*\\/?>/i);\n      var pairs = [];\n      lines.forEach(function (line) {\n        var match = line.match(/<strong>([^<]+?):\\s*<\\/strong>\\s*(.*)/i);\n        if (match) {\n          var role = match[1].trim();\n          var name = match[2].replace(/<[^>]+>/g, '').trim();\n          if (role && name) pairs.push({ role: role, name: name });\n        }\n      });\n\n      if (!pairs.length) return false;\n      teamPairs = teamPairs.concat(pairs);\n      return true;\n    }\n\n    children.forEach(function (el) {\n      if (el.tagName === 'H2' || el.tagName === 'H3') {\n        currentSection = { heading: el.textContent.trim(), els: [] };\n        sections.push(currentSection);\n        return;\n      }\n\n      if (el.tagName === 'IMG' || el.tagName === 'VIDEO') {\n        var isMetric = el.tagName === 'IMG' && /estadistic/i.test(el.getAttribute('src') || '');\n        (isMetric ? metricEls : mediaEls).push(el);\n        return;\n      }\n\n      if (el.tagName === 'P' && !currentSection && tryParseCredits(el)) {\n        return;\n      }\n\n      if (currentSection) {\n        currentSection.els.push(el);\n      } else {\n        leadEls.push(el);\n      }\n    });\n\n    if (!mediaEls.length && !metricEls.length && !sections.length && !teamPairs.length) {\n      // Nothing to restructure (e.g. a bare-bones article) — leave the\n      // original flow exactly as Shopify rendered it.\n      return;\n    }\n\n    body.innerHTML = '';\n\n    if (leadEls.length) {\n      var leadWrap = document.createElement('div');\n      leadWrap.className = 'hm-case-text';\n      leadEls.forEach(function (el) { leadWrap.appendChild(el); });\n      body.appendChild(leadWrap);\n    }\n\n    sections.forEach(function (sec) {\n      var secWrap = document.createElement('div');\n      secWrap.className = 'hm-case-text hm-case-section';\n      var h2 = document.createElement('h2');\n      h2.textContent = sec.heading;\n      secWrap.appendChild(h2);\n      sec.els.forEach(function (el) { secWrap.appendChild(el); });\n      body.appendChild(secWrap);\n    });\n\n    if (teamPairs.length) {\n      var teamWrap = document.createElement('div');\n      teamWrap.className = 'hm-case-text hm-case-section';\n      var teamH2 = document.createElement('h2');\n      teamH2.textContent = 'Equipo';\n      teamWrap.appendChild(teamH2);\n\n      var teamGrid = document.createElement('div');\n      teamGrid.className = 'hm-case-team';\n      teamPairs.forEach(function (pair) {\n        var item = document.createElement('div');\n        item.className = 'hm-case-team-item';\n\n        var roleEl = document.createElement('div');\n        roleEl.className = 'hm-case-team-role';\n        roleEl.textContent = pair.role;\n\n        var nameEl = document.createElement('div');\n        nameEl.className = 'hm-case-team-name';\n        nameEl.textContent = pair.name;\n\n        item.appendChild(roleEl);\n        item.appendChild(nameEl);\n        teamGrid.appendChild(item);\n      });\n      teamWrap.appendChild(teamGrid);\n      body.appendChild(teamWrap);\n    }\n\n    function appendGallerySection(heading, els, extraClass) {\n      if (!els.length) return null;\n      var wrap = document.createElement('div');\n      wrap.className = 'hm-case-gallery-block' + (extraClass ? ' ' + extraClass : '');\n      var h2 = document.createElement('h2');\n      h2.className = 'hm-case-gallery-heading';\n      h2.textContent = heading;\n      wrap.appendChild(h2);\n      var gallery = document.createElement('div');\n      gallery.className = 'hm-case-gallery';\n      els.forEach(function (el) { gallery.appendChild(el); });\n      wrap.appendChild(gallery);\n      body.appendChild(wrap);\n      return gallery;\n    }\n\n    var mainGallery = appendGallerySection('Trabajo realizado', mediaEls);\n    var metricsGallery = appendGallerySection('Métricas y Resultados', metricEls, 'hm-case-metrics');\n\n    // Lightbox for gallery photos (videos keep their own native controls).\n    var allGalleryImgs = body.querySelectorAll('.hm-case-gallery img');\n    if (!allGalleryImgs.length) return;\n\n    var lightbox = document.createElement('div');\n    lightbox.className = 'hm-lightbox';\n    lightbox.innerHTML = '<button type=\"button\" class=\"hm-lightbox-close\" aria-label=\"Cerrar\">✕</button><img class=\"hm-lightbox-img\" alt=\"\">';\n    document.body.appendChild(lightbox);\n\n    var lightboxImg = lightbox.querySelector('.hm-lightbox-img');\n    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n    function openLightbox(src, alt) {\n      lightboxImg.src = src;\n      lightboxImg.alt = alt || '';\n      lightbox.classList.add('is-open');\n      document.body.style.overflow = 'hidden';\n      if (!reduceMotion && window.anime && anime.animate) {\n        anime.animate(lightbox, { opacity: [0, 1], duration: 200 });\n      } else {\n        lightbox.style.opacity = 1;\n      }\n    }\n\n    function closeLightbox() {\n      lightbox.classList.remove('is-open');\n      lightbox.style.opacity = 0;\n      document.body.style.overflow = '';\n    }\n\n    allGalleryImgs.forEach(function (img) {\n      img.addEventListener('click', function () {\n        openLightbox(img.src, img.alt);\n      });\n    });\n\n    lightbox.querySelector('.hm-lightbox-close').addEventListener('click', closeLightbox);\n    lightbox.addEventListener('click', function (e) {\n      if (e.target === lightbox) closeLightbox();\n    });\n    document.addEventListener('keydown', function (e) {\n      if (e.key === 'Escape' && lightbox.classList.contains('is-open')) closeLightbox();\n    });\n  });\n</script>\n",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
