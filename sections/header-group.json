    "hm_navbar": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<header class=\"hm-navbar\" data-hm-navbar>\n  <div class=\"hm-navbar-inner\">\n    <a href=\"/\" class=\"hm-navbar-logo\" aria-label=\"{{ shop.name }} — Inicio\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/BIENVENIDOS_A_4.png?v=1787582664\" alt=\"{{ shop.name }}\">\n    </a>\n\n    <button\n      type=\"button\"\n      class=\"hm-navbar-heart\"\n      aria-haspopup=\"true\"\n      aria-expanded=\"false\"\n      aria-controls=\"hm-menu-drawer\"\n      data-hm-menu-toggle\n      aria-label=\"Abrir menú\"\n    >\n      <img src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/corazon.png?v=1787236518\" alt=\"\" aria-hidden=\"true\">\n    </button>\n  </div>\n</header>\n\n<div class=\"hm-menu-overlay\" data-hm-menu-overlay hidden></div>\n\n<nav class=\"hm-menu-drawer\" id=\"hm-menu-drawer\" aria-label=\"Menú principal\" aria-hidden=\"true\">\n  <button type=\"button\" class=\"hm-menu-close\" data-hm-menu-toggle aria-label=\"Cerrar menú\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n      <path d=\"M5 5l14 14M19 5L5 19\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    </svg>\n  </button>\n\n  <ul class=\"hm-menu-list\">\n    {%- for link in linklists.main-menu.links -%}\n      <li><a href=\"{{ link.url }}\">{{ link.title }}</a></li>\n    {%- endfor -%}\n  </ul>\n\n  <a href=\"/pages/cotiza-tu-pack\" class=\"hm-btn hm-menu-cta\">\n    Empecemos juntos <span>→</span>\n  </a>\n\n  <div class=\"hm-menu-social\">\n    <a href=\"https://instagram.com\" target=\"_blank\" rel=\"noopener\">Instagram</a>\n    <a href=\"https://pinterest.com\" target=\"_blank\" rel=\"noopener\">Pinterest</a>\n    <a href=\"https://tiktok.com\" target=\"_blank\" rel=\"noopener\">TikTok</a>\n  </div>\n</nav>\n\n<style>\n  .hm-navbar{\n    position:fixed;\n    top:0; left:0; right:0;\n    z-index:1000;\n    background:transparent;\n    pointer-events:none;\n  }\n\n  .hm-navbar-inner{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    padding:22px clamp(20px,4vw,48px);\n  }\n\n  .hm-navbar-logo,\n  .hm-navbar-heart{\n    pointer-events:auto;\n  }\n\n  .hm-navbar-logo{\n    display:flex;\n    align-items:center;\n    text-decoration:none;\n    filter:drop-shadow(0 2px 6px rgba(0,0,0,.15));\n  }\n\n  .hm-navbar-logo img{\n    height:clamp(48px,6vw,72px);\n    width:100%;\n    display:block;\n  }\n\n  .hm-navbar-heart{\n    width:80px;\n    height:80px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    background:none;\n    border:none;\n    padding:0;\n    cursor:pointer;\n    transition:transform .18s ease;\n\n  }\n\n  .hm-navbar-heart:hover{\n    transform:scale(1.08) rotate(-4deg);\n  }\n\n  .hm-navbar-heart img{\n    width:100%;\n    height:100%;\n    object-fit:contain;\n  }\n\n  .hm-menu-overlay{\n    position:fixed;\n    inset:0;\n    z-index:1001;\n    background:rgba(0,0,0,.35);\n    opacity:0;\n    pointer-events:none;\n    transition:opacity .28s ease;\n  }\n\n  .hm-menu-overlay.is-open{\n    opacity:1;\n    pointer-events:auto;\n  }\n\n  .hm-menu-drawer{\n    position:fixed;\n    top:0; right:0;\n    z-index:1002;\n    width:min(420px,88vw);\n    height:100%;\n    background:var(--hm-black);\n    color:var(--hm-cream);\n    padding:28px 32px 40px;\n    display:flex;\n    flex-direction:column;\n    transform:translateX(100%);\n    transition:transform .32s cubic-bezier(.16,1,.3,1);\n  }\n\n  .hm-menu-drawer.is-open{\n    transform:translateX(0);\n  }\n\n  .hm-menu-close{\n    align-self:flex-end;\n    width:44px;\n    height:44px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    background:none;\n    border:none;\n    color:var(--hm-cream);\n    cursor:pointer;\n  }\n\n  .hm-menu-close svg{\n    width:22px;\n    height:22px;\n  }\n\n  .hm-menu-list{\n    list-style:none;\n    margin:24px 0 0;\n    padding:0;\n    display:flex;\n    flex-direction:column;\n    gap:6px;\n  }\n\n  .hm-menu-list a{\n    display:block;\n    padding:14px 4px;\n    color:var(--hm-cream);\n    text-decoration:none;\n    font-family:\"JetBrains Mono\", monospace;\n    font-size:clamp(24px,4vw,34px);\n    font-weight:700;\n    text-transform:uppercase;\n    letter-spacing:-.03em;\n    border-bottom:1px dashed rgba(253,246,236,.2);\n    transition:color .18s ease, padding-left .18s ease;\n  }\n\n  .hm-menu-list a:hover{\n    color:var(--hm-orange);\n    padding-left:12px;\n  }\n\n  .hm-menu-cta{\n    margin-top:auto;\n    width:100%;\n    min-height:58px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    gap:16px;\n    font-size:18px;\n  }\n\n  .hm-menu-social{\n    margin-top:22px;\n    display:flex;\n    gap:20px;\n    flex-wrap:wrap;\n  }\n\n  .hm-menu-social a{\n    color:var(--hm-cream);\n    opacity:.7;\n    text-decoration:none;\n    font-family:\"DM Sans\", sans-serif;\n    font-size:13px;\n    text-transform:uppercase;\n    letter-spacing:.06em;\n  }\n\n  .hm-menu-social a:hover{\n    opacity:1;\n  }\n\n  @media(max-width:480px){\n    .hm-menu-drawer{\n      width:100%;\n      padding:22px 22px 32px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce){\n    .hm-menu-drawer,\n    .hm-menu-overlay,\n    .hm-navbar-heart{\n      transition:none;\n    }\n  }\n</style>\n\n<script>\n  (function(){\n    var toggles = document.querySelectorAll('[data-hm-menu-toggle]');\n    var drawer = document.getElementById('hm-menu-drawer');\n    var overlay = document.querySelector('[data-hm-menu-overlay]');\n    var heartBtn = document.querySelector('.hm-navbar-heart');\n    if (!drawer || !overlay || !heartBtn) return;\n\n    var lastFocused = null;\n\n    function openMenu(){\n      lastFocused = document.activeElement;\n      drawer.classList.add('is-open');\n      overlay.classList.add('is-open');\n      overlay.hidden = false;\n      drawer.setAttribute('aria-hidden', 'false');\n      heartBtn.setAttribute('aria-expanded', 'true');\n      document.body.style.overflow = 'hidden';\n      var closeBtn = drawer.querySelector('.hm-menu-close');\n      if (closeBtn) closeBtn.focus();\n    }\n\n    function closeMenu(){\n      drawer.classList.remove('is-open');\n      overlay.classList.remove('is-open');\n      drawer.setAttribute('aria-hidden', 'true');\n      heartBtn.setAttribute('aria-expanded', 'false');\n      document.body.style.overflow = '';\n      setTimeout(function(){ overlay.hidden = true; }, 300);\n      if (lastFocused) lastFocused.focus();\n    }\n\n    toggles.forEach(function(btn){\n      btn.addEventListener('click', function(){\n        var isOpen = drawer.classList.contains('is-open');\n        isOpen ? closeMenu() : openMenu();\n      });\n    });\n\n    overlay.addEventListener('click', closeMenu);\n\n    document.addEventListener('keydown', function(e){\n      if (e.key === 'Escape' && drawer.classList.contains('is-open')) closeMenu();\n    });\n  })();\n</script>"
