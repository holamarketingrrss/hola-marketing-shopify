{
  "sections": {
    "main": {
      "type": "main-page",
      "blocks": {
        "custom_liquid_n9jP9U": {
          "type": "custom-liquid",
          "name": "t:names.custom_liquid",
          "settings": {
            "custom_liquid": "<!--\n  Formulario \"Producciones HM\" — se pega tal cual en una sección \"Custom Liquid\"\n  del tema (Tienda online → Personalizar → agregar sección → Custom Liquid).\n  Usa las mismas variables y clases del quiz de packs (--hm-*, .hm-btn).\n  Las respuestas llegan al CRM → Producciones HM → solapa Formularios, con badge MARCA o UGC.\n-->\n<section class=\"hm-prod hm-section\" id=\"form-producciones\" style=\"scroll-margin-top:90px;\">\n  <style>\n    .hm-prod{\n      background:var(--hm-cream);\n      overflow:hidden;\n    }\n\n    .hm-prod *{ box-sizing:border-box; }\n\n    .hm-prod-wrap{\n      width:100%;\n      margin:auto;\n    }\n\n    .hm-prod-title{\n      margin:0;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:var(--hm-heading-size);\n      line-height:var(--hm-heading-line-height);\n      text-transform:uppercase;\n      letter-spacing:-.07em;\n      color:var(--hm-black);\n      text-align:center;\n    }\n\n    .hm-prod-sub{\n      margin:22px auto 0;\n      max-width:640px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:var(--hm-body-size);\n      line-height:var(--hm-body-line-height);\n      color:var(--hm-black);\n      text-align:center;\n    }\n\n    .hm-prod-card{\n      margin-top:1.3rem;\n      background:var(--hm-white);\n      border:2px solid var(--hm-black);\n      border-radius:28px;\n      padding:clamp(28px,4vw,48px);\n      min-height:420px;\n      display:flex;\n      flex-direction:column;\n    }\n\n    .hm-prod-screen.is-hidden{ display:none; }\n    .hm-prod-hidden{ display:none !important; }\n\n    .hm-prod-progress-track{\n      width:100%;\n      height:8px;\n      border-radius:999px;\n      background:rgba(0,0,0,.08);\n      overflow:hidden;\n      margin-bottom:10px;\n    }\n\n    .hm-prod-progress-fill{\n      height:100%;\n      background:var(--hm-orange);\n      border-radius:999px;\n      width:0%;\n      transition:width .3s ease;\n    }\n\n    .hm-prod-progress-label{\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:13px;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:.04em;\n      color:var(--hm-black);\n      opacity:.6;\n      margin-bottom:28px;\n    }\n\n    .hm-prod-step-label{\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:13px;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:.04em;\n      color:var(--hm-orange);\n      margin-bottom:10px;\n    }\n\n    .hm-prod-step-title{\n      margin:0 0 24px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(21px,2.2vw,30px);\n      line-height:1.2;\n      letter-spacing:-.03em;\n      color:var(--hm-black);\n    }\n\n    .hm-prod-fields{\n      display:grid;\n      grid-template-columns:1fr 1fr;\n      gap:14px;\n    }\n\n    .hm-prod-field{ display:flex; flex-direction:column; gap:6px; }\n    .hm-prod-field.is-full{ grid-column:1 / -1; }\n\n    .hm-prod-field label,\n    .hm-prod-label{\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:12px;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:.04em;\n      color:var(--hm-black);\n    }\n\n    .hm-prod-opt{\n      font-weight:400;\n      opacity:.55;\n      text-transform:none;\n      letter-spacing:0;\n    }\n\n    .hm-prod-field input,\n    .hm-prod-field textarea{\n      width:100%;\n      padding:14px 16px;\n      border:2px solid var(--hm-black);\n      border-radius:14px;\n      background:var(--hm-white);\n      color:var(--hm-black);\n      font-family:\"DM Sans\", sans-serif;\n      font-size:16px;\n    }\n\n    .hm-prod-field textarea{ resize:vertical; min-height:110px; }\n\n    .hm-prod-field input:focus,\n    .hm-prod-field textarea:focus{\n      outline:none;\n      border-color:var(--hm-orange);\n    }\n\n    .hm-prod-trap{\n      position:absolute !important;\n      left:-9999px !important;\n      width:1px !important;\n      height:1px !important;\n      overflow:hidden !important;\n    }\n\n    .hm-prod-chips{\n      display:flex;\n      flex-wrap:wrap;\n      gap:10px;\n    }\n\n    .hm-prod-chips.is-stack{ flex-direction:column; }\n\n    .hm-prod-chip{\n      text-align:left;\n      padding:12px 18px;\n      border:2px solid var(--hm-black);\n      border-radius:999px;\n      background:var(--hm-white);\n      color:var(--hm-black);\n      font-family:\"DM Sans\", sans-serif;\n      font-size:15px;\n      font-weight:600;\n      cursor:pointer;\n      transition:background .15s ease, color .15s ease;\n    }\n\n    .hm-prod-chips.is-stack .hm-prod-chip{\n      border-radius:16px;\n      padding:16px 20px;\n      font-size:clamp(15px,1.1vw,17px);\n    }\n\n    .hm-prod-chip:hover,\n    .hm-prod-chip.is-selected{\n      background:var(--hm-orange);\n      color:var(--hm-white);\n    }\n\n    .hm-prod-error{\n      margin:16px 0 0;\n      min-height:20px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:14px;\n      font-weight:700;\n      color:#c0392b;\n    }\n\n    .hm-prod-actions{\n      margin-top:auto;\n      padding-top:22px;\n      display:flex;\n      gap:14px;\n      align-items:center;\n    }\n\n    .hm-prod-next{\n      flex:1;\n      min-height:58px;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      gap:18px;\n      font-size:18px;\n      cursor:pointer;\n    }\n\n    .hm-prod-next[disabled]{ opacity:.6; cursor:wait; }\n\n    .hm-prod-back{\n      background:none;\n      border:none;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:14px;\n      font-weight:700;\n      text-transform:uppercase;\n      color:var(--hm-black);\n      opacity:.6;\n      cursor:pointer;\n      visibility:hidden;\n    }\n\n    .hm-prod-back.is-visible{ visibility:visible; }\n    .hm-prod-back:hover{ opacity:1; }\n\n    /* Pantalla final */\n    .hm-prod-done-eyebrow{\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:13px;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:.04em;\n      color:var(--hm-orange);\n    }\n\n    .hm-prod-done-title{\n      margin:8px 0 14px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(26px,3vw,40px);\n      text-transform:uppercase;\n      letter-spacing:-.05em;\n      color:var(--hm-black);\n    }\n\n    .hm-prod-done-text{\n      margin:0 0 28px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(16px,1.15vw,19px);\n      line-height:1.5;\n      color:var(--hm-black);\n    }\n\n    .hm-prod-done-actions{\n      display:flex;\n      gap:14px;\n      flex-wrap:wrap;\n    }\n\n    .hm-prod-done-btn{\n      min-height:56px;\n      padding:0 26px;\n      display:block;\n      align-items:center;\n      justify-content:center;\n      font-size:16px;\n    }\n\n    @media(max-width:600px){\n      .hm-prod-card{ padding:24px; min-height:auto; }\n      .hm-prod-fields{ grid-template-columns:1fr; }\n      .hm-prod-done-actions{ flex-direction:column; }\n      .hm-prod-done-btn{ width:100%; }\n    }\n  </style>\n\n  <div class=\"hm-prod-wrap\">\n    <h2 class=\"hm-prod-title\">Contanos tu proyecto</h2>\n    <p class=\"hm-prod-sub\">\n      Completá el formulario y nos ponemos en contacto para armar tu producción — sea que vengas como marca o como creador/a de contenido.\n    </p>\n\n    <div class=\"hm-prod-card\">\n      <form id=\"hm-prod-form\" novalidate>\n\n        <div class=\"hm-prod-progress-track\">\n          <div class=\"hm-prod-progress-fill\" id=\"hm-prod-progress-fill\"></div>\n        </div>\n        <div class=\"hm-prod-progress-label\" id=\"hm-prod-progress-label\">Paso 1 de 3</div>\n\n        <!-- Campo trampa anti-bots: las personas no lo ven -->\n        <div class=\"hm-prod-trap\" aria-hidden=\"true\">\n          <label for=\"hm-prod-trap\">No completar</label>\n          <input type=\"text\" id=\"hm-prod-trap\" name=\"company_website\" tabindex=\"-1\" autocomplete=\"off\">\n        </div>\n\n        <!-- PASO 1 -->\n        <div class=\"hm-prod-screen\" data-step=\"0\">\n          <div class=\"hm-prod-step-label\">Paso 1 — Quién sos</div>\n          <h3 class=\"hm-prod-step-title\">Primero, contanos quién completa el formulario.</h3>\n\n          <div class=\"hm-prod-chips is-stack\" id=\"hm-prod-type\" style=\"margin-bottom:22px;\">\n            <button type=\"button\" class=\"hm-prod-chip\" data-type=\"marca\">Soy una marca o negocio</button>\n            <button type=\"button\" class=\"hm-prod-chip\" data-type=\"ugc\">Soy creador/a de contenido (UGC)</button>\n          </div>\n\n          <div class=\"hm-prod-fields\">\n            <div class=\"hm-prod-field\">\n              <label for=\"hm-prod-name\">Nombre y apellido</label>\n              <input type=\"text\" id=\"hm-prod-name\" autocomplete=\"name\">\n            </div>\n            <div class=\"hm-prod-field\">\n              <label for=\"hm-prod-brand\" id=\"hm-prod-brand-label\">Nombre de la marca</label>\n              <input type=\"text\" id=\"hm-prod-brand\" autocomplete=\"organization\">\n            </div>\n            <div class=\"hm-prod-field\">\n              <label for=\"hm-prod-email\">Email</label>\n              <input type=\"email\" id=\"hm-prod-email\" autocomplete=\"email\">\n            </div>\n            <div class=\"hm-prod-field\">\n              <label for=\"hm-prod-phone\">WhatsApp</label>\n              <input type=\"tel\" id=\"hm-prod-phone\" autocomplete=\"tel\" placeholder=\"+54 9 11 ...\">\n            </div>\n          </div>\n        </div>\n\n        <!-- PASO 2 -->\n        <div class=\"hm-prod-screen is-hidden\" data-step=\"1\">\n          <div class=\"hm-prod-step-label\">Paso 2 — Tu proyecto</div>\n          <h3 class=\"hm-prod-step-title\" id=\"hm-prod-step2-title\">¿Dónde te encontramos y qué contenido necesitás?</h3>\n\n          <div class=\"hm-prod-fields\">\n            <div class=\"hm-prod-field\">\n              <label for=\"hm-prod-instagram\">Instagram</label>\n              <input type=\"text\" id=\"hm-prod-instagram\" placeholder=\"@tumarca\">\n            </div>\n            <div class=\"hm-prod-field\">\n              <label for=\"hm-prod-website\">Página web o tienda online <span class=\"hm-prod-opt\">(opcional)</span></label>\n              <input type=\"text\" id=\"hm-prod-website\" placeholder=\"https://\">\n            </div>\n            <div class=\"hm-prod-field\">\n              <label for=\"hm-prod-rubro\" id=\"hm-prod-rubro-label\">Rubro</label>\n              <input type=\"text\" id=\"hm-prod-rubro\" placeholder=\"Ej: indumentaria, gastronomía, cosmética\">\n            </div>\n            <div class=\"hm-prod-field\">\n              <label for=\"hm-prod-zone\">Ciudad o zona</label>\n              <input type=\"text\" id=\"hm-prod-zone\" placeholder=\"Ej: Palermo, CABA\">\n            </div>\n          </div>\n\n          <div class=\"hm-prod-field\" style=\"margin-top:22px;\">\n            <span class=\"hm-prod-label\" id=\"hm-prod-content-label\">¿Qué tipo de contenido necesitás?</span>\n            <div class=\"hm-prod-chips\" id=\"hm-prod-content\"></div>\n          </div>\n\n          <div class=\"hm-prod-field\" style=\"margin-top:22px;\">\n            <span class=\"hm-prod-label\" id=\"hm-prod-channels-label\">¿En qué canales lo vas a usar?</span>\n            <div class=\"hm-prod-chips\" id=\"hm-prod-channels\"></div>\n          </div>\n        </div>\n\n        <!-- PASO 3 -->\n        <div class=\"hm-prod-screen is-hidden\" data-step=\"2\">\n          <div class=\"hm-prod-step-label\">Paso 3 — Detalles</div>\n          <h3 class=\"hm-prod-step-title\">Contanos la idea y cerramos los detalles.</h3>\n\n          <div class=\"hm-prod-fields\">\n            <div class=\"hm-prod-field is-full\">\n              <label for=\"hm-prod-idea\" id=\"hm-prod-idea-label\">Contanos brevemente la idea o necesidad de tu proyecto</label>\n              <textarea id=\"hm-prod-idea\"></textarea>\n            </div>\n            <div class=\"hm-prod-field is-full\">\n              <label for=\"hm-prod-date\">Fecha estimada para realizar la producción <span class=\"hm-prod-opt\">(opcional)</span></label>\n              <input type=\"date\" id=\"hm-prod-date\">\n            </div>\n          </div>\n\n          <div class=\"hm-prod-field\" id=\"hm-prod-budget-wrap\" style=\"margin-top:22px;\">\n            <span class=\"hm-prod-label\">¿Con qué presupuesto cuenta?</span>\n            <div class=\"hm-prod-chips is-stack\" id=\"hm-prod-budget\"></div>\n          </div>\n\n          <div class=\"hm-prod-fields\" style=\"margin-top:22px;\">\n            <div class=\"hm-prod-field is-full\">\n              <label for=\"hm-prod-refs\">Referencias o links <span class=\"hm-prod-opt\">(opcional)</span></label>\n              <textarea id=\"hm-prod-refs\" placeholder=\"Links de Instagram, Pinterest, videos, marcas que te gusten…\"></textarea>\n            </div>\n            <div class=\"hm-prod-field is-full\">\n              <label for=\"hm-prod-extra\">Algo más que quieras agregar sobre tu consulta <span class=\"hm-prod-opt\">(opcional)</span></label>\n              <textarea id=\"hm-prod-extra\"></textarea>\n            </div>\n          </div>\n        </div>\n\n        <p class=\"hm-prod-error\" id=\"hm-prod-error\" role=\"alert\"></p>\n\n        <div class=\"hm-prod-actions\">\n          <button type=\"button\" class=\"hm-prod-back\" id=\"hm-prod-back\">← Anterior</button>\n          <button type=\"submit\" class=\"hm-btn hm-prod-next\" id=\"hm-prod-next\">Siguiente <span>→</span></button>\n        </div>\n      </form>\n\n      <!-- Pantalla final -->\n      <div class=\"hm-prod-screen is-hidden\" id=\"hm-prod-done\">\n        <span class=\"hm-prod-done-eyebrow\">Consulta enviada</span>\n        <h3 class=\"hm-prod-done-title\">¡Gracias! Ya tenemos tu información.</h3>\n        <p class=\"hm-prod-done-text\" id=\"hm-prod-done-text\"></p>\n        <div class=\"hm-prod-done-actions\" id=\"hm-prod-done-actions\">\n          <a href=\"https://wa.link/lh1gwp\" target=\"_blank\" rel=\"noopener\" class=\"hm-btn hm-prod-done-btn\">Escribinos por WhatsApp</a>\n          <a href=\"https://calendar.app.google/GaRqhS7U38U57FoL6\" target=\"_blank\" rel=\"noopener\" class=\"hm-btn hm-prod-done-btn\">Agendar una call con Yvette</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    var ENDPOINT = 'https://crm.holamarketing.com.ar/api/public/producciones-form/aecac2de-0659-4c86-85ea-f4aea5449b10';\n\n    var CONTENT_TYPES = ['Reels', 'Fotografías', 'UGC', 'Videos de producto', 'E-commerce', 'Publicidad', 'Todavía no definido'];\n    var CHANNELS = ['Instagram', 'TikTok', 'Publicidad', 'Tienda online', 'Diferentes canales', 'Todavía no definido'];\n    var BUDGETS = ['Hasta USD 300', 'USD 300 – 800', 'USD 800 – 1.500', 'USD 1.500 o más', 'Todavía no lo definí, quiero una cotización'];\n    var UNDEFINED = 'Todavía no definido';\n\n    var TOTAL_STEPS = 3;\n\n    var form = document.getElementById('hm-prod-form');\n    var screens = form.querySelectorAll('.hm-prod-screen');\n    var progressFill = document.getElementById('hm-prod-progress-fill');\n    var progressLabel = document.getElementById('hm-prod-progress-label');\n    var errorEl = document.getElementById('hm-prod-error');\n    var nextBtn = document.getElementById('hm-prod-next');\n    var backBtn = document.getElementById('hm-prod-back');\n    var doneScreen = document.getElementById('hm-prod-done');\n\n    var state = { type: '', content: [], channels: [], budget: '' };\n    var step = 0;\n    var sending = false;\n\n    function el(id) { return document.getElementById(id); }\n    function val(id) { return el(id).value.trim(); }\n\n    function animateIn(node) {\n      if (window.anime && anime.animate && !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {\n        anime.animate(node, { opacity: [0, 1], translateY: [12, 0], duration: 350 });\n      }\n    }\n\n    // ---------- Chips ----------\n    function buildChips(containerId, options, getList, setList, exclusiveLabel) {\n      var wrap = el(containerId);\n      options.forEach(function (label) {\n        var btn = document.createElement('button');\n        btn.type = 'button';\n        btn.className = 'hm-prod-chip';\n        btn.textContent = label;\n        btn.addEventListener('click', function () {\n          var list = getList();\n          var idx = list.indexOf(label);\n          if (idx > -1) {\n            list.splice(idx, 1);\n          } else if (label === exclusiveLabel) {\n            list = [label];\n          } else {\n            list = list.filter(function (l) { return l !== exclusiveLabel; });\n            list.push(label);\n          }\n          setList(list);\n          Array.prototype.forEach.call(wrap.children, function (b) {\n            b.classList.toggle('is-selected', list.indexOf(b.textContent) > -1);\n          });\n        });\n        wrap.appendChild(btn);\n      });\n    }\n\n    buildChips('hm-prod-content', CONTENT_TYPES,\n      function () { return state.content; }, function (l) { state.content = l; }, UNDEFINED);\n    buildChips('hm-prod-channels', CHANNELS,\n      function () { return state.channels; }, function (l) { state.channels = l; }, UNDEFINED);\n\n    // Presupuesto: una sola opción\n    (function () {\n      var wrap = el('hm-prod-budget');\n      BUDGETS.forEach(function (label) {\n        var btn = document.createElement('button');\n        btn.type = 'button';\n        btn.className = 'hm-prod-chip';\n        btn.textContent = label;\n        btn.addEventListener('click', function () {\n          state.budget = label;\n          Array.prototype.forEach.call(wrap.children, function (b) {\n            b.classList.toggle('is-selected', b.textContent === label);\n          });\n        });\n        wrap.appendChild(btn);\n      });\n    })();\n\n    // ---------- Marca o UGC ----------\n    Array.prototype.forEach.call(el('hm-prod-type').children, function (btn) {\n      btn.addEventListener('click', function () {\n        state.type = btn.getAttribute('data-type');\n        Array.prototype.forEach.call(el('hm-prod-type').children, function (b) {\n          b.classList.toggle('is-selected', b === btn);\n        });\n        applyType();\n      });\n    });\n\n    function applyType() {\n      var ugc = state.type === 'ugc';\n      el('hm-prod-brand-label').textContent = ugc ? 'Tu nombre o usuario como creador/a' : 'Nombre de la marca';\n      el('hm-prod-rubro-label').textContent = ugc ? 'Nicho' : 'Rubro';\n      el('hm-prod-rubro').placeholder = ugc ? 'Ej: belleza, gastronomía, moda, tecnología' : 'Ej: indumentaria, gastronomía, cosmética';\n      el('hm-prod-instagram').placeholder = ugc ? '@tuusuario' : '@tumarca';\n      el('hm-prod-step2-title').textContent = ugc\n        ? '¿Dónde te encontramos y qué contenido creás?'\n        : '¿Dónde te encontramos y qué contenido necesitás?';\n      el('hm-prod-content-label').textContent = ugc ? '¿Qué tipo de contenido creás?' : '¿Qué tipo de contenido necesitás?';\n      el('hm-prod-channels-label').textContent = ugc ? '¿En qué canales publicás?' : '¿En qué canales lo vas a usar?';\n      el('hm-prod-idea-label').textContent = ugc\n        ? 'Contanos qué hacés y qué te gustaría trabajar con nosotras'\n        : 'Contanos brevemente la idea o necesidad de tu proyecto';\n      el('hm-prod-refs').placeholder = ugc\n        ? 'Links a tu portfolio, TikTok, Instagram o trabajos anteriores…'\n        : 'Links de Instagram, Pinterest, videos, marcas que te gusten…';\n      el('hm-prod-budget-wrap').classList.toggle('hm-prod-hidden', ugc);\n    }\n\n    // ---------- Pasos ----------\n    function render() {\n      Array.prototype.forEach.call(screens, function (s) {\n        s.classList.toggle('is-hidden', Number(s.getAttribute('data-step')) !== step);\n      });\n      progressFill.style.width = ((step + 1) / TOTAL_STEPS * 100) + '%';\n      progressLabel.textContent = 'Paso ' + (step + 1) + ' de ' + TOTAL_STEPS;\n      backBtn.classList.toggle('is-visible', step > 0);\n      nextBtn.innerHTML = step === TOTAL_STEPS - 1 ? 'Enviar consulta <span>→</span>' : 'Siguiente <span>→</span>';\n      errorEl.textContent = '';\n      animateIn(screens[step]);\n    }\n\n    function validate(s) {\n      if (s === 0) {\n        if (!state.type) return 'Indicá si sos una marca o un creador/a de contenido.';\n        if (val('hm-prod-name').split(/\\s+/).length < 2) return 'Ingresá tu nombre y apellido.';\n        if (!val('hm-prod-brand')) return state.type === 'ugc' ? 'Contanos tu nombre o usuario como creador/a.' : 'Contanos el nombre de tu marca.';\n        if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(val('hm-prod-email'))) return 'Ingresá un email válido.';\n        if (val('hm-prod-phone').replace(/\\D/g, '').length < 8) return 'Ingresá un WhatsApp válido (con código de área).';\n      }\n      if (s === 1) {\n        if (!val('hm-prod-instagram') && !val('hm-prod-website')) return 'Ingresá tu Instagram o tu página web.';\n        if (!val('hm-prod-rubro')) return state.type === 'ugc' ? 'Contanos tu nicho.' : 'Contanos tu rubro.';\n        if (!state.content.length) return 'Elegí al menos un tipo de contenido.';\n        if (!state.channels.length) return 'Elegí al menos un canal.';\n      }\n      if (s === 2) {\n        if (val('hm-prod-idea').length < 10) return 'Contanos un poco más sobre tu idea o necesidad.';\n        if (state.type === 'marca' && !state.budget) return 'Elegí un presupuesto estimado (o indicá que querés una cotización).';\n      }\n      return '';\n    }\n\n    backBtn.addEventListener('click', function () {\n      if (sending || step === 0) return;\n      step -= 1;\n      render();\n    });\n\n    form.addEventListener('submit', function (e) {\n      e.preventDefault();\n      if (sending) return;\n\n      var problem = validate(step);\n      if (problem) { errorEl.textContent = problem; return; }\n\n      if (step < TOTAL_STEPS - 1) {\n        step += 1;\n        render();\n        return;\n      }\n      send();\n    });\n\n    // ---------- Envío ----------\n    function send() {\n      sending = true;\n      nextBtn.disabled = true;\n      errorEl.textContent = '';\n\n      var payload = {\n        lead_type: state.type,\n        full_name: val('hm-prod-name'),\n        business_name: val('hm-prod-brand'),\n        email: val('hm-prod-email'),\n        phone: val('hm-prod-phone'),\n        instagram: val('hm-prod-instagram'),\n        website: val('hm-prod-website'),\n        business_type: val('hm-prod-rubro'),\n        neighborhood: val('hm-prod-zone'),\n        content_types: state.content,\n        channels: state.channels,\n        project_idea: val('hm-prod-idea'),\n        desired_date: val('hm-prod-date'),\n        budget_range: state.type === 'marca' ? state.budget : '',\n        references: val('hm-prod-refs'),\n        extra_info: val('hm-prod-extra'),\n        page_url: window.location.href,\n        source_keyword: (new URLSearchParams(window.location.search).get('ref') || '').slice(0, 100),\n        company_website: val('hm-prod-trap')\n      };\n\n      fetch(ENDPOINT, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify(payload)\n      })\n        .then(function (res) {\n          return res.json().catch(function () { return {}; }).then(function (data) {\n            return { ok: res.ok && data.success !== false, data: data };\n          });\n        })\n        .then(function (result) {\n          if (!result.ok) {\n            errorEl.textContent = (result.data && result.data.message) || 'No pudimos enviar tu consulta. Probá de nuevo en un momento.';\n            sending = false;\n            nextBtn.disabled = false;\n            return;\n          }\n          showDone();\n        })\n        .catch(function () {\n          errorEl.textContent = 'No pudimos enviar tu consulta. Revisá tu conexión y probá de nuevo.';\n          sending = false;\n          nextBtn.disabled = false;\n        });\n    }\n\n    function showDone() {\n      var ugc = state.type === 'ugc';\n      el('hm-prod-done-text').textContent = ugc\n        ? 'Revisamos tu perfil y, si encaja con algún proyecto, te escribimos por WhatsApp o email.'\n        : 'Nuestro equipo va a revisar tu consulta y te contacta en breve para armar tu producción. Si preferís adelantar la charla, escribinos o agendá una call.';\n      el('hm-prod-done-actions').classList.toggle('hm-prod-hidden', ugc);\n      form.classList.add('hm-prod-hidden');\n      doneScreen.classList.remove('is-hidden');\n      animateIn(doneScreen);\n      var top = el('form-producciones');\n      if (top && top.scrollIntoView) top.scrollIntoView({ behavior: 'smooth', block: 'start' });\n    }\n\n    render();\n  });\n</script>"
          },
