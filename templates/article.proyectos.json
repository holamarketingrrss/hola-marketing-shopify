        "custom_liquid": "<section class=\"hm-case hm-section\" style=\"scroll-margin-top:90px;\">\n  <style>\n    .hm-case{\n      background:var(--hm-cream);\n      padding-top:clamp(140px,16vw,190px);\n      overflow:hidden;\n    }\n\n    .hm-case *{ box-sizing:border-box; }\n\n    .hm-case-wrap{\n      max-width:900px;\n      margin:0 auto;\n    }\n\n    .hm-case-back{\n      display:inline-flex;\n      align-items:center;\n      gap:8px;\n      margin-bottom:34px;\n      color:var(--hm-black);\n      text-decoration:none;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:14px;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:.03em;\n      opacity:.7;\n    }\n\n    .hm-case-back:hover{ opacity:1; }\n\n    .hm-case-tags{\n      display:flex;\n      flex-wrap:wrap;\n      gap:8px;\n      margin-bottom:20px;\n    }\n\n    .hm-case-tag{\n      display:inline-block;\n      padding:8px 18px;\n      border:2px solid var(--hm-black);\n      border-radius:999px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:14px;\n      font-weight:700;\n    }\n\n    .hm-case-title{\n      margin:0 0 18px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:var(--hm-heading-size);\n      line-height:var(--hm-heading-line-height);\n      letter-spacing:-.05em;\n      text-transform:uppercase;\n      color:var(--hm-black);\n    }\n\n    .hm-case-meta{\n      margin:0 0 36px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:14px;\n      color:var(--hm-black);\n      opacity:.65;\n    }\n\n    .hm-case-media{\n      aspect-ratio:16/10;\n      border:2px solid var(--hm-black);\n      border-radius:28px;\n      overflow:hidden;\n      margin-bottom:44px;\n      background:var(--hm-white);\n    }\n\n    .hm-case-media img{\n      width:100%;\n      height:100%;\n      object-fit:cover;\n      display:block;\n    }\n\n    .hm-case-body{\n      font-family:\"DM Sans\", sans-serif;\n      font-size:var(--hm-body-size);\n      line-height:var(--hm-body-line-height);\n      color:var(--hm-black);\n    }\n\n    .hm-case-body p{ margin:0 0 22px; }\n    .hm-case-body h2, .hm-case-body h3{\n      font-family:\"JetBrains Mono\", monospace;\n      text-transform:uppercase;\n      letter-spacing:-.03em;\n      margin:36px 0 16px;\n    }\n    .hm-case-body img{ width:100%; border-radius:20px; margin:24px 0; }\n    .hm-case-body video{ width:100%; border-radius:20px; margin:24px 0; display:block; background:var(--hm-black); }\n    .hm-case-body a{ color:var(--hm-blue); text-decoration:underline; }\n\n    .hm-case-cta{\n      margin-top:56px;\n      padding-top:36px;\n      border-top:2px dashed var(--hm-black);\n      text-align:center;\n    }\n\n    .hm-case-cta-title{\n      margin:0 0 20px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(22px,2.4vw,34px);\n      text-transform:uppercase;\n      letter-spacing:-.04em;\n    }\n\n    .hm-case-cta-btn{\n      display:inline-flex;\n      align-items:center;\n      gap:16px;\n      min-height:58px;\n      padding:0 clamp(26px,3vw,40px);\n      font-size:17px;\n    }\n  </style>\n\n  <div class=\"hm-case-wrap\">\n    <a href=\"/blogs/{{ blog.handle }}\" class=\"hm-case-back\">← Volver a proyectos</a>\n\n    {%- if article.tags.size > 0 -%}\n      <div class=\"hm-case-tags\">\n        {%- for tag in article.tags -%}\n          <span class=\"hm-case-tag\">{{ tag }}</span>\n        {%- endfor -%}\n      </div>\n    {%- endif -%}\n\n    <h1 class=\"hm-case-title\">{{ article.title }}</h1>\n    {%- liquid\n      assign hm_month_num = article.published_at | date: '%-m'\n      case hm_month_num\n        when '1' assign hm_month = 'enero'\n        when '2' assign hm_month = 'febrero'\n        when '3' assign hm_month = 'marzo'\n        when '4' assign hm_month = 'abril'\n        when '5' assign hm_month = 'mayo'\n        when '6' assign hm_month = 'junio'\n        when '7' assign hm_month = 'julio'\n        when '8' assign hm_month = 'agosto'\n        when '9' assign hm_month = 'septiembre'\n        when '10' assign hm_month = 'octubre'\n        when '11' assign hm_month = 'noviembre'\n        when '12' assign hm_month = 'diciembre'\n      endcase\n    -%}\n    <p class=\"hm-case-meta\">{{ article.published_at | date: '%-d' }} de {{ hm_month }}, {{ article.published_at | date: '%Y' }}</p>\n\n    {%- if article.image -%}\n      <div class=\"hm-case-media\">\n        <img src=\"{{ article.image | image_url: width: 1600 }}\" alt=\"{{ article.title }}\" loading=\"eager\">\n      </div>\n    {%- endif -%}\n\n    <div class=\"hm-case-body\">\n      {{ article.content }}\n    </div>\n\n    <div class=\"hm-case-cta\">\n      <h2 class=\"hm-case-cta-title\">¿Querés un resultado así para tu marca?</h2>\n      <a href=\"/#CTA\" class=\"hm-btn hm-case-cta-btn\">Hablemos <span>→</span></a>\n    </div>\n  </div>\n</section>\n",
