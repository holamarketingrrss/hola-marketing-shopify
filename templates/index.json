    "custom_liquid_zKFdty": {
      "type": "custom-liquid",
      "name": "Hero",
      "settings": {
        "custom_liquid": "<section class=\"hm-hero-v2\" id=\"hm-hero-v2\">\n  <style>\n    .hm-hero-v2{\n      position:relative;\n      min-height:100svh;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      overflow:hidden;\n      /* Placeholder gradient standing in for the hero video — swap in a real <video> once footage is ready. */\n      background:radial-gradient(circle at 28% 22%, #2a2a2a 0%, var(--hm-black) 62%);\n      border-bottom:var(--hm-section-border);\n    }\n\n    .hm-hero-v2 *{ box-sizing:border-box; }\n\n    .hm-hero-v2-video{\n      position:absolute;\n      inset:0;\n      width:100%;\n      height:100%;\n      object-fit:cover;\n      z-index:0;\n    }\n\n    .hm-hero-v2-overlay{\n      position:absolute;\n      inset:0;\n      z-index:1;\n      background:linear-gradient(180deg, rgba(0,0,0,.6) 0%, rgba(0,0,0,.4) 45%, rgba(0,0,0,.65) 100%);\n    }\n\n    .hm-hero-v2-stickers{\n      position:absolute;\n      inset:0;\n      z-index:2;\n      pointer-events:none;\n    }\n\n    .hm-hero-v2-sticker{\n      position:absolute;\n      width:clamp(48px,6vw,92px);\n      aspect-ratio:1/1;\n      object-fit:cover;\n      border-radius:16px;\n      border:4px solid var(--hm-white);\n      filter:drop-shadow(0 6px 10px rgba(0,0,0,.35));\n      will-change:transform;\n    }\n\n    .hm-hero-v2-sticker.emoji{\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      background:var(--hm-cream);\n      font-size:clamp(22px,2.6vw,34px);\n    }\n\n    .hm-hero-v2-sticker.s1{ top:14%; left:9%; transform:rotate(-8deg); }\n    .hm-hero-v2-sticker.s2{ top:20%; right:11%; width:clamp(40px,4.6vw,68px); transform:rotate(10deg); }\n    .hm-hero-v2-sticker.s3{ bottom:16%; left:14%; width:clamp(40px,4.6vw,68px); transform:rotate(6deg); }\n    .hm-hero-v2-sticker.s4{ bottom:12%; right:8%; transform:rotate(-10deg); }\n    .hm-hero-v2-sticker.s5{ top:46%; left:4%; width:clamp(34px,4vw,56px); transform:rotate(-14deg); }\n    .hm-hero-v2-sticker.s6{ top:44%; right:4%; width:clamp(34px,4vw,56px); transform:rotate(14deg); }\n\n    .hm-hero-v2-content{\n      position:relative;\n      z-index:3;\n      text-align:center;\n      color:var(--hm-white);\n      padding:0 clamp(20px,5vw,40px);\n      max-width:900px;\n    }\n\n    .hm-hero-v2-title{\n      margin:0;\n      font-family:\"JetBrains Mono\", monospace;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:-.05em;\n      line-height:.98;\n      font-size:clamp(38px,7vw,110px);\n    }\n\n    .hm-hero-v2-title .hm-line{\n      display:block;\n    }\n\n    .hm-hero-v2-title .hm-line.em{\n      font-style:italic;\n    }\n\n    .hm-hero-v2-title .hm-char{\n      display:inline-block;\n      opacity:0;\n    }\n\n    .hm-hero-v2-cursor{\n      display:inline-block;\n      width:.07em;\n      height:.85em;\n      background:var(--hm-orange);\n      margin-left:6px;\n      vertical-align:-.08em;\n      opacity:0;\n      animation:hmCursorBlink 1s step-end infinite;\n    }\n\n    .hm-hero-v2-cursor.is-active{ opacity:1; }\n    .hm-hero-v2-cursor.is-done{ animation:none; opacity:0; }\n\n    @keyframes hmCursorBlink{\n      0%, 49%{ opacity:1; }\n      50%, 100%{ opacity:0; }\n    }\n\n    .hm-hero-v2-sub{\n      margin:28px auto 0;\n      max-width:640px;\n      font-size:clamp(17px,1.8vw,26px);\n      font-weight:600;\n      line-height:1.35;\n      color:rgba(255,255,255,.88);\n      opacity:0;\n    }\n\n    .hm-hero-v2-sub.is-visible{\n      animation:hmFadeUp .6s ease forwards;\n    }\n\n    .hm-hero-v2-btn{\n      margin:36px auto 0;\n      min-height:58px;\n      padding:0 clamp(26px,3vw,44px);\n      display:inline-flex;\n      align-items:center;\n      justify-content:center;\n      gap:20px;\n      font-size:clamp(16px,1.5vw,20px);\n      opacity:0;\n    }\n\n    .hm-hero-v2-btn.is-visible{\n      animation:hmFadeUp .6s ease forwards;\n    }\n\n    @keyframes hmFadeUp{\n      from{ opacity:0; transform:translateY(16px); }\n      to{ opacity:1; transform:translateY(0); }\n    }\n\n    @media(max-width:640px){\n      .hm-hero-v2-sticker{ display:none; }\n      .hm-hero-v2-sticker.s1, .hm-hero-v2-sticker.s4{ display:flex; }\n    }\n\n    @media (prefers-reduced-motion: reduce){\n      .hm-hero-v2-title .hm-char{ opacity:1; transform:none; }\n      .hm-hero-v2-cursor{ display:none; }\n      .hm-hero-v2-sub, .hm-hero-v2-btn{ opacity:1; animation:none; }\n    }\n  </style>\n\n  <div class=\"hm-hero-v2-overlay\"></div>\n\n  <div class=\"hm-hero-v2-stickers\" id=\"hm-hero-v2-stickers\">\n    <img class=\"hm-hero-v2-sticker s1\" data-depth=\"1.4\" src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/camera.jpg?v=1787237923\" alt=\"\" loading=\"lazy\">\n    <img class=\"hm-hero-v2-sticker s2\" data-depth=\"0.8\" src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/star.jpg?v=1787237924\" alt=\"\" loading=\"lazy\">\n    <div class=\"hm-hero-v2-sticker emoji s3\" data-depth=\"1.1\">💻</div>\n    <img class=\"hm-hero-v2-sticker s4\" data-depth=\"1.3\" src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/star.jpg?v=1787237924\" alt=\"\" loading=\"lazy\">\n    <img class=\"hm-hero-v2-sticker s5\" data-depth=\"0.6\" src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/camera.jpg?v=1787237923\" alt=\"\" loading=\"lazy\">\n    <div class=\"hm-hero-v2-sticker emoji s6\" data-depth=\"0.9\">🚀</div>\n  </div>\n\n  <div class=\"hm-hero-v2-content\">\n    <h1 class=\"hm-hero-v2-title\" id=\"hm-hero-v2-title\">\n      <span class=\"hm-line\" data-text=\"Creadas para\"></span>\n      <span class=\"hm-line em\" data-text=\"crear tu marca\"></span>\n      <span class=\"hm-hero-v2-cursor\" id=\"hm-hero-v2-cursor\"></span>\n    </h1>\n\n    <p class=\"hm-hero-v2-sub\" id=\"hm-hero-v2-sub\">\n      Una agencia de marketing con hambre de hacer<br>\n      tu marca más creativa y vendible\n    </p>\n\n    <a href=\"#agenda\" class=\"hm-btn hm-hero-v2-btn\" id=\"hm-hero-v2-btn\">\n      Empecemos juntos <span>→</span>\n    </a>\n  </div>\n</section>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    var hero = document.getElementById('hm-hero-v2');\n    var cursor = document.getElementById('hm-hero-v2-cursor');\n    var sub = document.getElementById('hm-hero-v2-sub');\n    var btn = document.getElementById('hm-hero-v2-btn');\n    var lines = hero.querySelectorAll('.hm-hero-v2-title .hm-line');\n    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n    // Build one <span class=\"hm-char\"> per character so we can reveal them one by one.\n    var allChars = [];\n    lines.forEach(function (line) {\n      var text = line.dataset.text || '';\n      text.split('').forEach(function (ch) {\n        var span = document.createElement('span');\n        span.className = 'hm-char';\n        span.textContent = ch === ' ' ? ' ' : ch;\n        line.appendChild(span);\n        allChars.push(span);\n      });\n    });\n\n    function revealSubAndBtn() {\n      sub.classList.add('is-visible');\n      btn.classList.add('is-visible');\n      if (cursor) cursor.classList.add('is-done');\n    }\n\n    if (reduceMotion || !window.anime || !anime.animate) {\n      allChars.forEach(function (c) { c.style.opacity = '1'; c.style.transform = 'none'; });\n      revealSubAndBtn();\n      return;\n    }\n\n    if (cursor) cursor.classList.add('is-active');\n\n    anime.animate(allChars, {\n      opacity: [0, 1],\n      duration: 60,\n      delay: anime.stagger(90),\n      onComplete: revealSubAndBtn,\n    });\n\n    // Stickers drift toward/away from the cursor for a subtle parallax feel.\n    var stickers = hero.querySelectorAll('.hm-hero-v2-sticker');\n    if (!stickers.length) return;\n\n    var ticking = false;\n    var px = 0;\n    var py = 0;\n\n    hero.addEventListener('mousemove', function (e) {\n      var rect = hero.getBoundingClientRect();\n      px = ((e.clientX - rect.left) / rect.width - 0.5) * 2;\n      py = ((e.clientY - rect.top) / rect.height - 0.5) * 2;\n\n      if (ticking) return;\n      ticking = true;\n\n      requestAnimationFrame(function () {\n        stickers.forEach(function (el) {\n          var depth = parseFloat(el.dataset.depth) || 1;\n          anime.animate(el, {\n            translateX: px * 22 * depth,\n            translateY: py * 22 * depth,\n            duration: 450,\n          });\n        });\n        ticking = false;\n      });\n    });\n\n    hero.addEventListener('mouseleave', function () {\n      stickers.forEach(function (el) {\n        anime.animate(el, { translateX: 0, translateY: 0, duration: 500 });\n      });\n    });\n  });\n</script>\n",
