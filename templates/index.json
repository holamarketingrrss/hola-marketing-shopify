    "custom_liquid_Kyi4gP": {
      "type": "custom-liquid",
      "name": "contacto",
      "settings": {
        "custom_liquid": "<section class=\"hm-contact\">\n  <style>\n    .hm-contact{\n      background:#fdf6ec;\n      padding:clamp(60px,8vw,120px) clamp(20px,5vw,80px);\n      overflow:hidden;\n      border-top:2px dashed #000;\n    }\n\n    .hm-contact *{\n      box-sizing:border-box;\n    }\n\n    .hm-contact-wrap{\n      max-width:1200px;\n      margin:auto;\n    }\n\n    .hm-contact-head{\n      text-align:center;\n      margin-bottom:50px;\n    }\n\n    .hm-contact-icon{\n      width:70px;\n      margin:0 auto 18px;\n      display:block;\n    }\n\n    .hm-contact-title{\n      margin:0 0 22px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(34px,4vw,74px);\n      line-height:.95;\n      letter-spacing:-.07em;\n      text-transform:uppercase;\n      color:#000;\n    }\n\n    .hm-contact-sub{\n      margin:0;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(18px,1.4vw,28px);\n      color:#000;\n    }\n\n    .hm-contact-form{\n      margin-top:50px;\n    }\n\n    .hm-contact-field{\n      margin-bottom:24px;\n    }\n\n    .hm-contact-label{\n      display:block;\n      margin-bottom:10px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:20px;\n      font-weight:700;\n      color:#000;\n    }\n\n    .hm-contact-input,\n    .hm-contact-textarea{\n      width:100%;\n      border:1px solid #bbb;\n      border-radius:18px;\n      background:#fff;\n      color:#000;\n\n      font-family:\"DM Sans\", sans-serif;\n      font-size:18px;\n\n      padding:18px 22px;\n      outline:none;\n\n      transition:.18s ease;\n    }\n\n    .hm-contact-textarea{\n      min-height:180px;\n      resize:none;\n    }\n\n    .hm-contact-input:focus,\n    .hm-contact-textarea:focus{\n      border-color:#2462c7;\n      box-shadow:0 0 0 3px rgba(36,98,199,.12);\n    }\n\n    .hm-contact-submit{\n      margin:34px auto 0;\n      width:min(520px,100%);\n      min-height:58px;\n\n      display:flex;\n      align-items:center;\n      justify-content:center;\n\n      border:2px solid #000;\n      border-radius:16px;\n\n      background:#2462c7;\n      color:#fff;\n\n      cursor:pointer;\n\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:20px;\n      font-weight:900;\n      text-transform:uppercase;\n\n      box-shadow:0 4px 0 #000;\n      transition:.18s ease;\n    }\n\n    .hm-contact-submit:hover{\n      background:#ff5000;\n      transform:translateY(-3px);\n      box-shadow:0 7px 0 #000;\n    }\n\n    .hm-contact-success,\n    .hm-contact-errors{\n      margin-bottom:30px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:18px;\n      font-weight:700;\n    }\n\n    .hm-contact-success{\n      color:#2d9f54;\n    }\n\n    .hm-contact-errors{\n      color:#ff5000;\n    }\n\n    @media(max-width:749px){\n\n      .hm-contact-title{\n        font-size:clamp(32px,11vw,52px);\n      }\n\n      .hm-contact-submit{\n        font-size:16px;\n      }\n\n    }\n\n  </style>\n\n\n  <div class=\"hm-contact-wrap\">\n\n    <div class=\"hm-contact-head\">\n\n      <img\n        class=\"hm-contact-icon\"\n        src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/cafe.avif?v=1778181690\"\n        alt=\"Café\"\n        loading=\"lazy\"\n      >\n\n      <h2 class=\"hm-contact-title\">\n        ¿Tomamos un café<br>\n        y hablamos de tu marca?\n      </h2>\n\n      <p class=\"hm-contact-sub\">\n        Queremos conocerte, escucharte y ayudarte a llevar tu proyecto más lejos.\n      </p>\n\n    </div>\n\n\n    {% form 'contact', class:'hm-contact-form' %}\n\n      {% if form.posted_successfully? %}\n        <div class=\"hm-contact-success\">\n          ¡Mensaje enviado! ☕ Ya estamos preparando el café.\n        </div>\n      {% endif %}\n\n      {{ form.errors | default_errors }}\n\n\n      <div class=\"hm-contact-field\">\n        <label class=\"hm-contact-label\">Nombre</label>\n\n        <input\n          class=\"hm-contact-input\"\n          type=\"text\"\n          name=\"contact[name]\"\n          required\n        >\n      </div>\n\n\n      <div class=\"hm-contact-field\">\n        <label class=\"hm-contact-label\">Email</label>\n\n        <input\n          class=\"hm-contact-input\"\n          type=\"email\"\n          name=\"contact[email]\"\n          required\n        >\n      </div>\n\n\n      <div class=\"hm-contact-field\">\n        <label class=\"hm-contact-label\">Mensaje</label>\n\n        <textarea\n          class=\"hm-contact-textarea\"\n          name=\"contact[body]\"\n          required\n        ></textarea>\n      </div>\n\n\n      <button\n        type=\"submit\"\n        class=\"hm-contact-submit\"\n      >\n        Enviar\n      </button>\n\n    {% endform %}\n\n  </div>\n\n</section>",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
