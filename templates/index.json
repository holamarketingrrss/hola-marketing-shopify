    "custom_liquid_HC3gEx": {
      "type": "custom-liquid",
      "name": "packs",
      "settings": {
        "custom_liquid": "<section class=\"hm-quiz hm-section\">\n  <style>\n    .hm-quiz{\n      background:var(--hm-cream);\n      overflow:hidden;\n    }\n\n    .hm-quiz *{ box-sizing:border-box; }\n\n    .hm-quiz-wrap{\n      max-width:1140px;\n      margin:auto;\n    }\n\n    .hm-quiz-body{\n      display:grid;\n      grid-template-columns:3fr 1fr;\n      gap:28px;\n      align-items:stretch;\n    }\n\n    .hm-quiz-carousel{\n      position:relative;\n      border:2px solid var(--hm-black);\n      border-radius:28px;\n      overflow:hidden;\n      min-height:280px;\n    }\n\n    .hm-quiz-carousel-img{\n      position:absolute;\n      inset:0;\n      width:100%;\n      height:100%;\n      object-fit:cover;\n      opacity:0;\n      transition:opacity .25s ease;\n    }\n\n    .hm-quiz-carousel-img.is-active{\n      opacity:1;\n    }\n\n    @media(max-width:900px){\n      .hm-quiz-body{\n        grid-template-columns:1fr;\n      }\n\n      .hm-quiz-carousel{\n        min-height:180px;\n        order:-1;\n      }\n    }\n\n    .hm-quiz-title{\n      margin:0;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(32px,4vw,68px);\n      line-height:.95;\n      text-transform:uppercase;\n      letter-spacing:-.07em;\n      color:var(--hm-black);\n      text-align:center;\n    }\n\n    .hm-quiz-sub{\n      margin:22px auto 0;\n      max-width:640px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(17px,1.3vw,22px);\n      line-height:1.4;\n      color:var(--hm-black);\n      text-align:center;\n    }\n\n    .hm-quiz-card{\n      background:var(--hm-white);\n      border:2px solid var(--hm-black);\n      border-radius:28px;\n      padding:clamp(28px,4vw,48px);\n      min-height:420px;\n      display:flex;\n      flex-direction:column;\n    }\n\n    .hm-quiz-progress-track{\n      width:100%;\n      height:8px;\n      border-radius:999px;\n      background:rgba(0,0,0,.08);\n      overflow:hidden;\n      margin-bottom:10px;\n    }\n\n    .hm-quiz-progress-fill{\n      height:100%;\n      background:var(--hm-orange);\n      border-radius:999px;\n      width:0%;\n      transition:width .3s ease;\n    }\n\n    .hm-quiz-progress-label{\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:13px;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:.04em;\n      color:var(--hm-black);\n      opacity:.6;\n      margin-bottom:28px;\n    }\n\n    .hm-quiz-question{\n      margin:0 0 26px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(21px,2.2vw,30px);\n      line-height:1.2;\n      letter-spacing:-.03em;\n      color:var(--hm-black);\n    }\n\n    .hm-quiz-options{\n      display:flex;\n      flex-direction:column;\n      gap:12px;\n    }\n\n    .hm-quiz-option{\n      text-align:left;\n      width:100%;\n      padding:16px 20px;\n      border:2px solid var(--hm-black);\n      border-radius:16px;\n      background:var(--hm-white);\n      color:var(--hm-black);\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(15px,1.1vw,17px);\n      font-weight:600;\n      cursor:pointer;\n      transition:background .15s ease, color .15s ease, transform .15s ease;\n    }\n\n    .hm-quiz-option:hover{\n      background:var(--hm-orange);\n      color:var(--hm-white);\n      transform:translateX(4px);\n    }\n\n    .hm-quiz-nav{\n      margin-top:auto;\n      padding-top:24px;\n      display:flex;\n      justify-content:space-between;\n      align-items:center;\n    }\n\n    .hm-quiz-back{\n      background:none;\n      border:none;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:14px;\n      font-weight:700;\n      text-transform:uppercase;\n      color:var(--hm-black);\n      opacity:.6;\n      cursor:pointer;\n      visibility:hidden;\n    }\n\n    .hm-quiz-back.is-visible{ visibility:visible; }\n    .hm-quiz-back:hover{ opacity:1; }\n\n    /* Result screen */\n    .hm-quiz-result{ display:none; }\n    .hm-quiz-result.is-visible{ display:block; }\n    .hm-quiz-question-screen.is-hidden{ display:none; }\n\n    .hm-quiz-result-eyebrow{\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:13px;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:.04em;\n      color:var(--hm-orange);\n    }\n\n    .hm-quiz-result-name{\n      margin:8px 0 4px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(26px,3vw,40px);\n      text-transform:uppercase;\n      letter-spacing:-.05em;\n      color:var(--hm-black);\n    }\n\n    .hm-quiz-result-price{\n      margin:0 0 18px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(20px,2vw,26px);\n      font-weight:900;\n      color:var(--hm-orange);\n    }\n\n    .hm-quiz-result-desc{\n      margin:0 0 28px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(16px,1.15vw,19px);\n      line-height:1.5;\n      color:var(--hm-black);\n    }\n\n    .hm-quiz-result-cta{\n      width:100%;\n      min-height:60px;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      gap:18px;\n      font-size:18px;\n    }\n\n    .hm-quiz-fallback{\n      margin-top:30px;\n      padding-top:26px;\n      border-top:2px dashed var(--hm-black);\n      text-align:center;\n    }\n\n    .hm-quiz-fallback-title{\n      margin:0 0 18px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:15px;\n      font-weight:700;\n      color:var(--hm-black);\n      opacity:.75;\n    }\n\n    .hm-quiz-fallback-actions{\n      display:flex;\n      gap:14px;\n      flex-wrap:wrap;\n      justify-content:center;\n    }\n\n    .hm-quiz-fallback-btn{\n      min-height:52px;\n      padding:0 22px;\n      font-size:15px;\n      background:transparent;\n      color:var(--hm-black);\n      border-color:var(--hm-black);\n    }\n\n    .hm-quiz-fallback-btn:hover{\n      background:var(--hm-black);\n      color:var(--hm-white);\n    }\n\n    .hm-quiz-restart{\n      display:block;\n      margin:22px auto 0;\n      background:none;\n      border:none;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:13px;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:.03em;\n      color:var(--hm-black);\n      opacity:.5;\n      cursor:pointer;\n    }\n\n    .hm-quiz-restart:hover{ opacity:1; }\n\n    @media(max-width:600px){\n      .hm-quiz-card{ padding:24px; min-height:auto; }\n      .hm-quiz-fallback-actions{ flex-direction:column; }\n      .hm-quiz-fallback-btn{ width:100%; }\n    }\n  </style>\n\n  <div class=\"hm-quiz-wrap\">\n    <h2 class=\"hm-quiz-title\">Elegí tu forma de hacernos parte 👇🏻</h2>\n    <p class=\"hm-quiz-sub\">\n      Respondé 7 preguntas rápidas y te decimos qué pack te conviene — o si lo tuyo es armar algo 100% a tu medida.\n    </p>\n\n    <div class=\"hm-quiz-body\">\n    <div class=\"hm-quiz-card\">\n      <div class=\"hm-quiz-question-screen\" id=\"hm-quiz-question-screen\">\n        <div class=\"hm-quiz-progress-track\">\n          <div class=\"hm-quiz-progress-fill\" id=\"hm-quiz-progress-fill\"></div>\n        </div>\n        <div class=\"hm-quiz-progress-label\" id=\"hm-quiz-progress-label\">Pregunta 1 de 7</div>\n\n        <h3 class=\"hm-quiz-question\" id=\"hm-quiz-question-text\"></h3>\n        <div class=\"hm-quiz-options\" id=\"hm-quiz-options\"></div>\n\n        <div class=\"hm-quiz-nav\">\n          <button type=\"button\" class=\"hm-quiz-back\" id=\"hm-quiz-back\">← Anterior</button>\n        </div>\n      </div>\n\n      <div class=\"hm-quiz-result\" id=\"hm-quiz-result\">\n        <span class=\"hm-quiz-result-eyebrow\">Te recomendamos</span>\n        <h3 class=\"hm-quiz-result-name\" id=\"hm-quiz-result-name\"></h3>\n        <div class=\"hm-quiz-result-price\" id=\"hm-quiz-result-price\"></div>\n        <p class=\"hm-quiz-result-desc\" id=\"hm-quiz-result-desc\"></p>\n\n        <a href=\"#\" target=\"_blank\" rel=\"noopener\" class=\"hm-btn hm-quiz-result-cta\" id=\"hm-quiz-result-cta\"></a>\n\n        <div class=\"hm-quiz-fallback\">\n          <p class=\"hm-quiz-fallback-title\">¿Este pack no te termina de cerrar del todo?</p>\n          <div class=\"hm-quiz-fallback-actions\">\n            <a href=\"https://calendar.app.google/GaRqhS7U38U57FoL6\" target=\"_blank\" rel=\"noopener\" class=\"hm-btn hm-quiz-fallback-btn\">\n              Agendar una call con Yvette\n            </a>\n            <a href=\"/pages/cotiza-tu-pack\" class=\"hm-btn hm-quiz-fallback-btn\">\n              Armar mi cotización personalizada\n            </a>\n          </div>\n        </div>\n\n        <button type=\"button\" class=\"hm-quiz-restart\" id=\"hm-quiz-restart\">Volver a empezar</button>\n      </div>\n    </div>\n\n    <div class=\"hm-quiz-carousel\" id=\"hm-quiz-carousel\" aria-hidden=\"true\">\n      <img class=\"hm-quiz-carousel-img is-active\" src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/pack1.avif?v=1778177559\" alt=\"\" loading=\"lazy\">\n      <img class=\"hm-quiz-carousel-img\" src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/pack2.avif?v=1778177559\" alt=\"\" loading=\"lazy\">\n      <img class=\"hm-quiz-carousel-img\" src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/star.jpg?v=1787237924\" alt=\"\" loading=\"lazy\">\n    </div>\n    </div>\n  </div>\n</section>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    var QUESTIONS = [\n      {\n        q: '¿Cuál es tu objetivo principal ahora mismo?',\n        options: [\n          { label: 'Lanzar mi marca desde cero', w: { esencial: 2, premium: 0, personalizado: 1 } },\n          { label: 'Reforzar mi presencia en redes', w: { esencial: 1, premium: 2, personalizado: 1 } },\n          { label: 'Necesito una estrategia integral (redes + web + todo)', w: { esencial: 0, premium: 1, personalizado: 3 } },\n          { label: 'No estoy segura, quiero que me guíen', w: { esencial: 0, premium: 0, personalizado: 3 } },\n        ],\n      },\n      {\n        q: '¿Cuál es tu presupuesto mensual aproximado?',\n        options: [\n          { label: 'Hasta US$1,200', w: { esencial: 3, premium: 0, personalizado: 0 } },\n          { label: 'US$1,200 – US$3,000', w: { esencial: 1, premium: 2, personalizado: 0 } },\n          { label: 'Más de US$3,000', w: { esencial: 0, premium: 1, personalizado: 3 } },\n          { label: 'Todavía no lo tengo definido', w: { esencial: 0, premium: 0, personalizado: 2 } },\n        ],\n      },\n      {\n        q: '¿Con qué urgencia necesitás arrancar?',\n        options: [\n          { label: 'Ya, cuanto antes', w: { esencial: 1, premium: 1, personalizado: 1 } },\n          { label: 'En las próximas 2-4 semanas', w: { esencial: 1, premium: 1, personalizado: 0 } },\n          { label: 'Estoy explorando opciones', w: { esencial: 0, premium: 0, personalizado: 1 } },\n        ],\n      },\n      {\n        q: '¿Ya tenés tu identidad de marca (logo, colores, etc.) armada?',\n        options: [\n          { label: 'Sí, ya la tengo', w: { esencial: 2, premium: 1, personalizado: 0 } },\n          { label: 'Más o menos, necesita un refresh', w: { esencial: 0, premium: 2, personalizado: 1 } },\n          { label: 'No, hay que crearla desde cero', w: { esencial: 1, premium: 0, personalizado: 2 } },\n        ],\n      },\n      {\n        q: '¿Necesitás gestión mensual de redes sociales?',\n        options: [\n          { label: 'Sí, todos los días', w: { esencial: 0, premium: 3, personalizado: 0 } },\n          { label: 'Sí, pero algo más simple', w: { esencial: 2, premium: 0, personalizado: 0 } },\n          { label: 'No, solo piezas puntuales', w: { esencial: 0, premium: 0, personalizado: 2 } },\n          { label: 'No estoy segura', w: { esencial: 0, premium: 0, personalizado: 1 } },\n        ],\n      },\n      {\n        q: '¿Necesitás sitio web o tienda online?',\n        options: [\n          { label: 'Sí, necesito uno nuevo', w: { esencial: 0, premium: 2, personalizado: 2 } },\n          { label: 'Ya tengo uno, solo actualizaciones', w: { esencial: 1, premium: 1, personalizado: 0 } },\n          { label: 'No por ahora', w: { esencial: 1, premium: 0, personalizado: 0 } },\n        ],\n      },\n      {\n        q: '¿Cómo te imaginás trabajando con nosotras?',\n        options: [\n          { label: 'Con un plan cerrado y predecible cada mes', w: { esencial: 2, premium: 2, personalizado: 0 } },\n          { label: 'Con algo armado 100% a mi medida', w: { esencial: 0, premium: 0, personalizado: 3 } },\n          { label: 'Todavía no lo sé, quiero que me asesoren', w: { esencial: 0, premium: 0, personalizado: 2 } },\n        ],\n      },\n    ];\n\n    var RESULTS = {\n      esencial: {\n        name: 'Pack Esencial',\n        price: 'US$ 1,200 / mes',\n        desc: 'Ideal para marcas que empiezan de cero. Incluye estrategia y reportes, diseño de feed, 20 historias y 8 posteos mensuales, gestión de Instagram + TikTok, brandboard básico y campaña de influencers.',\n        ctaLabel: 'Quiero el Pack Esencial',\n        ctaHref: 'https://wa.link/lh1gwp',\n      },\n      premium: {\n        name: 'Pack Premium',\n        price: 'US$ 3,000 / mes',\n        desc: 'Presencia completa en redes sociales, sitio web personalizado, producción audiovisual y estrategia integral, con un equipo trabajando todos los días para que tu marca brille.',\n        ctaLabel: 'Quiero el Pack Premium',\n        ctaHref: 'https://wa.link/lh1gwp',\n      },\n      personalizado: {\n        name: 'Pack Personalizado',\n        price: 'A tu medida',\n        desc: 'Es la opción que más eligen nuestras clientas: armamos una propuesta 100% adaptada a lo que tu marca necesita, mezclando branding, contenido, automatizaciones, campañas y web.',\n        ctaLabel: 'Armar mi pack a medida',\n        ctaHref: '/pages/cotiza-tu-pack',\n      },\n    };\n\n    var current = 0;\n    var scores = { esencial: 0, premium: 0, personalizado: 0 };\n    var history = [];\n\n    var questionScreen = document.getElementById('hm-quiz-question-screen');\n    var resultScreen = document.getElementById('hm-quiz-result');\n    var progressFill = document.getElementById('hm-quiz-progress-fill');\n    var progressLabel = document.getElementById('hm-quiz-progress-label');\n    var questionText = document.getElementById('hm-quiz-question-text');\n    var optionsWrap = document.getElementById('hm-quiz-options');\n    var backBtn = document.getElementById('hm-quiz-back');\n    var restartBtn = document.getElementById('hm-quiz-restart');\n    var resultName = document.getElementById('hm-quiz-result-name');\n    var resultPrice = document.getElementById('hm-quiz-result-price');\n    var resultDesc = document.getElementById('hm-quiz-result-desc');\n    var resultCta = document.getElementById('hm-quiz-result-cta');\n\n    function renderQuestion() {\n      var total = QUESTIONS.length;\n      var item = QUESTIONS[current];\n\n      progressFill.style.width = ((current) / total * 100) + '%';\n      progressLabel.textContent = 'Pregunta ' + (current + 1) + ' de ' + total;\n      questionText.textContent = item.q;\n      backBtn.classList.toggle('is-visible', current > 0);\n\n      optionsWrap.innerHTML = '';\n      item.options.forEach(function (opt) {\n        var btn = document.createElement('button');\n        btn.type = 'button';\n        btn.className = 'hm-quiz-option';\n        btn.textContent = opt.label;\n        btn.addEventListener('click', function () { selectOption(opt); });\n        optionsWrap.appendChild(btn);\n      });\n\n      if (window.anime && anime.animate) {\n        anime.animate(optionsWrap.children, {\n          opacity: [0, 1],\n          translateX: [-14, 0],\n          duration: 350,\n          delay: anime.stagger(50),\n        });\n      }\n    }\n\n    function selectOption(opt) {\n      history.push(JSON.parse(JSON.stringify(scores)));\n      scores.esencial += opt.w.esencial || 0;\n      scores.premium += opt.w.premium || 0;\n      scores.personalizado += opt.w.personalizado || 0;\n\n      if (current < QUESTIONS.length - 1) {\n        current += 1;\n        renderQuestion();\n      } else {\n        showResult();\n      }\n    }\n\n    function goBack() {\n      if (current === 0 || !history.length) return;\n      scores = history.pop();\n      current -= 1;\n      renderQuestion();\n    }\n\n    function pickWinner() {\n      // Ties favor personalizado — it's the pack our clients choose most.\n      if (scores.personalizado >= scores.esencial && scores.personalizado >= scores.premium) return 'personalizado';\n      if (scores.premium >= scores.esencial) return 'premium';\n      return 'esencial';\n    }\n\n    function showResult() {\n      var key = pickWinner();\n      var data = RESULTS[key];\n\n      resultName.textContent = data.name;\n      resultPrice.textContent = data.price;\n      resultDesc.textContent = data.desc;\n      resultCta.textContent = data.ctaLabel;\n      resultCta.href = data.ctaHref;\n\n      questionScreen.classList.add('is-hidden');\n      resultScreen.classList.add('is-visible');\n\n      if (window.anime && anime.animate) {\n        anime.animate(resultScreen, {\n          opacity: [0, 1],\n          translateY: [16, 0],\n          duration: 450,\n        });\n      }\n    }\n\n    function restart() {\n      current = 0;\n      scores = { esencial: 0, premium: 0, personalizado: 0 };\n      history = [];\n      resultScreen.classList.remove('is-visible');\n      questionScreen.classList.remove('is-hidden');\n      renderQuestion();\n    }\n\n    backBtn.addEventListener('click', goBack);\n    restartBtn.addEventListener('click', restart);\n\n    renderQuestion();\n\n    // Decorative carousel — abrupt cross-fade between images, no motion.\n    var carouselImgs = document.querySelectorAll('#hm-quiz-carousel .hm-quiz-carousel-img');\n    if (carouselImgs.length > 1) {\n      var carouselIndex = 0;\n      setInterval(function () {\n        carouselImgs[carouselIndex].classList.remove('is-active');\n        carouselIndex = (carouselIndex + 1) % carouselImgs.length;\n        carouselImgs[carouselIndex].classList.add('is-active');\n      }, 2600);\n    }\n  });\n</script>\n",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "custom_liquid_DtEJE3": {
      "type": "custom-liquid",
      "name": "Sobre nosotros",
      "settings": {
        "custom_liquid": "<section class=\"hm-about-preview hm-section\">\n  <style>\n    .hm-about-preview{\n      background:var(--hm-cream);\n      overflow:hidden;\n    }\n\n    .hm-about-preview *{\n      box-sizing:border-box;\n    }\n\n    .hm-about-wrap{\n      max-width:1400px;\n      margin:0 auto;\n      display:grid;\n      grid-template-columns:.95fr 1.05fr;\n      gap:clamp(40px,7vw,100px);\n      align-items:center;\n    }\n\n    .hm-about-media{\n      display:flex;\n      justify-content:center;\n      align-items:center;\n    }\n\n    .hm-about-media img{\n      width:100%;\n      height:100%;\n      display:block;\n    }\n\n    .hm-about-title{\n      margin:0 0 32px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(30px,3.4vw,62px);\n      line-height:1.08;\n      letter-spacing:-.06em;\n      text-transform:uppercase;\n      color:var(--hm-black);\n    }\n\n    .hm-about-text{\n      max-width:760px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(17px,1.25vw,24px);\n      line-height:1.45;\n      color:var(--hm-black);\n    }\n\n    .hm-about-text p{\n      margin:0 0 24px;\n    }\n\n    .hm-about-btn{\n      margin-top:18px;\n      width:min(430px,100%);\n      min-height:58px;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      gap:22px;\n      font-size:18px;\n      box-shadow:0 4px 0 var(--hm-black);\n    }\n\n    .hm-about-btn:hover{\n      transform:translateY(-3px);\n      box-shadow:0 7px 0 var(--hm-black);\n    }\n\n    .hm-about-btn span{\n      font-size:1.5em;\n      line-height:1;\n    }\n\n    @media(max-width:900px){\n      .hm-about-wrap{\n        grid-template-columns:1fr;\n        text-align:left;\n      }\n\n      .hm-about-media{\n        order:1;\n      }\n\n      .hm-about-content{\n        order:2;\n      }\n\n      .hm-about-title{\n        font-size:clamp(30px,9vw,52px);\n      }\n\n      .hm-about-btn{\n        width:100%;\n      }\n    }\n  </style>\n\n  <div class=\"hm-about-wrap\">\n\n    <div class=\"hm-about-media\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/690df9ac604ed84776ba209d_arriba.gif?v=1778178315\"\n        alt=\"Hola Marketing\"\n        loading=\"lazy\"\n      >\n    </div>\n\n    <div class=\"hm-about-content\">\n      <h2 class=\"hm-about-title\">\n        Estamos aquí para darle vida a tus visiones y pasar un buen rato creando para tí🚀\n      </h2>\n\n      <div class=\"hm-about-text\">\n        <p>\n          Fundamos esta agencia con una sola meta: que estés aquí, en este preciso momento.\n          ¡Y lo logramos! Ahora sí, es momento de que nos pongas caras. Esperamos haber elegido\n          buenas fotos (aunque no prometemos estar siempre peinadas).\n        </p>\n\n        <p>\n          Somos <strong>Hola Marketing</strong>, tus nuevas aliadas para hacer que tu marca se vea\n          única, real y woowwww!\n        </p>\n      </div>\n\n      <a href=\"/pages/sobre-nosotras\" class=\"hm-btn hm-about-btn\">\n        Sobre nosotras <span>→</span>\n      </a>\n    </div>\n\n  </div>\n</section>",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "custom_liquid_z666WW": {
      "type": "custom-liquid",
      "name": "Blog-Proyectos",
      "settings": {
        "custom_liquid": "<section class=\"hm-projects hm-section\">\n  <style>\n    .hm-projects{\n      background:var(--hm-cream);\n    }\n\n    .hm-projects *{\n      box-sizing:border-box;\n    }\n\n    .hm-projects-wrap{\n      max-width:1500px;\n      margin:auto;\n    }\n\n    .hm-projects-head{\n      display:flex;\n      justify-content:space-between;\n      align-items:center;\n      gap:20px;\n      margin-bottom:50px;\n      flex-wrap:wrap;\n    }\n\n    .hm-projects-title{\n      margin:0;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(28px,3vw,58px);\n      line-height:1;\n      letter-spacing:-.06em;\n      text-transform:uppercase;\n      color:var(--hm-black);\n    }\n\n    .hm-projects-btn{\n      min-height:56px;\n      padding:0 32px;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      font-size:16px;\n      box-shadow:0 4px 0 var(--hm-black);\n    }\n\n    .hm-projects-btn:hover{\n      transform:translateY(-3px);\n    }\n\n    .hm-projects-grid{\n      display:grid;\n      grid-template-columns:repeat(3,1fr);\n      gap:28px;\n    }\n\n    .hm-project{\n      text-decoration:none;\n      color:var(--hm-black);\n    }\n\n    .hm-project-media{\n      aspect-ratio:4/4;\n      border:2px solid var(--hm-black);\n      border-radius:24px;\n      overflow:hidden;\n      background:#eee;\n    }\n\n    .hm-project-media img{\n      width:100%;\n      height:100%;\n      object-fit:cover;\n      display:block;\n    }\n\n    .hm-project-name{\n      margin:22px 0 14px;\n      text-align:center;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(20px,1.5vw,34px);\n      text-transform:uppercase;\n      letter-spacing:-.05em;\n    }\n\n    .hm-project-tag{\n      width:fit-content;\n      margin:auto;\n      padding:10px 22px;\n      border:2px solid var(--hm-black);\n      border-radius:999px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:16px;\n      font-weight:700;\n    }\n\n    @media(max-width:900px){\n\n      .hm-projects-grid{\n        grid-template-columns:1fr;\n      }\n\n      .hm-projects-btn{\n        width:100%;\n      }\n\n    }\n\n  </style>\n\n  <div class=\"hm-projects-wrap\">\n\n    <div class=\"hm-projects-head\">\n\n      <h2 class=\"hm-projects-title\">\n        Explora nuestros proyectos favoritos 💼\n      </h2>\n\n      <a href=\"/blogs/proyectos\" class=\"hm-btn hm-projects-btn\">\n        Ver proyectos y reviews\n      </a>\n\n    </div>\n\n\n    <div class=\"hm-projects-grid\">\n\n      {% assign featured_projects = blogs.proyectos.articles | slice: 0, 3 %}\n\n      {% if featured_projects.size > 0 %}\n\n        {% for article in featured_projects %}\n\n          <a href=\"{{ article.url }}\" class=\"hm-project\">\n\n            <div class=\"hm-project-media\">\n\n              {% if article.image %}\n                <img\n                  src=\"{{ article.image | image_url: width: 900 }}\"\n                  alt=\"{{ article.title }}\"\n                  loading=\"lazy\"\n                >\n              {% endif %}\n\n            </div>\n\n            <div class=\"hm-project-name\">\n              {{ article.title }}\n            </div>\n\n            <div class=\"hm-project-tag\">\n              {{ article.tags.first }}\n            </div>\n\n          </a>\n\n        {% endfor %}\n\n      {% else %}\n\n        <!-- skeleton -->\n\n        {% for i in (1..3) %}\n\n          <div class=\"hm-project\">\n\n            <div class=\"hm-project-media\"></div>\n\n            <div class=\"hm-project-name\">\n              Próximamente\n            </div>\n\n            <div class=\"hm-project-tag\">\n              Proyecto\n            </div>\n\n          </div>\n\n        {% endfor %}\n\n      {% endif %}\n\n    </div>\n\n  </div>\n\n</section>",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
