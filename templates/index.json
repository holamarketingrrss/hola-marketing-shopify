    "hm_bolsa_trabajo": {
      "type": "custom-liquid",
      "name": "bolsa-de-trabajo",
      "settings": {
        "custom_liquid": "<section class=\"hm-video-band hm-video-band--jobs\" id=\"bolsa-de-trabajo\">\n  <style>\n    /* Video bands: the video always spans the full width at its own 16:9 height, so it is never\n       cropped and there are no side margins whose colour would have to match the video (browsers\n       colour-manage CSS colours and video frames differently, so that can't be matched reliably).\n       On very wide screens the band is simply taller than the viewport. */\n    .hm-video-band{\n      position:relative;\n      border-bottom:var(--hm-section-border);\n      background:var(--hm-black);\n      overflow:hidden;\n    }\n\n    .hm-video-band *{ box-sizing:border-box; }\n\n    .hm-video-band a{\n      display:block;\n      position:relative;\n      width:100%;\n      aspect-ratio:16/9;\n    }\n\n    .hm-video-band video{\n      position:absolute;\n      inset:0;\n      width:100%;\n      height:100%;\n      object-fit:cover;\n      display:block;\n    }\n\n    /* Call-to-action over the video; the whole band is the link. */\n    .hm-video-band-btn{\n      position:absolute;\n      left:50%;\n      bottom:clamp(18px,4vw,64px);\n      transform:translateX(-50%);\n      min-height:clamp(44px,3.8vw,60px);\n      padding:0 clamp(22px,2.6vw,42px);\n      display:inline-flex;\n      align-items:center;\n      justify-content:center;\n      gap:16px;\n      font-size:clamp(14px,1.3vw,19px);\n      white-space:nowrap;\n      box-shadow:0 4px 0 var(--hm-black);\n      transition:transform .18s ease, box-shadow .18s ease;\n    }\n\n    .hm-video-band a:hover .hm-video-band-btn{\n      transform:translateX(-50%) translateY(-3px);\n      box-shadow:0 7px 0 var(--hm-black);\n    }\n  </style>\n\n  <a href=\"/blogs/bolsa-de-trabajo\" aria-label=\"Ver las vacantes disponibles\">\n    <video\n      data-hm-video\n      data-src=\"https://cdn.shopify.com/videos/c/vp/ec8b693349054d83ba22b576767012da/ec8b693349054d83ba22b576767012da.HD-1080p-4.8Mbps-96610343.mp4\"\n      data-src-hq=\"https://cdn.shopify.com/videos/c/o/v/ec8b693349054d83ba22b576767012da.mp4\"\n      poster=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/preview_images/ec8b693349054d83ba22b576767012da.thumbnail.0000000000.jpg?v=1791314587\"\n      muted\n      loop\n      playsinline\n      preload=\"none\"\n      aria-hidden=\"true\"\n    ></video>\n    <span class=\"hm-btn hm-video-band-btn\">Ver vacantes <span>→</span></span>\n  </a>\n</section>\n",
