    "custom_liquid_DtEJE3": {
      "type": "custom-liquid",
      "name": "Sobre nosotros",
      "settings": {
        "custom_liquid": "<section class=\"hm-about-preview\">\n  <style>\n    .hm-about-preview{\n      --hm-black:#000000;\n      --hm-orange:#ff5000;\n      --hm-green:#2d9f54;\n      --hm-cream:#fdf6ec;\n\n      background:var(--hm-cream);\n      padding:clamp(60px,8vw,120px) clamp(20px,5vw,90px);\n      overflow:hidden;\n    }\n\n    .hm-about-preview *{\n      box-sizing:border-box;\n    }\n\n    .hm-about-wrap{\n      max-width:1400px;\n      margin:0 auto;\n      display:grid;\n      grid-template-columns:.95fr 1.05fr;\n      gap:clamp(40px,7vw,100px);\n      align-items:center;\n    }\n\n    .hm-about-media{\n      display:flex;\n      justify-content:center;\n      align-items:center;\n    }\n\n    .hm-about-media img{\n      width:100%;\n      height:100%;\n      display:block;\n    }\n\n    .hm-about-title{\n      margin:0 0 32px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(30px,3.4vw,62px);\n      line-height:1.08;\n      letter-spacing:-.06em;\n      text-transform:uppercase;\n      color:var(--hm-black);\n    }\n\n    .hm-about-text{\n      max-width:760px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(17px,1.25vw,24px);\n      line-height:1.45;\n      color:var(--hm-black);\n    }\n\n    .hm-about-text p{\n      margin:0 0 24px;\n    }\n\n    .hm-about-btn{\n      margin-top:18px;\n      width:min(430px,100%);\n      min-height:58px;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      gap:22px;\n      border:2px solid var(--hm-black);\n      border-radius:16px;\n      background:var(--hm-orange);\n      color:#fff;\n      text-decoration:none;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:18px;\n      font-weight:900;\n      text-transform:uppercase;\n      box-shadow:0 4px 0 var(--hm-black);\n      transition:.18s ease;\n    }\n\n    .hm-about-btn:hover{\n      background:var(--hm-green);\n      color:#fff;\n      transform:translateY(-3px);\n      box-shadow:0 7px 0 var(--hm-black);\n    }\n\n    .hm-about-btn span{\n      font-size:1.5em;\n      line-height:1;\n    }\n\n    @media(max-width:900px){\n      .hm-about-wrap{\n        grid-template-columns:1fr;\n        text-align:left;\n      }\n\n      .hm-about-media{\n        order:1;\n      }\n\n      .hm-about-content{\n        order:2;\n      }\n\n      .hm-about-title{\n        font-size:clamp(30px,9vw,52px);\n      }\n\n      .hm-about-btn{\n        width:100%;\n      }\n    }\n  </style>\n\n  <div class=\"hm-about-wrap\">\n\n    <div class=\"hm-about-media\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/690df9ac604ed84776ba209d_arriba.gif?v=1778178315\"\n        alt=\"Hola Marketing\"\n        loading=\"lazy\"\n      >\n    </div>\n\n    <div class=\"hm-about-content\">\n      <h2 class=\"hm-about-title\">\n        Estamos aquí para darle vida a tus visiones y pasar un buen rato creando para tí🚀\n      </h2>\n\n      <div class=\"hm-about-text\">\n        <p>\n          Fundamos esta agencia con una sola meta: que estés aquí, en este preciso momento.\n          ¡Y lo logramos! Ahora sí, es momento de que nos pongas caras. Esperamos haber elegido\n          buenas fotos (aunque no prometemos estar siempre peinadas).\n        </p>\n\n        <p>\n          Somos <strong>Hola Marketing</strong>, tus nuevas aliadas para hacer que tu marca se vea\n          única, real y woowwww!\n        </p>\n      </div>\n\n      <a href=\"/pages/sobre-nosotras\" class=\"hm-about-btn\">\n        Sobre nosotras <span>→</span>\n      </a>\n    </div>\n\n  </div>\n</section>",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "custom_liquid_z666WW": {
      "type": "custom-liquid",
      "name": "Blog-Proyectos",
      "settings": {
        "custom_liquid": "<section class=\"hm-projects\">\n  <style>\n    .hm-projects{\n      background:#fdf6ec;\n      padding:clamp(60px,8vw,110px) clamp(20px,5vw,80px);\n    }\n\n    .hm-projects *{\n      box-sizing:border-box;\n    }\n\n    .hm-projects-wrap{\n      max-width:1500px;\n      margin:auto;\n    }\n\n    .hm-projects-head{\n      display:flex;\n      justify-content:space-between;\n      align-items:center;\n      gap:20px;\n      margin-bottom:50px;\n      flex-wrap:wrap;\n    }\n\n    .hm-projects-title{\n      margin:0;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(28px,3vw,58px);\n      line-height:1;\n      letter-spacing:-.06em;\n      text-transform:uppercase;\n      color:#000;\n    }\n\n    .hm-projects-btn{\n      min-height:56px;\n      padding:0 32px;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      border:2px solid #000;\n      border-radius:18px;\n      background:#ff5000;\n      color:#fff;\n      text-decoration:none;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:16px;\n      font-weight:900;\n      text-transform:uppercase;\n      box-shadow:0 4px 0 #000;\n      transition:.18s ease;\n    }\n\n    .hm-projects-btn:hover{\n      background:#2d9f54;\n      color:#fff;\n      transform:translateY(-3px);\n    }\n\n    .hm-projects-grid{\n      display:grid;\n      grid-template-columns:repeat(3,1fr);\n      gap:28px;\n    }\n\n    .hm-project{\n      text-decoration:none;\n      color:#000;\n    }\n\n    .hm-project-media{\n      aspect-ratio:4/4;\n      border:2px solid #000;\n      border-radius:24px;\n      overflow:hidden;\n      background:#eee;\n    }\n\n    .hm-project-media img{\n      width:100%;\n      height:100%;\n      object-fit:cover;\n      display:block;\n    }\n\n    .hm-project-name{\n      margin:22px 0 14px;\n      text-align:center;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(20px,1.5vw,34px);\n      text-transform:uppercase;\n      letter-spacing:-.05em;\n    }\n\n    .hm-project-tag{\n      width:fit-content;\n      margin:auto;\n      padding:10px 22px;\n      border:2px solid #000;\n      border-radius:999px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:16px;\n      font-weight:700;\n    }\n\n    @media(max-width:900px){\n\n      .hm-projects-grid{\n        grid-template-columns:1fr;\n      }\n\n      .hm-projects-btn{\n        width:100%;\n      }\n\n    }\n\n  </style>\n\n  <div class=\"hm-projects-wrap\">\n\n    <div class=\"hm-projects-head\">\n\n      <h2 class=\"hm-projects-title\">\n        Explora nuestros proyectos favoritos 💼\n      </h2>\n\n      <a href=\"/blogs/proyectos\" class=\"hm-projects-btn\">\n        Ver proyectos y reviews\n      </a>\n\n    </div>\n\n\n    <div class=\"hm-projects-grid\">\n\n      {% assign featured_projects = blogs.proyectos.articles | slice: 0, 3 %}\n\n      {% if featured_projects.size > 0 %}\n\n        {% for article in featured_projects %}\n\n          <a href=\"{{ article.url }}\" class=\"hm-project\">\n\n            <div class=\"hm-project-media\">\n\n              {% if article.image %}\n                <img\n                  src=\"{{ article.image | image_url: width: 900 }}\"\n                  alt=\"{{ article.title }}\"\n                  loading=\"lazy\"\n                >\n              {% endif %}\n\n            </div>\n\n            <div class=\"hm-project-name\">\n              {{ article.title }}\n            </div>\n\n            <div class=\"hm-project-tag\">\n              {{ article.tags.first }}\n            </div>\n\n          </a>\n\n        {% endfor %}\n\n      {% else %}\n\n        <!-- skeleton -->\n\n        {% for i in (1..3) %}\n\n          <div class=\"hm-project\">\n\n            <div class=\"hm-project-media\"></div>\n\n            <div class=\"hm-project-name\">\n              Próximamente\n            </div>\n\n            <div class=\"hm-project-tag\">\n              Proyecto\n            </div>\n\n          </div>\n\n        {% endfor %}\n\n      {% endif %}\n\n    </div>\n\n  </div>\n\n</section>",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "custom_liquid_fkg3Xk": {
