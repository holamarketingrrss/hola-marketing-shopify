    "hm_mentoria_2": {
      "type": "custom-liquid",
      "name": "asesoria-1-1",
      "settings": {
        "custom_liquid": "<section class=\"hm-asesoria\" id=\"asesoria\">\n  <style>\n    /* Two halves: text on cream (left), video at its own 16:9 height (right). The row height is\n       set by the video; the text block is sized in vw so it stays inside that height. */\n    .hm-asesoria{\n      display:grid;\n      grid-template-columns:1fr 1fr;\n      background:var(--hm-cream);\n      border-bottom:var(--hm-section-border);\n      overflow:hidden;\n    }\n\n    .hm-asesoria *{ box-sizing:border-box; }\n\n    .hm-asesoria-copy{\n      display:flex;\n      flex-direction:column;\n      justify-content:center;\n      align-items:center;\n      text-align:center;\n      padding:clamp(24px,3.6vw,72px);\n      background:var(--hm-cream);\n    }\n\n    .hm-asesoria-title{\n      margin:0 0 clamp(14px,1.6vw,26px);\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(26px,2.9vw,52px);\n      line-height:1.2;\n      letter-spacing:-.06em;\n      text-transform:uppercase;\n      color:var(--hm-black);\n    }\n\n    .hm-asesoria-text{\n      margin:0 auto clamp(10px,1.2vw,20px);\n      max-width:600px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:clamp(14px,1.15vw,21px);\n      line-height:1.5;\n      color:var(--hm-black);\n    }\n\n    .hm-asesoria-btn{\n      margin-top:clamp(10px,1.4vw,26px);\n      min-height:clamp(46px,3.6vw,60px);\n      padding:0 clamp(22px,2.4vw,40px);\n      display:inline-flex;\n      align-items:center;\n      justify-content:center;\n      gap:16px;\n      font-size:clamp(14px,1.2vw,18px);\n      box-shadow:0 4px 0 var(--hm-black);\n    }\n\n    .hm-asesoria-btn:hover{\n      transform:translateY(-3px);\n      box-shadow:0 7px 0 var(--hm-black);\n    }\n\n    /* The box keeps the video's 16:9 shape and sets the row height; the video fills it. */\n    .hm-asesoria-video{\n      position:relative;\n      aspect-ratio:16/9;\n      background:var(--hm-black);\n    }\n\n    .hm-asesoria-video video{\n      position:absolute;\n      inset:0;\n      width:100%;\n      height:100%;\n      object-fit:cover;\n      display:block;\n    }\n\n    @media(max-width:1000px){\n      .hm-asesoria{\n        grid-template-columns:1fr;\n      }\n\n      .hm-asesoria-copy{\n        padding:clamp(40px,8vw,60px) clamp(20px,5vw,40px);\n      }\n\n      .hm-asesoria-title{ font-size:var(--hm-heading-size); }\n      .hm-asesoria-text{ font-size:var(--hm-body-size); }\n      .hm-asesoria-btn{ width:100%; min-height:56px; font-size:16px; }\n    }\n  </style>\n\n  <div class=\"hm-asesoria-copy\">\n    <h2 class=\"hm-asesoria-title\">Asesoría 1:1</h2>\n\n    <p class=\"hm-asesoria-text\">\n      Reserva una llamada con Yvette para hablar sobre cualquier tema que necesites:\n      <strong>revisión de branding, servicios, estrategias, gestión de proyectos, marketing y más.</strong>\n    </p>\n\n    <p class=\"hm-asesoria-text\">\n      Con llamadas a $150 USD cada una,\n      <strong>¡Ofrecemos una de las tarifas más accesibles del mercado!</strong>\n    </p>\n\n    <a href=\"https://wa.me/17866897873\" target=\"_blank\" rel=\"noopener\" class=\"hm-btn hm-asesoria-btn\">\n      Reservar por WhatsApp <span>→</span>\n    </a>\n  </div>\n\n  <div class=\"hm-asesoria-video\">\n    <video\n      data-hm-video\n      data-src=\"https://cdn.shopify.com/videos/c/vp/2d7a147ad98b433c9de6967f5b70ba82/2d7a147ad98b433c9de6967f5b70ba82.HD-1080p-4.8Mbps-96458939.mp4\"\n      data-src-hq=\"https://cdn.shopify.com/videos/c/o/v/2d7a147ad98b433c9de6967f5b70ba82.mp4\"\n      poster=\"https://cdn.shopify.com/s/files/1/0743/9790/9131/files/preview_images/2d7a147ad98b433c9de6967f5b70ba82.thumbnail.0000000000.jpg?v=1791210148\"\n      muted\n      loop\n      playsinline\n      preload=\"none\"\n      aria-hidden=\"true\"\n    ></video>\n  </div>\n</section>\n",
