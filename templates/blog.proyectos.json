    "hm_portfolio_list_content": {
      "type": "custom-liquid",
      "name": "portfolio-list",
      "settings": {
        "custom_liquid": "<section class=\"hm-portfolio hm-section\" style=\"scroll-margin-top:90px;\">\n  <style>\n    .hm-portfolio{\n      background:var(--hm-cream);\n      padding-top:clamp(140px,16vw,190px);\n      overflow:hidden;\n    }\n\n    .hm-portfolio *{ box-sizing:border-box; }\n\n    .hm-portfolio-wrap{\n      max-width:1500px;\n      margin:0 auto;\n    }\n\n    .hm-portfolio-head{\n      text-align:center;\n      margin-bottom:clamp(40px,5vw,64px);\n    }\n\n    .hm-portfolio-eyebrow{\n      display:inline-block;\n      margin-bottom:18px;\n      padding:8px 18px;\n      border:2px solid var(--hm-black);\n      border-radius:999px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:13px;\n      font-weight:700;\n      text-transform:uppercase;\n      letter-spacing:.04em;\n    }\n\n    .hm-portfolio-title{\n      margin:0 auto 20px;\n      max-width:900px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:var(--hm-heading-size);\n      line-height:var(--hm-heading-line-height);\n      letter-spacing:-.05em;\n      text-transform:uppercase;\n      color:var(--hm-black);\n    }\n\n    .hm-portfolio-sub{\n      margin:0 auto;\n      max-width:640px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:var(--hm-body-size);\n      line-height:var(--hm-body-line-height);\n      color:var(--hm-black);\n    }\n\n    .hm-portfolio-filters{\n      display:flex;\n      flex-wrap:wrap;\n      justify-content:center;\n      gap:10px;\n      margin-bottom:clamp(40px,5vw,64px);\n    }\n\n    .hm-portfolio-filter{\n      padding:8px 18px;\n      border:2px solid var(--hm-black);\n      border-radius:999px;\n      background:var(--hm-white);\n      color:var(--hm-black);\n      font-family:\"DM Sans\", sans-serif;\n      font-size:14px;\n      font-weight:700;\n      cursor:pointer;\n      transition:background .15s ease, color .15s ease;\n    }\n\n    .hm-portfolio-filter:hover{\n      background:var(--hm-violet);\n    }\n\n    .hm-portfolio-filter.is-active{\n      background:var(--hm-black);\n      color:var(--hm-white);\n    }\n\n    .hm-portfolio-grid{\n      display:grid;\n      grid-template-columns:repeat(3, 1fr);\n      gap:32px;\n    }\n\n    .hm-portfolio-card{\n      text-decoration:none;\n      color:var(--hm-black);\n      display:flex;\n      flex-direction:column;\n    }\n\n    .hm-portfolio-card.is-hidden{\n      display:none;\n    }\n\n    .hm-portfolio-media{\n      aspect-ratio:4/5;\n      border:2px solid var(--hm-black);\n      border-radius:24px;\n      overflow:hidden;\n      background:var(--hm-white);\n    }\n\n    .hm-portfolio-media img{\n      width:100%;\n      height:100%;\n      object-fit:cover;\n      display:block;\n      transition:transform .3s ease;\n    }\n\n    .hm-portfolio-card:hover .hm-portfolio-media img{\n      transform:scale(1.05);\n    }\n\n    .hm-portfolio-name{\n      margin:22px 0 12px;\n      font-family:\"JetBrains Mono\", monospace;\n      font-size:clamp(20px,1.6vw,28px);\n      text-transform:uppercase;\n      letter-spacing:-.04em;\n    }\n\n    .hm-portfolio-tags{\n      display:flex;\n      flex-wrap:wrap;\n      gap:8px;\n    }\n\n    .hm-portfolio-tag{\n      width:fit-content;\n      padding:8px 18px;\n      border:2px solid var(--hm-black);\n      border-radius:999px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:14px;\n      font-weight:700;\n    }\n\n    .hm-portfolio-empty{\n      grid-column:1 / -1;\n      text-align:center;\n      padding:60px 20px;\n      border:2px dashed var(--hm-black);\n      border-radius:24px;\n      font-family:\"DM Sans\", sans-serif;\n      font-size:var(--hm-body-size);\n      color:var(--hm-black);\n    }\n\n    @media(max-width:1000px){\n      .hm-portfolio-grid{ grid-template-columns:1fr 1fr; }\n    }\n\n    @media(max-width:640px){\n      .hm-portfolio-grid{ grid-template-columns:1fr; }\n    }\n  </style>\n\n  <div class=\"hm-portfolio-wrap\">\n    <div class=\"hm-portfolio-head\">\n      <span class=\"hm-portfolio-eyebrow\">Portfolio</span>\n      <h1 class=\"hm-portfolio-title\">Marcas que confiaron, proyectos que nos marcaron</h1>\n      <p class=\"hm-portfolio-sub\">Una muestra de lo que pasa cuando las marcas dicen \"Hola Marketing!\" ❤️</p>\n    </div>\n\n    {%- if blog.all_tags.size > 0 -%}\n      <div class=\"hm-portfolio-filters\" id=\"hm-portfolio-filters\">\n        <button type=\"button\" class=\"hm-portfolio-filter is-active\" data-hm-filter=\"all\">Todos</button>\n        {%- for tag in blog.all_tags -%}\n          <button type=\"button\" class=\"hm-portfolio-filter\" data-hm-filter=\"{{ tag | handleize }}\">{{ tag }}</button>\n        {%- endfor -%}\n      </div>\n    {%- endif -%}\n\n    <div class=\"hm-portfolio-grid\" id=\"hm-portfolio-grid\">\n      {%- paginate blog.articles by 48 -%}\n        {%- for article in blog.articles -%}\n          <a\n            href=\"{{ article.url }}\"\n            class=\"hm-portfolio-card\"\n            data-hm-tags=\"{% for tag in article.tags %}{{ tag | handleize }}{% unless forloop.last %},{% endunless %}{% endfor %}\"\n          >\n            <div class=\"hm-portfolio-media\">\n              {%- if article.image -%}\n                <img src=\"{{ article.image | image_url: width: 900 }}\" alt=\"{{ article.title }}\" loading=\"lazy\">\n              {%- endif -%}\n            </div>\n            <h2 class=\"hm-portfolio-name\">{{ article.title }}</h2>\n            {%- if article.tags.size > 0 -%}\n              <div class=\"hm-portfolio-tags\">\n                {%- for tag in article.tags -%}\n                  <span class=\"hm-portfolio-tag\">{{ tag }}</span>\n                {%- endfor -%}\n              </div>\n            {%- endif -%}\n          </a>\n        {%- else -%}\n          <div class=\"hm-portfolio-empty\">\n            Todavía no hay proyectos publicados — muy pronto vas a ver nuestros casos acá.\n          </div>\n        {%- endfor -%}\n      {%- endpaginate -%}\n    </div>\n  </div>\n</section>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    var filters = document.querySelectorAll('#hm-portfolio-filters .hm-portfolio-filter');\n    var cards = document.querySelectorAll('#hm-portfolio-grid .hm-portfolio-card');\n    if (!filters.length || !cards.length) return;\n\n    filters.forEach(function (btn) {\n      btn.addEventListener('click', function () {\n        var target = btn.dataset.hmFilter;\n\n        filters.forEach(function (b) { b.classList.remove('is-active'); });\n        btn.classList.add('is-active');\n\n        cards.forEach(function (card) {\n          var tags = (card.dataset.hmTags || '').split(',');\n          var show = target === 'all' || tags.indexOf(target) !== -1;\n          card.classList.toggle('is-hidden', !show);\n        });\n      });\n    });\n  });\n</script>\n",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
